NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_VERSION=0.1.0
DOCS_ENABLED=true
LOG_LEVEL=debug
# worker 使用持久化计划轮询，不在内存中持有业务队列。
WORKER_POLL_INTERVAL_MS=1000
# 完成 packages/persistence/migrations/0001-0006 并通过 staging 验证后才改为 true。
PERSISTENCE_SCHEMA_READY=false
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅配置真实环境；readiness 会通过 SELECT 1 / PING 检查连接，不代表业务 provider 已接入。
DATABASE_URL=
REDIS_URL=
# 微信身份 adapter 默认关闭；只有完成凭证、域名和 provider 验收后才改为 true。
WECHAT_IDENTITY_READY=false
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_IDENTITY_BASE_URL=https://api.weixin.qq.com
# 微信支付 APIv3 默认关闭；完成商户证书、平台公钥、回调和真机验收后才改为 true。
WECHAT_PAYMENT_READY=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERTIFICATE_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
# 必须是 provider 可访问的公网 HTTPS 地址；本地 HTTP 地址会保持配置 incomplete。
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
# 众阳患者目录默认关闭；仅在服务端合同、HTTPS、凭证和 provider 验收完成后打开。
ZHONGYANG_PATIENT_DIRECTORY_READY=false
# 预约 AMC 目录独立验收；不会因患者目录 gate 打开而自动启用。
ZHONGYANG_APPOINTMENT_DIRECTORY_READY=false
# 预约历史使用 appointment-server 独立接口；合同和真实只读验收完成后才打开。
ZHONGYANG_APPOINTMENT_RECORDS_READY=false
ZHONGYANG_REPORT_DIRECTORY_READY=false
ZHONGYANG_PATIENT_DIRECTORY_BASE_URL=
# provider 若需要固定服务端 Bearer token 才填写；禁止下发小程序。
ZHONGYANG_PATIENT_DIRECTORY_AUTHORIZATION_TOKEN=
# Base64 编码的 32 字节 AES-GCM 密钥；没有它时预支付尝试 repository 保持 fail-closed。
PAYMENT_DATA_ENCRYPTION_KEY=
