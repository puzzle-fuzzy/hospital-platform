NODE_ENV=development
# 留空时：development 监听 127.0.0.1，production 监听 0.0.0.0；生产可由部署显式覆盖。
HOST=
PORT=3000
API_VERSION=0.1.0
DOCS_ENABLED=true
LOG_LEVEL=debug
# worker 使用持久化计划轮询，不在内存中持有业务队列。
WORKER_POLL_INTERVAL_MS=1000
# 完成 packages/persistence/src/migrate.ts 登记的全部迁移，并通过 staging 验证后才改为 true。
# 当前 migration head 为 0022_medical_insurance_query_task_version；该变量不是自动迁移开关。
PERSISTENCE_SCHEMA_READY=false
# db:migrate 默认只允许本机；远程/生产迁移必须在受控 shell 中显式确认。
PERSISTENCE_MIGRATION_ALLOW_REMOTE=false
PERSISTENCE_MIGRATION_ALLOW_PRODUCTION=false
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅配置真实环境；readiness 会通过 SELECT 1 / PING 检查连接，不代表业务 provider 已接入。
DATABASE_URL=
REDIS_URL=
# 仅供受控维护命令统计会话 TTL；必须使用独立只读 ACL，不能注入 API 常驻进程。
# 未配置时维护命令回退 REDIS_URL，但生产应用账号通常禁止 SCAN，审计会安全失败。
REDIS_SESSION_AUDIT_URL=
# 微信身份 adapter 默认关闭；只有完成凭证、域名和 provider 验收后才改为 true。
WECHAT_IDENTITY_READY=false
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_IDENTITY_BASE_URL=https://api.weixin.qq.com
# 微信支付 APIv3 默认关闭；完成商户证书、平台公钥、回调和真机验收后才改为 true。
WECHAT_PAYMENT_READY=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERTIFICATE_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
# 必须是 provider 可访问的公网 HTTPS 地址；本地 HTTP 地址会保持配置 incomplete。
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com
# 医保移动支付 FSI 保持关闭，直到 relay、密钥 golden vector、严格验签和真实
# 6201/6202/6301/6203/6401 验收完成。MBS_FORWARD_AUTHORIZATION_TOKEN
# 是新项目新增的部署密钥，不复用旧代码中的硬编码 Bearer。
MEDICAL_INSURANCE_READY=false
MBS_FORWARD_RELAY_URL=
MBS_FORWARD_BASE_URL_6201=
MBS_FORWARD_AUTHORIZATION_TOKEN=
MBS_APP_ID=
MBS_APP_SECRET=
MBS_SM2_PRIVATE_KEY_B64=
MBS_SM2_OWN_PUBLIC_B64=
MBS_SM2_PLATFORM_PUBLIC_B64=
MBS_SM2_USER_ID=1234567812345678
MBS_ENCRYPT_ENABLE=true
MBS_SM2_VERIFY_STRICT=true
# 众阳患者目录默认关闭；仅在服务端合同、HTTPS、凭证和 provider 验收完成后打开。
ZHONGYANG_PATIENT_DIRECTORY_READY=false
# 预约 AMC 目录独立验收；不会因患者目录 gate 打开而自动启用。
ZHONGYANG_APPOINTMENT_DIRECTORY_READY=false
# 预约历史使用 appointment-server 独立接口；合同和真实只读验收完成后才打开。
ZHONGYANG_APPOINTMENT_RECORDS_READY=false
# 门诊病历只读接口（out-visit-records）独立开关；未完成真实接口验收前保持 false
ZHONGYANG_MEDICAL_RECORDS_READY=false
# 门诊缴费当前只开放待缴/已缴费用查询；支付、医保和结算回写使用独立契约，不能因该开关打开而启用。
ZHONGYANG_OUTPATIENT_PAYMENT_READY=false
# 众阳门诊费用接口的服务端渠道标识；必须由院方/provider 合同确认，不能留空后依赖默认值。
OUTPATIENT_PAYMENT_AUTH_SYS_CODE=
ZHONGYANG_REPORT_DIRECTORY_READY=false
# LIS 详情单独验收；需要 0009 report references schema 和 provider 资源授权。
ZHONGYANG_REPORT_DETAIL_READY=false
# 众阳共享上游地址；上述能力 gate 独立控制，不为每个目录复制一份连接配置。
ZHONGYANG_BASE_URL=
# provider 若需要固定服务端 Bearer token 才填写；禁止下发小程序。
ZHONGYANG_AUTHORIZATION_TOKEN=
# Base64 编码的 32 字节 AES-GCM 密钥；没有它时预支付尝试 repository 保持 fail-closed。
PAYMENT_DATA_ENCRYPTION_KEY=
