NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_VERSION=0.1.0
DOCS_ENABLED=true
LOG_LEVEL=debug
# 完成 packages/persistence/migrations/0001_core.sql 并通过 staging 验证后才改为 true。
PERSISTENCE_SCHEMA_READY=false
API_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 仅配置真实环境；readiness 会通过 SELECT 1 / PING 检查连接，不代表业务 provider 已接入。
DATABASE_URL=
REDIS_URL=
# 微信身份 adapter 默认关闭；只有完成凭证、域名和 provider 验收后才改为 true。
WECHAT_IDENTITY_READY=false
WECHAT_APPID=
WECHAT_APP_SECRET=
WECHAT_IDENTITY_BASE_URL=https://api.weixin.qq.com
