{
	"name": "hospital-platform",
	"private": true,
	"version": "0.1.0",
	"description": "Hospital mini-program platform rebuild",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=24"
	},
	"scripts": {
		"architecture:audit": "bun tools/architecture-audit.mjs",
		"build": "turbo run build",
		"check": "pnpm architecture:audit && pnpm migration:audit && pnpm migration:boundary:audit && pnpm migration:contract:audit && pnpm migration:breadth:audit && pnpm miniprogram:navigation:audit && pnpm clinical:contract:audit && pnpm readonly:audit && pnpm provider:audit && pnpm docs:audit && pnpm logging:audit && pnpm error:contract:audit && pnpm release:baseline:audit && pnpm format:check && pnpm lint && pnpm test:tools && pnpm typecheck && pnpm test && pnpm build",
		"db:integration": "pnpm --filter @hospital/persistence integration",
		"db:migrate": "pnpm --filter @hospital/persistence migrate",
		"db:schema": "pnpm --filter @hospital/persistence schema",
		"dev": "turbo run dev --parallel",
		"device:evidence:audit": "bun tools/device-evidence-audit.mjs",
		"docs:audit": "bun tools/docs-link-audit.mjs",
		"error:contract:audit": "bun tools/error-contract-audit.mjs",
		"health:source:audit": "bun tools/health-knowledge-source-audit.mjs",
		"health:quality:findings": "bun tools/health-knowledge-quality-findings.mjs",
		"health:remediation:ledger": "bun tools/health-knowledge-remediation-ledger.mjs",
		"health:review:queue": "bun tools/health-knowledge-review-queue.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"infra:down": "docker compose -f infra/docker-compose.yml stop",
		"infra:up": "docker compose -f infra/docker-compose.yml up -d",
		"lint": "biome lint .",
		"logging:audit": "bun tools/logging-event-audit.mjs",
		"miniprogram:navigation:audit": "bun tools/miniprogram-navigation-audit.mjs",
		"migration:audit": "bun tools/migration-inventory-audit.mjs",
		"migration:boundary:audit": "bun tools/migration-boundary-audit.mjs",
		"migration:contract:audit": "bun tools/migration-contract-intake-catalog.mjs",
		"migration:breadth:audit": "bun tools/migration-breadth-audit.mjs",
		"clinical:contract:audit": "bun tools/clinical-contract-audit.mjs",
		"clinical:packet:audit": "bun tools/clinical-contract-packet-audit.mjs",
		"migration:readiness": "bun tools/migration-readiness-report.mjs",
		"provider:audit": "bun tools/provider-intake-audit.mjs",
		"readonly:audit": "bun tools/read-only-domain-audit.mjs",
		"provider:smoke:secure": "bun tools/provider-smoke-secure.ts",
		"release:baseline:audit": "bun tools/release-baseline-audit.mjs",
		"runtime:preflight": "pnpm --filter @hospital/worker preflight",
		"runtime:verify": "pnpm --filter @hospital/miniprogram runtime:verify",
		"runtime:smoke": "pnpm --filter @hospital/worker runtime-smoke",
		"provider:smoke": "pnpm --filter @hospital/worker provider-smoke",
		"zhongyang:docs": "node --no-warnings --experimental-strip-types tools/zhongyang-docs/cli.ts",
		"test": "turbo run test",
		"test:tools": "bun test tools",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"playwright": "^1.62.1",
		"turbo": "catalog:",
		"typescript": "catalog:"
	}
}
