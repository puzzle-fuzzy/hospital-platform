# Public edge is on meiyi.pro; the service binds only to the 3090 VPN address.
INSURANCE_QUERY_HOST=10.0.0.3
INSURANCE_QUERY_PORT=18084

# Login/logout/captcha remain a fixed legacy compatibility path for now.
LEGACY_HOSPITAL_API_BASE_URL=https://test-hp.meiyi.pro/api/v1
# 1101 查询改走新 API 的独立 Admin 路由，不接受任意上游路径。
ADMIN_QUERY_API_BASE_URL=http://10.0.0.3:18081/api/v1
ADMIN_QUERY_API_TOKEN=replace-with-the-same-server-token-as-ADMIN_QUERY_TOKEN
INSURANCE_QUERY_ALLOW_HTTP_UPSTREAM=true
