# Public edge is on meiyi.pro; the service binds only to the 3090 VPN address.
INSURANCE_QUERY_HOST=10.0.0.3
INSURANCE_QUERY_PORT=18084

# Login/logout/captcha remain a fixed legacy compatibility path for now.
LEGACY_HOSPITAL_API_BASE_URL=https://test-hp.meiyi.pro/api/v1
# 管理端只读取新服务日志；不发起医保参保查询或支付请求。
ADMIN_LOGS_API_BASE_URL=http://10.0.0.3:18081/api/v1
ADMIN_LOGS_API_TOKEN=replace-with-the-same-server-token-as-ADMIN_LOGS_TOKEN
ADMIN_REFUNDS_API_BASE_URL=http://10.0.0.3:18081/api/v1
ADMIN_REFUNDS_API_TOKEN=replace-with-the-same-server-token-as-ADMIN_REFUND_TOKEN
INSURANCE_QUERY_ALLOW_HTTP_UPSTREAM=true
INSURANCE_QUERY_PUBLIC_BASE=/
