# 新 Elysia API 的生产环境变量模板。
#
# 本文件只保存变量名、用途和安全边界，不保存真实凭据。
# 生产文件位于 /home/ps/code/hospital-platform/shared/api.env，必须通过受控 SSH 传输，
# 目录权限为 0700，文件权限为 0600；不要提交真实 api.env，也不要把它复制进 release 目录。

# 运行模式：生产日志会明确打印 runtimeMode=production。
NODE_ENV=production
# 新服务只监听 WireGuard 内网地址；公网流量由阿里云 Nginx 转发到这里。
HOST=10.0.0.3
PORT=18081
API_VERSION=0.1.0
# 生产关闭 OpenAPI，避免无意公开接口结构。
DOCS_ENABLED=false
# Pino 生产只记录 info 及以上级别，日志进入 journald。
LOG_LEVEL=info
# 浏览器管理端如未使用，可保持为空；小程序不依赖 CORS。
CORS_ORIGINS=https://test-hp.meiyi.pro

# MySQL 连接串：必须是新服务目标库；用户名、密码和特殊字符需要 URL 编码。
# 该连接串只在服务端使用，禁止出现在小程序、日志、响应或 Git 中。
DATABASE_URL=mysql://<数据库用户名>:<URL编码后的数据库密码>@<数据库地址>:3306/<数据库名>
# Redis 会话库：必须与数据库连接配置分开管理；末尾数字是 Redis DB 编号。
# 生产会话 token 只写入 Redis，并通过 TTL 自动过期。
REDIS_URL=redis://<Redis用户名>:<URL编码后的Redis密码>@<Redis地址>:6379/1

# 只有 0001-0011 全部迁移完成、schema 只读探针返回 ready 后才设置 true。
# API 不会在启动时隐式执行 migration。
PERSISTENCE_SCHEMA_READY=false
# 这两个变量只用于一次性受控 migration 命令，常驻 API 环境必须保持 false。
PERSISTENCE_MIGRATION_ALLOW_REMOTE=false
PERSISTENCE_MIGRATION_ALLOW_PRODUCTION=false

# 微信身份登录配置。AppID 可以出现在小程序公共 project.config.json，AppSecret 只能在这里出现。
# true 只是表示字段完整；真实可用性还必须通过 code2session 和真机登录验收。
WECHAT_IDENTITY_READY=false
WECHAT_APPID=<微信小程序AppID>
WECHAT_APP_SECRET=<微信小程序AppSecret>
WECHAT_IDENTITY_BASE_URL=https://api.weixin.qq.com

# 微信支付保持关闭，直到商户证书、平台公钥、APIv3 密钥和回调地址分别完成验收。
WECHAT_PAYMENT_READY=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERTIFICATE_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com

# 众阳患者、预约和报告能力独立 gate；登录验收阶段不自动打开这些 provider 能力。
ZHONGYANG_PATIENT_DIRECTORY_READY=false
ZHONGYANG_APPOINTMENT_DIRECTORY_READY=false
ZHONGYANG_APPOINTMENT_RECORDS_READY=false
ZHONGYANG_REPORT_DIRECTORY_READY=false
ZHONGYANG_REPORT_DETAIL_READY=false
ZHONGYANG_BASE_URL=
# provider token 只能由服务端读取，不能下发到小程序或写入日志。
ZHONGYANG_AUTHORIZATION_TOKEN=

# 微信支付预支付参数的数据库密文保护密钥；支付未开启时保持为空。
PAYMENT_DATA_ENCRYPTION_KEY=
