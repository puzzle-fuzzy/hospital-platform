# 新 Elysia API 的生产环境变量模板。
#
# 本文件只保存变量名、用途和安全边界，不保存真实凭据。
# 生产文件位于 /home/ps/code/hospital-platform/shared/api.env，必须通过受控 SSH 传输，
# 目录权限为 0700，文件权限为 0600；不要提交真实 api.env，也不要把它复制进 release 目录。

# 运行模式：生产日志会明确打印 runtimeMode=production。
NODE_ENV=production
# 新服务只监听 WireGuard 内网地址；公网流量由阿里云 Nginx 转发到这里。
HOST=10.0.0.3
PORT=18081
API_VERSION=0.1.0
# Bun 1.3 在 systemd 的 PrivateTmp/ProtectSystem 沙箱下不能依赖系统默认临时目录；
# 该目录必须由 ps 预先创建为 0700，并加入 ReadWritePaths 覆盖的项目目录。
# 这不是业务数据目录，只用于 Bun 运行时临时文件。
BUN_TMPDIR=/home/ps/code/hospital-platform/shared/tmp
# 生产关闭 OpenAPI，避免无意公开接口结构。
DOCS_ENABLED=false
# Pino 生产只记录 info 及以上级别，日志进入 journald。
LOG_LEVEL=info
# 浏览器管理端如未使用，可保持为空；小程序不依赖 CORS。
CORS_ORIGINS=https://test-hp.meiyi.pro

# MySQL 连接串：必须是新服务目标库；用户名、密码和特殊字符需要 URL 编码。
# 该连接串只在服务端使用，禁止出现在小程序、日志、响应或 Git 中。
DATABASE_URL=mysql://<数据库用户名>:<URL编码后的数据库密码>@<数据库地址>:3306/<数据库名>
# Redis 会话库：必须使用新服务专用 Redis 用户和独立 DB；末尾数字是新服务 Redis DB 编号。
# 生产会话 token 只写入 Redis，并通过 TTL 自动过期。当前生产使用 DB3，ACL 只允许
# hospital:session:*，以及 PING/SELECT/GET/SET；不要复用旧 Python 服务的 admin/DB1。
REDIS_URL=redis://<新服务专用Redis用户名>:<URL编码后的Redis密码>@<Redis地址>:6379/<新服务独立DB编号>
# 仅供人工执行或受控一次性 unit 的 TTL 聚合命令，不要加入 API 的常驻 EnvironmentFile。
# 应使用单独的只读维护 ACL；没有它时命令回退 REDIS_URL，并在 SCAN 被拒绝时 fail-closed。
# REDIS_SESSION_AUDIT_URL=redis://<TTL审计只读用户名>:<URL编码后的密码>@<Redis地址>:6379/<新服务独立DB编号>

# 只有 packages/persistence/src/migrate.ts 登记的全部迁移完成、schema 只读探针返回 ready 后才设置 true。
# 当前 migration head 为 0030_medical_insurance_owner_patient_fk；该变量不是自动迁移开关。
# API 不会在启动时隐式执行 migration。
PERSISTENCE_SCHEMA_READY=false
# 这两个变量只用于一次性受控 migration 命令，常驻 API 环境必须保持 false。
PERSISTENCE_MIGRATION_ALLOW_REMOTE=false
PERSISTENCE_MIGRATION_ALLOW_PRODUCTION=false

# 微信身份登录配置。AppID 可以出现在小程序公共 project.config.json，AppSecret 只能在这里出现。
# true 只是表示字段完整；真实可用性还必须通过 code2session 和真机登录验收。
WECHAT_IDENTITY_READY=false
WECHAT_APPID=<微信小程序AppID>
WECHAT_APP_SECRET=<微信小程序AppSecret>
WECHAT_IDENTITY_BASE_URL=https://api.weixin.qq.com

# 微信支付保持关闭，直到商户证书、平台公钥、APIv3 密钥和回调地址分别完成验收。
WECHAT_PAYMENT_READY=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_CERTIFICATE_SERIAL=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE_SERIAL=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_BASE_URL=https://api.mch.weixin.qq.com

# 医保移动支付 FSI 保持关闭；新项目不迁移旧代码中的硬编码 relay Bearer。
MEDICAL_INSURANCE_READY=false
MBS_FORWARD_RELAY_URL=
# FSI/HIS 的 base_url 只作为 HTTPS relay 请求体中的内网路由目标，按旧正式链路可使用 HTTP。
MBS_FORWARD_BASE_URL_6201=
# 1101 通用 FSI 的 forward 目标，与 6201/6202 目标分开配置。
MBS_FORWARD_BASE_URL=
MBS_FORWARD_AUTHORIZATION_TOKEN=<医保relay服务密钥>
MBS_APP_ID=
MBS_APP_SECRET=<医保渠道密钥>
MBS_SM2_PRIVATE_KEY_B64=<己方SM2私钥Base64>
MBS_SM2_OWN_PUBLIC_B64=<己方SM2公钥Base64>
MBS_SM2_PLATFORM_PUBLIC_B64=<医保平台SM2公钥Base64>
MBS_SM2_USER_ID=1234567812345678
MBS_ENCRYPT_ENABLE=true
MBS_SM2_VERIFY_STRICT=true
MBS_USER_QUERY_BASE_URL=https://test-receiver.wecity.qq.com
MBS_USER_QUERY_PATH=/api/mipuserquery/userQuery/50010828
MBS_INSURANCE_ORG_CODE=H14058101270
MBS_HOSPITAL_ID=10389001
MBS_INSUTYPE=310
MBS_INSU_CODE=140581

# 众阳患者、预约和报告能力独立 gate；登录验收阶段不自动打开这些 provider 能力。
ZHONGYANG_PATIENT_DIRECTORY_READY=false
# 新增就诊人的查档、建档和绑卡必须单独完成真实环境验收后才打开。
ZHONGYANG_PATIENT_BINDING_READY=false
ZHONGYANG_APPOINTMENT_DIRECTORY_READY=false
ZHONGYANG_APPOINTMENT_RECORDS_READY=false
# 预约占位、写入和取消独立开关；完成 0024/Provider 合同验收后才改为 true。
ZHONGYANG_APPOINTMENT_WRITES_READY=false
# 门诊病历只读接口（out-visit-records）独立开关；未完成真实接口验收前保持 false
ZHONGYANG_MEDICAL_RECORDS_READY=false
# 门诊缴费只读目录独立 gate；支付、医保和 HIS 回写不由该开关隐式开启。
ZHONGYANG_OUTPATIENT_PAYMENT_READY=false
# 众阳门诊费用查询使用的服务端渠道标识，必须与 provider 合同一致。
OUTPATIENT_PAYMENT_AUTH_SYS_CODE=thirdSelfMachine
ZHONGYANG_REPORT_DIRECTORY_READY=false
ZHONGYANG_REPORT_DETAIL_READY=false
# 旧服务的 VITE_ZHONGYI_BASE_API；新服务仅在服务端使用，不能下发到小程序。
ZHONGYANG_BASE_URL=https://gpsrmyy.meiyi.pro
# provider token 只能由服务端读取，不能下发到小程序或写入日志。
ZHONGYANG_AUTHORIZATION_TOKEN=

# 微信支付预支付参数的数据库密文保护密钥；支付未开启时保持为空。
PAYMENT_DATA_ENCRYPTION_KEY=
# 医保 payToken 短期上下文的独立 Base64 32 字节 AES-GCM 密钥；不得与微信支付密钥复用。
MEDICAL_INSURANCE_CREDENTIAL_ENCRYPTION_KEY=
