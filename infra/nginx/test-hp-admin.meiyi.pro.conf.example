# Public edge for the insurance query admin. The certificate is issued for the
# exact hostname test-hp-admin.meiyi.pro and is managed by Certbot.

server {
    listen 80;
    server_name test-hp-admin.meiyi.pro;

    # Keep the ACME path available for future certificate renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name test-hp-admin.meiyi.pro;

    ssl_certificate /etc/letsencrypt/live/test-hp-admin.meiyi.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/test-hp-admin.meiyi.pro/privkey.pem;

    # The current edge OpenSSL/client combination reports TLS 1.3
    # "bad key share" for some browsers. Keep this test admin endpoint
    # reachable with the broadly supported TLS 1.2 profile.
    ssl_protocols TLSv1.2;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_ecdh_curve prime256v1;

    location / {
        proxy_pass http://10.0.0.3:18084;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
