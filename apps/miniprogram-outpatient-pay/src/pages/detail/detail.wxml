<view class="page">
	<view wx:if="{{loading || error}}" class="state-card">
		<text wx:if="{{loading}}">正在加载门诊费用详情...</text>
		<block wx:else>
			<text class="state-title">门诊费用详情暂不可用</text>
			<text class="error">{{error}}</text>
			<button class="retry-button" size="mini" bindtap="onRetry">重新加载</button>
			<button class="back-button" size="mini" bindtap="onBack">返回费用记录</button>
		</block>
	</view>

	<block wx:elif="{{item && patient}}">
		<view class="title-row">
			<view>
				<view class="eyebrow">OUTPATIENT PAYMENT</view>
				<view class="title">门诊费用详情</view>
			</view>
			<view class="status">{{statusLabel(item.status)}}</view>
		</view>

		<view class="card">
			<view class="label">就诊人</view>
			<view class="patient-name">{{patient.displayName}}</view>
			<view class="muted">{{patient.cardNumberMasked}}</view>
		</view>

		<view class="card">
			<view class="label">医院</view>
			<view class="value">高平市人民医院</view>
			<view class="line"><text>就诊科室</text><text>{{item.departmentName || '门诊费用'}}</text></view>
			<view wx:if="{{item.doctorName}}" class="line"><text>就诊医生</text><text>{{item.doctorName}}</text></view>
			<view class="line"><text>费用日期</text><text>{{formatDate(item.billDate)}}</text></view>
			<view class="line last"><text>账单金额</text><text class="amount">¥ {{formatAmount(item.amountFen)}}</text></view>
		</view>

		<view class="notice-card">
			<view class="notice-title">已核对的费用摘要</view>
			<view class="muted">当前展示的是新版平台根据众阳 2.6.33 核对后的摘要。项目级费用明细、医保分摊和电子票据需待正式接口合同确认后开放。</view>
		</view>
		<view class="back-link" bindtap="onBack">返回费用记录</view>
	</block>
</view>
