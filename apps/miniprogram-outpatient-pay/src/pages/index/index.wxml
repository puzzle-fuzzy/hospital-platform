<view class="page">
	<view class="hero">
		<view class="eyebrow">OUTPATIENT PAYMENT</view>
		<view class="title">门诊缴费</view>
		<view class="subtitle">门诊支付 · {{businessType}} / {{orderType}} · 先选择就诊人，再查看真实待缴费用</view>
	</view>

	<view class="card">
		<view class="label">就诊人</view>
		<picker mode="selector" range="{{patientNames}}" value="{{patientIndex}}" bindchange="onPatientChange" disabled="{{busy}}">
			<view class="picker-row">
				<text class="value">{{patientIndex >= 0 ? patientNames[patientIndex] : '请选择就诊人'}}</text>
				<text class="arrow">›</text>
			</view>
		</picker>
		<view wx:if="{{selectedPatient}}" class="muted patient-meta">{{selectedPatient.relation}} · {{selectedPatient.cardNumberMasked}}</view>
	</view>

	<view wx:if="{{error}}" class="card error-card"><text class="error">{{error}}</text></view>
	<view wx:if="{{message}}" class="status-card"><view class="status-dot"></view><text class="status-message">{{message}}</text></view>

	<view class="card">
		<view class="section-heading">
			<view class="label">待缴费用</view>
			<view class="muted">{{records.length}} 笔</view>
		</view>
		<view wx:for="{{records}}" wx:key="recordId" class="bill-row">
			<view class="bill-main">
				<view class="bill-name">{{item.departmentName || '门诊费用'}}</view>
				<view wx:if="{{item.doctorName}}" class="muted">{{item.billDate}} · {{item.doctorName}}</view>
				<view wx:else class="muted">{{item.billDate}}</view>
			</view>
			<view class="amount">¥ {{formatAmount(item.amountFen)}}</view>
		</view>
		<view wx:if="{{!records.length && !busy}}" class="empty">当前没有可缴费的门诊项目</view>
	</view>

	<view class="card contract-card">
		<view class="label">支付流程</view>
		<view class="contract-title">支付方式将由服务端结算链路决定</view>
		<view class="muted contract-text">{{formatPaymentType()}}</view>
		<view class="muted contract-text">当前已接入真实待缴费查询（2.6.33）。2.6.65.1、2.6.65.2、2.6.65.4、2.6.65.5、2.6.65.6、2.6.65.11 与 2.27.2.32 的服务端合同确认后，才会开放对应支付按钮。</view>
		<view class="contract-tip">当前不会提交支付订单，也不会显示虚假的支付成功。</view>
	</view>

	<view class="footnote">费用与支付结果以医院服务端最终结算为准。</view>
</view>
