.patient-hospital-context {
	display: block;
	overflow: hidden;
	width: 100%;
	margin: 0;
	background: #fff;
}

.patient-hospital-context-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: var(--patient-context-row-height, 92rpx);
	padding: var(--patient-context-row-padding, 26rpx 30rpx);
	color: #333;
}

.patient-hospital-context-row-border {
	border-bottom: 1rpx solid #f0f0f0;
}

.patient-hospital-context-row-selectable:active,
.patient-hospital-context-row-border:active {
	background: #fafafa;
}

.patient-hospital-context-label {
	flex: 0 0 var(--patient-context-label-width, 150rpx);
	color: var(--patient-context-label-color, #333);
	font-size: var(--patient-context-label-font-size, 28rpx);
}

.patient-hospital-context-value {
	display: flex;
	align-items: center;
	justify-content: var(--patient-context-value-align, flex-end);
	flex: 1;
	min-width: 0;
	font-size: var(--patient-context-value-font-size, 30rpx);
	text-align: right;
}

.patient-hospital-context-name {
	overflow: hidden;
	min-width: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.patient-hospital-context-card-number {
	margin-left: var(--patient-context-card-gap, 10rpx);
	color: var(--patient-context-card-color, #999);
	font-size: var(--patient-context-card-font-size, 23rpx);
	white-space: var(--patient-context-card-white-space, normal);
}

.patient-hospital-context-arrow {
	display: block;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
	margin-left: var(--patient-context-arrow-margin, 14rpx);
}

.patient-hospital-context-error {
	padding: 0 30rpx 18rpx;
	color: #a15b18;
	font-size: 24rpx;
	line-height: 1.5;
	text-align: right;
}
