<view class="patient-hospital-context">
	<view class="patient-hospital-context-row patient-hospital-context-row-border" bindtap="onPatientTap">
		<text class="patient-hospital-context-label">就诊人</text>
		<view class="patient-hospital-context-value">
			<text wx:if="{{patient}}" class="patient-hospital-context-name">{{patientName}}</text>
			<text wx:elif="{{loading}}" class="patient-hospital-context-name">正在加载就诊人...</text>
			<text wx:else class="patient-hospital-context-name">{{patientName}}</text>
			<text wx:if="{{patient}}" class="patient-hospital-context-card-number">（{{patientCardLabel}}）</text>
			<image class="patient-hospital-context-arrow" src="/assets/legacy-user/selector-arrow-right.svg" mode="aspectFit" />
		</view>
	</view>
	<view
		class="patient-hospital-context-row {{hospitalSelectable ? 'patient-hospital-context-row-selectable' : ''}}"
		bindtap="onHospitalTap"
	>
		<text class="patient-hospital-context-label">当前院区</text>
		<view class="patient-hospital-context-value">
			<text>{{hospitalName}}</text>
			<image
				wx:if="{{hospitalSelectable}}"
				class="patient-hospital-context-arrow"
				src="/assets/legacy-user/selector-arrow-right.svg"
				mode="aspectFit"
			/>
		</view>
	</view>
	<view wx:if="{{error}}" class="patient-hospital-context-error" bindtap="onRetry">{{error}} · 点击重试</view>
</view>
