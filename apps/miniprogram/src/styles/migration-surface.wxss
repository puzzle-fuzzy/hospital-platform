/*
 * 临床、外部和 Provider 关闭态页面共用的视觉骨架。
 * 这是入口迁移样式，不代表三类业务可以共用数据模型；真实页面开放后
 * 应保留页面语义，但替换为各自的加载、空结果、拒绝和失败状态。
 */
.migration-surface-scroll {
	height: 100vh;
	background: #f6f8fc;
}

.migration-surface-page {
	box-sizing: border-box;
	min-height: 100%;
	padding: 28rpx 24rpx 52rpx;
}

.migration-surface-hero,
.migration-surface-card {
	box-sizing: border-box;
	border-radius: 20rpx;
	background: #fff;
	box-shadow: 0 8rpx 26rpx rgba(40, 74, 150, 0.06);
}

.migration-surface-hero {
	display: flex;
	align-items: center;
	padding: 34rpx 30rpx;
}

.migration-surface-icon {
	flex: 0 0 auto;
	width: 82rpx;
	height: 82rpx;
	margin-right: 22rpx;
}

.migration-surface-hero-copy {
	display: flex;
	flex-direction: column;
}

.migration-surface-title {
	color: #222b45;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 1.4;
}

.migration-surface-label {
	display: inline-block;
	margin-top: 12rpx;
	color: #3d6df6;
	font-size: 24rpx;
	line-height: 1.5;
}

.migration-surface-card {
	margin-top: 22rpx;
	padding: 30rpx;
}

.migration-surface-card-title {
	display: block;
	color: #222b45;
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1.5;
}

.migration-surface-card-copy {
	display: block;
	margin-top: 16rpx;
	color: #68738a;
	font-size: 27rpx;
	line-height: 1.7;
}

/*
 * 关闭态页面也必须明确当前业务上下文，但这个卡片只展示 owner-scoped
 * 脱敏患者目录，不代表病历、住院或 Provider 数据已经开放。固定卡片结构
 * 让加载、失败和成功状态共用同一高度，避免返回选择页后布局跳变。
 */
.migration-surface-patient-card {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 18rpx;
	min-height: 142rpx;
	margin-top: 22rpx;
	padding: 24rpx 26rpx;
	border-radius: 20rpx;
	background: #f0f5ff;
}

.migration-surface-patient-copy {
	min-width: 0;
	display: flex;
	flex: 1;
	flex-direction: column;
}

.migration-surface-patient-label {
	color: #8791a5;
	font-size: 23rpx;
	line-height: 1.5;
}

.migration-surface-patient-name {
	margin-top: 6rpx;
	overflow: hidden;
	color: #222b45;
	font-size: 29rpx;
	font-weight: 600;
	line-height: 1.5;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.migration-surface-patient-meta,
.migration-surface-patient-error {
	margin-top: 4rpx;
	color: #68738a;
	font-size: 23rpx;
	line-height: 1.5;
}

.migration-surface-patient-error {
	color: #d84a4a;
}

.migration-surface-patient-action,
.migration-surface-patient-retry {
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 154rpx;
	margin: 0;
	padding: 0 18rpx;
	border: 0;
	border-radius: 12rpx;
	background: #3d6df6;
	color: #fff;
	font-size: 24rpx;
	line-height: 66rpx;
}

.migration-surface-patient-retry {
	align-self: flex-start;
	min-width: 132rpx;
	margin-top: 10rpx;
	background: #fff;
	color: #d84a4a;
	line-height: 54rpx;
}

.migration-surface-list {
	margin-top: 20rpx;
}

.migration-surface-list-row {
	display: flex;
	align-items: flex-start;
	margin-top: 12rpx;
}

.migration-surface-list-dot {
	width: 28rpx;
	color: #3d6df6;
	font-size: 30rpx;
	line-height: 1.4;
}

.migration-surface-list-text {
	flex: 1;
	color: #68738a;
	font-size: 26rpx;
	line-height: 1.7;
}

.migration-surface-coverage {
	display: block;
	margin-top: 22rpx;
	padding-top: 18rpx;
	border-top: 1rpx solid #edf0f5;
	color: #8791a5;
	font-size: 23rpx;
	line-height: 1.6;
}

.migration-surface-primary-button,
.migration-surface-secondary-button,
.migration-surface-plain-button {
	box-sizing: border-box;
	width: 100%;
	border-radius: 16rpx;
	font-size: 28rpx;
	line-height: 84rpx;
}

.migration-surface-primary-button {
	margin-top: 28rpx;
	background: #3d6df6;
	color: #fff;
}

.migration-surface-secondary-button {
	margin-top: 24rpx;
	background: #edf3ff;
	color: #3d6df6;
}

.migration-surface-plain-button {
	margin-top: 14rpx;
	background: transparent;
	color: #68738a;
}
