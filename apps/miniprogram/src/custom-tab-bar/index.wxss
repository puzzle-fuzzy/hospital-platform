/*
	底栏只在这个官方共享组件中固定一次。页面不再声明 position: fixed 的
	底栏，也不再自己判断当前 Tab；这样四个主页面切换时不会先销毁旧底栏，
	再创建一份新的底栏。
*/
.legacy-tabbar {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 20;
	display: flex;
	align-items: stretch;
	justify-content: space-around;
	box-sizing: border-box;
	height: calc(130rpx + env(safe-area-inset-bottom));
	padding-bottom: env(safe-area-inset-bottom);
	border-top: 1rpx solid #eeeeee;
	background: #ffffff;
}

.legacy-tabbar-item {
	display: flex;
	align-items: center;
	justify-content: flex-start;
	box-sizing: border-box;
	flex: 1 1 0;
	width: auto;
	height: 130rpx;
	padding: 0;
	color: #2c2c2c;
	flex-direction: column;
	font-size: 20rpx;
	line-height: 1;
	justify-content: center;
}

.legacy-tabbar-item-active {
	color: #3d6df6;
	font-weight: 500;
}

.legacy-tabbar-icon {
	display: block;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 8rpx;
}
