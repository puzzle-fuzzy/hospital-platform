<!--
	微信官方 custom-tab-bar 是四个主入口唯一的底栏实例。
	普通业务页不会渲染这段 WXML；主入口切换必须使用 switchTab，避免把
	“我的”等 Tab 页面压入普通页面栈后产生第二套底栏。
-->
<view class="legacy-tabbar" role="tablist" aria-busy="{{switching}}">
	<view
		wx:for="{{items}}"
		wx:key="route"
		class="legacy-tabbar-item {{index === selected ? 'legacy-tabbar-item-active' : ''}}"
		bindtap="onTabTap"
		data-index="{{index}}"
		aria-label="{{item.text}}"
		aria-current="{{index === selected ? 'page' : false}}"
		role="tab"
	>
		<image
			class="legacy-tabbar-icon"
			src="{{index === selected ? item.activeIcon : item.icon}}"
			mode="aspectFit"
			aria-hidden="true"
		/>
		<text>{{item.text}}</text>
	</view>
</view>
