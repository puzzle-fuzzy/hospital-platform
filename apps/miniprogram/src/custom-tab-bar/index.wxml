<!--
	微信官方 custom-tab-bar 是四个主入口唯一的底栏实例。
	普通业务页不会渲染这段 WXML；主 Tab 切换必须使用 switchTab，不能把
	“我的”等主入口压入普通页面栈后再创建第二套底栏。
-->
<view class="legacy-tabbar" role="tablist" aria-busy="{{switching}}">
	<view
		wx:for="{{items}}"
		wx:key="route"
		class="legacy-tabbar-item {{item.selected ? 'legacy-tabbar-item-active' : ''}}"
		bindtap="onTabTap"
		data-index="{{index}}"
		aria-label="{{item.text}}"
		aria-current="{{item.selected ? 'page' : ''}}"
		role="tab"
	>
		<image
			class="legacy-tabbar-icon"
			src="{{item.selected ? item.activeIcon : item.icon}}"
			mode="aspectFit"
			aria-hidden="true"
		/>
		<text>{{item.text}}</text>
	</view>
</view>
