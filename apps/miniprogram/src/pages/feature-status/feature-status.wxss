.feature-status-scroll {
	height: 100vh;
	background: #f6f8fc;
}

.feature-status-page {
	box-sizing: border-box;
	min-height: 100%;
	padding: 32rpx 24rpx 48rpx;
}

.feature-status-card,
.feature-status-panel {
	box-sizing: border-box;
	border-radius: 20rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 26rpx rgba(40, 74, 150, 0.06);
}

.feature-status-card {
	display: flex;
	align-items: center;
	flex-direction: column;
	padding: 56rpx 36rpx 48rpx;
}

.feature-status-icon {
	width: 96rpx;
	height: 96rpx;
	margin-bottom: 24rpx;
}

.feature-status-title {
	color: #222b45;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 1.4;
}

.feature-status-badge {
	margin-top: 18rpx;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
	background: #edf3ff;
	color: #3d6df6;
	font-size: 24rpx;
	line-height: 1.4;
}

.feature-status-description {
	margin-top: 28rpx;
	color: #68738a;
	font-size: 28rpx;
	line-height: 1.7;
	text-align: center;
}

.feature-status-panel {
	margin-top: 24rpx;
	padding: 32rpx;
}

.feature-status-panel-title {
	color: #222b45;
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1.5;
}

.feature-status-panel-copy {
	display: block;
	margin-top: 18rpx;
	color: #68738a;
	font-size: 27rpx;
	line-height: 1.7;
}

.feature-status-coverage {
	margin-top: 28rpx;
	padding: 22rpx 24rpx;
	border-radius: 14rpx;
	background: #f7f9fd;
}

.feature-status-coverage-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 44rpx;
	color: #8791a5;
	font-size: 24rpx;
	line-height: 1.6;
}

.feature-status-coverage-value {
	margin-left: 24rpx;
	color: #3d6df6;
	text-align: right;
}

.feature-status-next-step {
	display: block;
	margin-top: 14rpx;
	color: #68738a;
	font-size: 24rpx;
	line-height: 1.6;
}

/*
 * 迁移批次是跨页面的执行坐标，单独留出一层，避免把“下一步”误解为
 * 当前页面马上可用；所有批次都只展示输入要求，不触发任何业务请求。
 */
.feature-status-batch {
	margin-top: 20rpx;
	padding-top: 18rpx;
	border-top: 1rpx solid #e9edf5;
}

.feature-status-batch-next {
	display: block;
	margin-top: 10rpx;
	color: #8791a5;
	font-size: 23rpx;
	line-height: 1.6;
}

/*
 * 状态页不仅解释“为什么暂未开放”，还要把旧端覆盖范围展示出来。
 * 这里使用低对比度的等宽文本，方便排查入口映射，同时避免把路径误认成
 * 可直接访问的微信页面或 Provider 地址。
 */
.feature-status-entry-list,
.feature-status-domain-list {
	margin-top: 24rpx;
	padding-top: 22rpx;
	border-top: 1rpx solid #e9edf5;
}

.feature-status-detail-title {
	display: block;
	color: #8791a5;
	font-size: 24rpx;
	font-weight: 600;
	line-height: 1.6;
}

.feature-status-entry-row {
	margin-top: 10rpx;
}

.feature-status-entry-path {
	color: #68738a;
	font-family: monospace;
	font-size: 22rpx;
	line-height: 1.6;
	word-break: break-all;
}

.feature-status-domain-value {
	display: block;
	margin-top: 10rpx;
	color: #3d6df6;
	font-size: 24rpx;
	line-height: 1.6;
}

/*
 * 逐入口说明来自迁移台账的 note，不是新的业务状态源。
 * 状态页必须把“已迁移的安全子集”和“仍然关闭的扩展能力”同时说明，
 * 防止用户把 partial 或 blocked 入口误解成完整业务已经可用。
 */
.feature-status-note-list {
	margin-top: 24rpx;
	padding-top: 22rpx;
	border-top: 1rpx solid #e9edf5;
}

.feature-status-note-row {
	margin-top: 10rpx;
}

.feature-status-note {
	display: block;
	color: #68738a;
	font-size: 24rpx;
	line-height: 1.7;
}

.feature-status-notice {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	margin-top: 28rpx;
	padding: 24rpx;
	border-radius: 14rpx;
	background: #f7f9fd;
	color: #8791a5;
	font-size: 24rpx;
	line-height: 1.6;
}

.feature-status-home-button {
	box-sizing: border-box;
	width: 100%;
	margin-top: 28rpx;
	border-radius: 16rpx;
	background: #3d6df6;
	color: #ffffff;
	font-size: 28rpx;
	line-height: 88rpx;
}
