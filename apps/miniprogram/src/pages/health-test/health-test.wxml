<scroll-view class="health-test-scroll" scroll-y="true" enhanced="true">
	<view class="health-test-page">
		<view class="health-test-section">
			<view class="health-test-section-title">自测评估</view>
			<view class="health-test-grid health-test-grid-assessment">
				<view wx:for="{{assessmentItems}}" wx:key="key" class="health-test-grid-item {{item.available ? '' : 'health-test-grid-item-disabled'}}" data-key="{{item.key}}" bindtap="onAssessmentTap">
					<view class="health-test-icon">{{item.icon}}</view>
					<text class="health-test-grid-name">{{item.name}}</text>
				</view>
			</view>
		</view>

		<view class="health-test-section health-test-interpretation-section">
			<view class="health-test-section-title">指标解读</view>
			<view class="health-test-grid health-test-grid-interpretation">
				<view wx:for="{{interpretationItems}}" wx:key="name" class="health-test-grid-item" data-name="{{item.name}}" bindtap="onInterpretationTap">
					<view class="health-test-icon health-test-icon-interpretation">{{item.icon}}</view>
					<text class="health-test-grid-name">{{item.name}}</text>
				</view>
			</view>
		</view>

		<view class="health-test-tools">
			<view class="health-test-tools-title">可用工具</view>
			<view class="health-test-tabs">
				<view class="health-test-tab {{mode === 'bmi' ? 'is-active' : ''}}" data-mode="bmi" bindtap="onModeTap">BMI 计算</view>
				<view class="health-test-tab {{mode === 'blood-pressure' ? 'is-active' : ''}}" data-mode="blood-pressure" bindtap="onModeTap">血压记录</view>
			</view>

			<view wx:if="{{mode === 'bmi'}}" class="health-test-card">
				<text class="health-test-card-title">BMI 数值计算</text>
				<text class="health-test-card-copy">输入身高和体重，计算公式结果。这里不提供体重分类或疾病风险判断。</text>
				<view class="health-test-field">
					<text class="health-test-label">身高</text>
					<input class="health-test-input" type="digit" value="{{height}}" data-field="height" bindinput="onInput" placeholder="请输入身高" />
					<text class="health-test-unit">cm</text>
				</view>
				<view class="health-test-field">
					<text class="health-test-label">体重</text>
					<input class="health-test-input" type="digit" value="{{weight}}" data-field="weight" bindinput="onInput" placeholder="请输入体重" />
					<text class="health-test-unit">kg</text>
				</view>
				<button class="health-test-primary-button" bindtap="onCalculateBmi">计算 BMI</button>
				<view wx:if="{{hasBmiResult}}" class="health-test-result">
					<text class="health-test-result-label">本次 BMI</text>
					<text class="health-test-result-value">{{bmiDisplay}}</text>
				</view>
			</view>

			<view wx:if="{{mode === 'blood-pressure'}}" class="health-test-card">
				<text class="health-test-card-title">血压读数记录</text>
				<text class="health-test-card-copy">输入一次测量值，仅做格式校验和展示，不提供血压分级。</text>
				<view class="health-test-field">
					<text class="health-test-label">收缩压</text>
					<input class="health-test-input" type="number" value="{{systolic}}" data-field="systolic" bindinput="onInput" placeholder="请输入收缩压" />
					<text class="health-test-unit">mmHg</text>
				</view>
				<view class="health-test-field">
					<text class="health-test-label">舒张压</text>
					<input class="health-test-input" type="number" value="{{diastolic}}" data-field="diastolic" bindinput="onInput" placeholder="请输入舒张压" />
					<text class="health-test-unit">mmHg</text>
				</view>
				<button class="health-test-primary-button" bindtap="onRecordBloodPressure">记录读数</button>
				<view wx:if="{{hasBloodPressureResult}}" class="health-test-result">
					<text class="health-test-result-label">本次读数</text>
					<text class="health-test-result-value">{{bloodPressureDisplay}}</text>
				</view>
			</view>
		</view>

		<view wx:if="{{message}}" class="health-test-message">{{message}}</view>
		<view class="health-test-notice">
			<text>重要提示</text>
			<text>健康自测仅供参考，不替代医生诊断、处方或就医建议。暂未开放的题库入口保持旧服务名称，待审核题目与结果规则迁移后再启用。</text>
		</view>
		<button class="health-test-plain-button" bindtap="onBackHome">返回医疗服务</button>

		<view wx:if="{{showTips}}" class="health-test-popup-mask" bindtap="onCloseTips">
			<view class="health-test-popup" catchtap="onCloseTips">
				<text class="health-test-popup-title">{{tipsTitle}}</text>
				<text class="health-test-popup-content">{{tipsContent}}</text>
				<button class="health-test-popup-button" bindtap="onCloseTips">知道了</button>
			</view>
		</view>
	</view>
</scroll-view>
