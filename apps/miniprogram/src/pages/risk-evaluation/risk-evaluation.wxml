<scroll-view class="risk-scroll" scroll-y="true" enhanced="true">
	<view class="risk-page">
		<view class="risk-patient" bindtap="onChangePatient">
			<view class="risk-patient-copy">
				<text class="risk-patient-label">当前就诊人</text>
				<text wx:if="{{patient}}" class="risk-patient-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="risk-muted">正在获取就诊人...</text>
				<text wx:else class="risk-muted">请选择就诊人</text>
				<text wx:if="{{patient}}" class="risk-patient-card">{{patient.cardNumberMasked}}</text>
				<text wx:if="{{patientError}}" class="risk-error">{{patientError}}</text>
			</view>
			<text class="risk-arrow">›</text>
		</view>

		<view class="risk-form-list">
			<view wx:for="{{formItems}}" wx:key="key" class="risk-form-item {{selectedForm === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="onFormTap">
				<view class="risk-form-icon">{{index + 1}}</view>
				<view class="risk-form-copy">
					<text class="risk-form-title">{{item.title}}</text>
					<text class="risk-form-subtitle">{{item.subtitle}}</text>
				</view>
				<text class="risk-form-action">{{selectedForm === item.key ? '已选择' : '去评估'}}</text>
			</view>
		</view>

		<view wx:if="{{selectedForm === 'fall'}}" class="risk-editor">
			<view wx:for="{{fallGroups}}" wx:key="key" class="risk-group">
				<text class="risk-group-title">{{item.title}}</text>
				<view wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="risk-option {{selections[item.key].indexOf(option.value) >= 0 ? 'is-selected' : ''}}" data-group-key="{{item.key}}" data-value="{{option.value}}" bindtap="onOptionTap">
					<view class="risk-check">{{selections[item.key].indexOf(option.value) >= 0 ? '✓' : ''}}</view>
					<text>{{option.label}}</text>
				</view>
			</view>
			<button class="risk-submit" bindtap="onSubmit">提交评估</button>
		</view>

		<view wx:if="{{selectedForm === 'pressure'}}" class="risk-editor">
			<view wx:for="{{pressureGroups}}" wx:key="key" class="risk-group">
				<text class="risk-group-title">{{item.title}}</text>
				<view wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="risk-option {{selections[item.key].indexOf(option.value) >= 0 ? 'is-selected' : ''}}" data-group-key="{{item.key}}" data-value="{{option.value}}" bindtap="onOptionTap">
					<view class="risk-check">{{selections[item.key].indexOf(option.value) >= 0 ? '✓' : ''}}</view>
					<text>{{option.label}}</text>
				</view>
			</view>
			<button class="risk-submit" bindtap="onSubmit">提交评估</button>
		</view>

		<view wx:if="{{selectedForm === 'pain'}}" class="risk-editor">
			<view wx:for="{{painGroups}}" wx:key="key" class="risk-group">
				<text class="risk-group-title">{{item.title}}</text>
				<view class="risk-pain-grid">
					<view wx:for="{{item.options}}" wx:for-item="option" wx:key="value" class="risk-pain-option {{selections[item.key].indexOf(option.value) >= 0 ? 'is-selected' : ''}}" data-group-key="{{item.key}}" data-value="{{option.value}}" bindtap="onOptionTap">{{option.label}}</view>
				</view>
			</view>
			<button class="risk-submit" bindtap="onSubmit">提交评估</button>
		</view>

		<view wx:if="{{message}}" class="risk-message">{{message}}</view>
		<text class="risk-note">评估量表与题目名称按旧服务迁移。当前客户端不计算风险等级，提交接口开放前不会保存答案。</text>
		<button class="risk-back" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
