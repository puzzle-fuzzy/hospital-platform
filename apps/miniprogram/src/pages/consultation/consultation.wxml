<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="consultation-page">
		<!-- 网络异常必须固定在页面顶部，保持和旧端页面一致。 -->
		<view wx:if="{{error}}" class="clinical-query-error-message">{{error}}</view>

		<!-- 旧端 PatientHospitalSelector：就诊人与院区各占一行。 -->
		<view class="consultation-selector-card">
			<view class="consultation-selector-row consultation-selector-row-border" bindtap="onChangePatient">
				<text class="consultation-selector-label">就诊人</text>
				<view class="consultation-selector-value">
					<text wx:if="{{selectedPatient}}" class="consultation-selector-name">{{selectedPatient.displayName}}</text>
					<text wx:elif="{{loading}}" class="consultation-selector-name">正在加载就诊人...</text>
					<text wx:else class="consultation-selector-name">请先选择就诊人</text>
					<text wx:if="{{selectedPatient}}" class="consultation-selector-card-number">（{{selectedPatient.cardNumberMasked}}）</text>
					<image class="consultation-selector-arrow" src="/assets/legacy-user/selector-arrow-right.svg" mode="aspectFit" />
				</view>
			</view>
			<view class="consultation-selector-row">
				<text class="consultation-selector-label">当前院区</text>
				<view class="consultation-selector-value">
					<text>高平市人民医院</text>
					<image class="consultation-selector-arrow" src="/assets/legacy-user/selector-arrow-right.svg" mode="aspectFit" />
				</view>
			</view>
		</view>

		<view class="consultation-record-area">
			<!-- 固定状态容器，避免加载态切换为空态时页面突然增高。 -->
			<view wx:if="{{queryState !== 'ready'}}" class="clinical-query-state query-state-shell query-state-shell-column">
				<block wx:if="{{queryState === 'loading'}}">
					<view class="clinical-query-loading-icon" aria-hidden="true"></view>
					<text class="clinical-query-state-title">正在查询记录...</text>
				</block>
				<block wx:elif="{{queryState === 'error'}}">
					<view class="clinical-query-error-icon" aria-hidden="true">!</view>
					<text class="clinical-query-state-title">问诊记录查询未完成</text>
					<text class="clinical-query-state-hint">请根据上方提示处理后重试</text>
					<view class="clinical-query-state-action" bindtap="onRetry">重新加载</view>
					<view wx:if="{{canSelectPatient}}" class="clinical-query-state-action" bindtap="onChangePatient">选择就诊人</view>
				</block>
				<block wx:else>
					<image class="clinical-query-state-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
					<text class="clinical-query-state-title">未查询到您的记录</text>
				</block>
			</view>

			<view wx:elif="{{visibleRecords.length}}" class="consultation-record-list">
				<!-- 旧端为白色纵向卡片；记录过多时只扩大列表，不一次性撑满渲染树。 -->
				<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="consultation-record-card">
					<view class="consultation-record-header">
						<view class="consultation-record-main">
							<text class="consultation-record-department">{{item.departmentName || "科室"}}</text>
							<view class="consultation-record-subtitle">
								<text>号源</text>
								<text wx:if="{{item.serialNumber}}"> · {{item.serialNumber}}</text>
							</view>
						</view>
						<text class="consultation-record-time">{{item.workDate}} {{item.workTime || ""}}</text>
					</view>
					<view class="consultation-record-hint">
						<text class="consultation-record-status">{{item.statusLabel}}</text>
					</view>
					<text wx:if="{{item.location}}" class="consultation-record-location">{{item.location}}</text>
				</view>
				<view wx:if="{{hasMoreRecords}}" class="consultation-load-more" bindtap="onLoadMore">加载更多记录</view>
			</view>
		</view>
	</view>
</scroll-view>
