@import "../../styles/clinical-query-state.wxss";
page {
	background: #f8f8f8;
}
.consultation-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
	background: #f5f5f5;
}

.consultation-error-message,
.consultation-selector-card,
.consultation-record-area {
	box-sizing: border-box;
	width: 100%;
}

.consultation-error-message {
	padding: 20rpx 40rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

/* 与旧端 PatientHospitalSelector 对齐：白色卡片、两行、分割线和箭头。 */
.consultation-selector-card {
	overflow: hidden;
	background: #fff;
}

.consultation-selector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	padding: 26rpx 30rpx;
	color: #333;
}

.consultation-selector-row-border {
	border-bottom: 1rpx solid #f0f0f0;
}

.consultation-selector-label {
	flex: 0 0 150rpx;
	font-size: 28rpx;
}

.consultation-selector-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
	font-size: 30rpx;
	text-align: right;
}

.consultation-selector-name {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.consultation-selector-card-number {
	margin-left: 10rpx;
	color: #999;
	font-size: 23rpx;
}

.consultation-selector-arrow {
	display: block;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
	margin-left: 14rpx;
}

.consultation-record-area {
	box-sizing: border-box;
	padding: 32rpx 32rpx 160rpx;
	background: #f5f5f5;
}

.consultation-state {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	box-sizing: border-box;
	height: 380rpx;
	min-height: 380rpx;
	padding: 40rpx 30rpx;
	border-radius: 16rpx;
	background: #fff;
	color: #777;
	text-align: center;
}

.consultation-state-image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.consultation-loading-icon {
	box-sizing: border-box;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 20rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #9ca3af;
	border-radius: 50%;
	animation: consultation-loading 900ms linear infinite;
}

@keyframes consultation-loading {
	to {
		transform: rotate(360deg);
	}
}

.consultation-state-title {
	display: block;
	font-size: 28rpx;
}

.consultation-state-hint {
	display: block;
	margin-top: 12rpx;
	color: #aaa;
	font-size: 23rpx;
}

.consultation-state-action {
	margin-top: 24rpx;
	padding: 12rpx 34rpx;
	border-radius: 999rpx;
	background: #3d6df6;
	color: #fff;
	font-size: 25rpx;
}

.consultation-record-card {
	box-sizing: border-box;
	margin-bottom: 24rpx;
	padding: 32rpx;
	border: 1rpx solid #f0f0f0;
	border-radius: 16rpx;
	background: #fff;
	box-shadow: 0 4rpx 16rpx rgba(35, 55, 95, 0.04);
}

.consultation-record-header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 20rpx;
}

.consultation-record-main {
	min-width: 0;
	flex: 1;
}

.consultation-record-department,
.consultation-record-subtitle,
.consultation-record-time,
.consultation-record-status,
.consultation-record-location {
	display: block;
}

.consultation-record-department {
	overflow: hidden;
	color: #222;
	font-size: 32rpx;
	font-weight: 600;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.consultation-record-subtitle {
	margin-top: 8rpx;
	color: #666;
	font-size: 24rpx;
}

.consultation-record-time {
	flex: 0 0 auto;
	max-width: 280rpx;
	margin-left: 18rpx;
	color: #3981f7;
	font-size: 24rpx;
	text-align: right;
}

.consultation-record-hint {
	margin-top: 20rpx;
	min-height: 36rpx;
}

.consultation-record-status {
	color: #ff8e0a;
	font-size: 24rpx;
}

.consultation-record-location {
	margin-top: 14rpx;
	color: #666;
	font-size: 24rpx;
	line-height: 1.6;
}

.consultation-load-more {
	padding: 14rpx 0 28rpx;
	color: #3d6df6;
	font-size: 25rpx;
	text-align: center;
}
