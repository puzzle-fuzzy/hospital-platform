<scroll-view class="discharge-scroll" scroll-y="true" enhanced="true">
	<view class="discharge-page">
		<view class="discharge-label">已绑定就诊人</view>
		<view class="discharge-patient" bindtap="onChangePatient">
			<view class="discharge-patient-copy">
				<text wx:if="{{patient}}" class="discharge-patient-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="discharge-muted">正在获取就诊人...</text>
				<text wx:else class="discharge-muted">暂无就诊人信息</text>
				<text wx:if="{{patient}}" class="discharge-patient-card">{{patient.cardNumberMasked}}</text>
				<text wx:if="{{patientError}}" class="discharge-error">{{patientError}}</text>
			</view>
			<text class="discharge-arrow">›</text>
		</view>

		<view class="discharge-change" bindtap="onChangePatient">
			<text>选择其他就诊人</text><text class="discharge-arrow">›</text>
		</view>

		<view class="discharge-list">
			<view wx:if="{{loading}}" class="discharge-empty">加载中...</view>
			<view wx:elif="{{!hasCompletedVisit}}" class="discharge-empty">
				<text>暂无记录</text>
				<text class="discharge-empty-note">完成住院/就诊记录后，可在这里查看对应随访表单。</text>
			</view>
			<block wx:else>
				<view wx:for="{{followupItems}}" wx:key="tableName" class="discharge-row">
					<text class="discharge-row-title">{{item.title}}</text>
					<button class="discharge-view" data-title="{{item.title}}" data-table-name="{{item.tableName}}" bindtap="onFollowupTap">查看</button>
				</view>
			</block>
		</view>

		<view wx:if="{{message}}" class="discharge-message">{{message}}</view>
		<text class="discharge-note">页面入口和八类随访表单名称已按旧服务迁移；详情表单及提交接口待当前临床 contract 开放。</text>
		<button class="discharge-back" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
