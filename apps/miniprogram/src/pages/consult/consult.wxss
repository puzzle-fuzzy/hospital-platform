page {
	height: 100%;
	overflow: hidden;
	background: #ebeffc;
}

.consult-page {
	box-sizing: border-box;
	min-height: 100%;
	padding: 24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
}

.consult-intro,
.consult-patient-card,
.consult-state {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.consult-intro {
	padding: 28rpx 30rpx;
	border-radius: 20rpx;
	background: #eaeffd;
	color: #3d6df6;
}

.consult-intro-title,
.consult-intro-copy,
.consult-patient-name,
.consult-patient-id,
.consult-state-title,
.consult-state-hint {
	display: block;
}

.consult-intro-title {
	font-size: 34rpx;
	font-weight: 700;
}

.consult-intro-copy {
	margin-top: 12rpx;
	font-size: 25rpx;
	line-height: 1.6;
}

.consult-patient-card {
	display: flex;
	align-items: center;
	margin-top: 20rpx;
	padding: 24rpx;
	border-radius: 20rpx;
	background: linear-gradient(135deg, #3d6df6, #5f9bff);
	color: #ffffff;
}

.consult-patient-icon {
	width: 72rpx;
	height: 72rpx;
	padding: 10rpx;
	border-radius: 12rpx;
	background: #ffffff;
}

.consult-patient-copy {
	min-width: 0;
	margin-left: 18rpx;
}

.consult-patient-name {
	max-width: 310rpx;
	overflow: hidden;
	font-size: 30rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.consult-patient-id {
	margin-top: 8rpx;
	font-size: 23rpx;
	opacity: 0.82;
}

.consult-patient-switch {
	width: 170rpx;
	margin: 0 0 0 auto;
	padding: 0;
	border: 1rpx solid rgba(255, 255, 255, 0.8);
	border-radius: 999rpx;
	background: transparent;
	color: #ffffff;
	font-size: 24rpx;
	line-height: 62rpx;
}

.consult-tabs {
	display: flex;
	align-items: center;
	justify-content: space-around;
	width: 710rpx;
	height: 96rpx;
	margin: 20rpx auto 0;
	border-radius: 20rpx 20rpx 0 0;
	background: #ffffff;
}

.consult-tab {
	box-sizing: border-box;
	height: 96rpx;
	padding: 0 22rpx;
	border-bottom: 4rpx solid transparent;
	color: #666666;
	font-size: 28rpx;
	line-height: 96rpx;
}

.consult-tab-active {
	border-bottom-color: #3d6df6;
	color: #3d6df6;
	font-weight: 700;
}

.consult-state {
	display: flex;
	/*
		状态卡片中的插图、标题和说明必须按旧端的纵向空态排列；如果遗漏
		flex-direction，微信默认使用 row，会把三段内容挤在同一行，导致
		“正在获取就诊信息”和“暂无记录”在窄屏上错位。这里固定居中，
		同时保持 query-state-shell 的稳定高度，避免状态切换时布局跳变。
	*/
	align-items: center;
	justify-content: center;
	flex-direction: column;
	height: 380rpx;
	min-height: 380rpx;
	margin-top: 2rpx;
	padding: 40rpx 30rpx;
	border-radius: 0 0 20rpx 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
	text-align: center;
}

.consult-record-list {
	box-sizing: border-box;
	width: 710rpx;
	margin: 20rpx auto 0;
}

.consult-record-card {
	box-sizing: border-box;
	margin-bottom: 18rpx;
	padding: 26rpx 28rpx;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 4rpx 16rpx rgba(35, 55, 95, 0.05);
}

.consult-record-header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 18rpx;
}

.consult-record-title-wrap {
	min-width: 0;
}

.consult-record-department,
.consult-record-caption,
.consult-record-label,
.consult-record-date,
.consult-record-time,
.consult-record-number,
.consult-record-footnote {
	display: block;
}

.consult-record-department {
	overflow: hidden;
	color: #1f2937;
	font-size: 30rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.consult-record-caption {
	margin-top: 5rpx;
	color: #9aa4b2;
	font-size: 22rpx;
}

.consult-record-status {
	flex: 0 0 auto;
	padding: 7rpx 14rpx;
	border-radius: 8rpx;
	background: #f5f5f5;
	color: #666666;
	font-size: 23rpx;
}

.consult-record-status.record-status-scheduled {
	background: #edf3ff;
	color: #3d6df6;
}

.consult-record-meta {
	display: flex;
	flex-wrap: wrap;
	gap: 8rpx 22rpx;
	margin-top: 18rpx;
	color: #6b7280;
	font-size: 23rpx;
}

.consult-record-schedule {
	margin-top: 20rpx;
	padding-top: 18rpx;
	border-top: 1rpx solid #f0f0f0;
}

.consult-record-label {
	color: #8995aa;
	font-size: 22rpx;
}

.consult-record-date {
	margin-top: 7rpx;
	color: #333333;
	font-size: 28rpx;
	font-weight: 600;
}

.consult-record-time {
	margin-top: 6rpx;
	color: #4c4c4c;
	font-size: 25rpx;
}

.consult-record-number {
	margin-top: 14rpx;
	color: #4b5563;
	font-size: 23rpx;
}

.consult-record-footnote {
	padding: 4rpx 6rpx 12rpx;
	color: #a0a7b4;
	font-size: 22rpx;
	line-height: 1.5;
	text-align: center;
}

.consult-record-load-more {
	box-sizing: border-box;
	margin: 4rpx 0 18rpx;
	padding: 20rpx;
	border-radius: 14rpx;
	background: #ffffff;
	color: #3d6df6;
	font-size: 25rpx;
	line-height: 1.4;
	text-align: center;
}

.consult-state image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.consult-state-hint {
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.consult-retry {
	width: 220rpx;
	margin-top: 24rpx;
	border-radius: 999rpx;
	background: #3d6df6;
	color: #ffffff;
	font-size: 25rpx;
}
