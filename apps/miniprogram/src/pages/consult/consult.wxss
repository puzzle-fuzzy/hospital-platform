page {
	height: 100%;
	overflow: hidden;
	background: #ebeffc;
}

.consult-page {
	box-sizing: border-box;
	min-height: 100%;
	padding: 24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
}

.consult-intro,
.consult-patient-card,
.consult-state {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.consult-intro {
	padding: 28rpx 30rpx;
	border-radius: 20rpx;
	background: #eaeffd;
	color: #3d6df6;
}

.consult-intro-title,
.consult-intro-copy,
.consult-patient-name,
.consult-patient-id,
.consult-state-title,
.consult-state-hint {
	display: block;
}

.consult-intro-title {
	font-size: 34rpx;
	font-weight: 700;
}

.consult-intro-copy {
	margin-top: 12rpx;
	font-size: 25rpx;
	line-height: 1.6;
}

.consult-patient-card {
	display: flex;
	align-items: center;
	margin-top: 20rpx;
	padding: 24rpx;
	border-radius: 20rpx;
	background: linear-gradient(135deg, #3d6df6, #5f9bff);
	color: #ffffff;
}

.consult-patient-icon {
	width: 72rpx;
	height: 72rpx;
	padding: 10rpx;
	border-radius: 12rpx;
	background: #ffffff;
}

.consult-patient-copy {
	min-width: 0;
	margin-left: 18rpx;
}

.consult-patient-name {
	max-width: 310rpx;
	overflow: hidden;
	font-size: 30rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.consult-patient-id {
	margin-top: 8rpx;
	font-size: 23rpx;
	opacity: 0.82;
}

.consult-patient-switch {
	width: 170rpx;
	margin: 0 0 0 auto;
	padding: 0;
	border: 1rpx solid rgba(255, 255, 255, 0.8);
	border-radius: 999rpx;
	background: transparent;
	color: #ffffff;
	font-size: 24rpx;
	line-height: 62rpx;
}

.consult-tabs {
	display: flex;
	align-items: center;
	justify-content: space-around;
	width: 710rpx;
	height: 96rpx;
	margin: 20rpx auto 0;
	border-radius: 20rpx 20rpx 0 0;
	background: #ffffff;
}

.consult-tab {
	box-sizing: border-box;
	height: 96rpx;
	padding: 0 22rpx;
	border-bottom: 4rpx solid transparent;
	color: #666666;
	font-size: 28rpx;
	line-height: 96rpx;
}

.consult-tab-active {
	border-bottom-color: #3d6df6;
	color: #3d6df6;
	font-weight: 700;
}

.consult-state {
	display: flex;
	height: 380rpx;
	min-height: 380rpx;
	margin-top: 2rpx;
	padding: 40rpx 30rpx;
	border-radius: 0 0 20rpx 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.consult-state image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.consult-state-hint {
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.consult-retry {
	width: 220rpx;
	margin-top: 24rpx;
	border-radius: 999rpx;
	background: #3d6df6;
	color: #ffffff;
	font-size: 25rpx;
}
