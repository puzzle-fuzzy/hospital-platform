
<scroll-view class="tab-page-scroll" scroll-y="true" enhanced="true">
	<view class="consult-page">
		<view class="consult-intro">
			<text class="consult-intro-title">智能陪诊</text>
			<text class="consult-intro-copy">就诊引导、排队叫号、缴费、查报告和取药进度将在独立 contract 完成后接入。</text>
		</view>

		<view class="consult-patient-card">
			<image class="consult-patient-icon" src="/assets/legacy-home/patient-qr.svg" mode="aspectFit" />
			<view class="consult-patient-copy">
				<text class="consult-patient-name">{{selectedPatientName}}</text>
				<text class="consult-patient-id">{{selectedPatientIdLabel}}</text>
			</view>
			<button class="consult-patient-switch" bindtap="onChangePatient">切换就诊人</button>
		</view>

		<view class="consult-tabs">
			<view wx:for="{{tabs}}" wx:key="id" class="consult-tab {{activeTab === item.id ? 'consult-tab-active' : ''}}" data-tab="{{item.id}}" bindtap="onTabTap">
				<text>{{item.title}}</text>
			</view>
		</view>

		<view wx:if="{{!visibleRecords.length}}" class="consult-state query-state-shell query-state-shell-column">
			<block wx:if="{{loading}}">
				<text class="consult-state-title">正在获取就诊信息...</text>
				<text class="consult-state-hint">页面结构已准备好，请稍候</text>
			</block>
			<block wx:elif="{{error}}">
				<text class="consult-state-title">{{error}}</text>
				<button class="consult-retry" bindtap="onRetry">重新查询</button>
			</block>
			<block wx:else>
				<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
				<text class="consult-state-title">{{activeTab === 'today' ? '今日暂无预约摘要' : activeTab === 'upcoming' ? '暂无未来就诊记录' : '暂无历史就诊记录'}}</text>
				<text class="consult-state-hint">{{activeTab === 'today' ? '当前没有已确认的今日预约；实时就诊 contract 尚未完成，不会猜测叫号或排队状态' : '当前仅展示预约摘要，不包含实时叫号或队列状态'}}</text>
			</block>
		</view>

		<view wx:if="{{!loading && !error && visibleRecords.length}}" class="consult-record-list">
			<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="consult-record-card">
				<view class="consult-record-header">
					<view class="consult-record-title-wrap">
						<text class="consult-record-department">{{item.departmentName || "门诊挂号"}}</text>
						<text class="consult-record-caption">预约摘要</text>
					</view>
					<text class="consult-record-status {{item.statusClass}}">{{item.statusLabel}}</text>
				</view>
				<view wx:if="{{item.doctorName || item.location}}" class="consult-record-meta">
					<text wx:if="{{item.doctorName}}">医生：{{item.doctorName}}</text>
					<text wx:if="{{item.location}}">地点：{{item.location}}</text>
				</view>
				<view class="consult-record-schedule">
					<text class="consult-record-label">就诊日期</text>
					<text class="consult-record-date">{{item.workDate}}<text wx:if="{{item.periodLabel}}"> {{item.periodLabel}}</text></text>
					<text wx:if="{{item.workTime}}" class="consult-record-time">{{item.workTime}}</text>
				</view>
				<text wx:if="{{item.serialNumber}}" class="consult-record-number">就诊序号：{{item.serialNumber}}</text>
			</view>
			<view wx:if="{{hasMoreRecords}}" class="consult-record-load-more" bindtap="onLoadMore">加载更多就诊记录</view>
			<text class="consult-record-footnote">记录来自预约只读服务；实时就诊状态将在独立 contract 完成后接入。</text>
		</view>
	</view>
</scroll-view>
