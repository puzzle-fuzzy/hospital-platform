<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<!-- 错误区域固定在页面最上方，网络异常时用户无需滚动查找原因。 -->
	<view wx:if="{{error}}" class="clinical-query-error-message">{{error}}</view>

	<!-- 旧端 PatientHospitalSelector 的两行布局；患者切换仍进入平台选择页。 -->
	<view class="selector-card">
		<view class="selector-row selector-row-border" bindtap="onChangePatient">
			<text class="selector-label">就诊人</text>
			<view class="selector-value">
				<text wx:if="{{selectedPatient}}" class="selector-name">{{selectedPatient.displayName}}</text>
				<!--
					目录和预约记录是两个连续的异步读阶段。loading 期间尚未形成
					当前患者事实，不能把临时的 null 显示成“请先选择就诊人”；
					只有本轮读取结束且没有患者时，才进入真正的选择状态。
				-->
				<text wx:elif="{{loading}}" class="selector-name">正在加载就诊人...</text>
				<text wx:elif="{{canSelectPatient}}" class="selector-name">请先选择就诊人</text>
				<!-- 服务异常时患者上下文被安全清空，但不能把故障伪装成未选患者。 -->
				<text wx:else class="selector-name">当前就诊人信息暂不可用</text>
				<!-- 旧端在姓名后显示括号编号；新端只放服务端生成的脱敏卡号，不能恢复 Provider 患者号。 -->
				<text wx:if="{{selectedPatient}}" class="selector-card-number">（{{selectedPatient.cardNumberMasked}}）</text>
				<!-- 原版使用灰色 arrow-right 图标，不能用字符箭头导致字形和垂直位置漂移。 -->
				<image
					class="selector-arrow-image"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
				/>
			</view>
		</view>
		<!--
			旧端院区行有右侧箭头并可打开选择面板。当前服务端只确认一个院区，
			所以保留真实存在的单项面板，不把未知院区或 provider 参数伪造成可选项。
		-->
		<view class="selector-row" bindtap="onHospitalTap">
			<text class="selector-label">当前院区</text>
			<view class="selector-value">
				<text>{{hospitalName}}</text>
				<image
					class="selector-arrow-image"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
				/>
			</view>
		</view>
	</view>

	<!-- 保留旧端双标签布局；两个标签分别触发服务端已确认的只读查询范围。 -->
	<view class="status-tabs">
		<view
			class="status-tab {{activeTab === 'online' ? 'status-tab-active' : ''}}"
			bindtap="onTabTap"
			data-tab="online"
		>
			<text>在线挂号</text>
			<view wx:if="{{activeTab === 'online'}}" class="status-tab-indicator"></view>
		</view>
		<view
			class="status-tab {{activeTab === 'all' ? 'status-tab-active' : ''}}"
			bindtap="onTabTap"
			data-tab="all"
		>
			<text>全部挂号</text>
			<view wx:if="{{activeTab === 'all'}}" class="status-tab-indicator"></view>
		</view>
	</view>

	<!--
		旧端使用底部弹层选择院区。新端暂时只有受控的单院区，所以弹层只展示
		高平市人民医院并允许关闭；未来取得院区 contract 后，只替换这里的数据来源。
	-->
	<view wx:if="{{showHospitalModal}}" class="hospital-mask" catchtap="closeHospitalModal">
		<view class="hospital-sheet" catchtap="stopHospitalPropagation">
			<view class="hospital-sheet-title">选择院区</view>
			<view class="hospital-option" bindtap="onHospitalSelect">
				<text>{{hospitalName}}</text>
				<text class="hospital-option-check">✓</text>
			</view>
		</view>
	</view>

	<!--
		状态外壳在“加载中→空列表”之间保持同一个 WXML 节点。
		即使公共高度已经固定，也不能让两个不同节点交替挂载；微信渲染层
		会重新计算图片和文字布局，外壳复用后页面滚动位置更稳定。
	-->
	<view class="record-list">
		<view wx:if="{{queryState !== 'ready'}}" class="clinical-query-state query-state-shell query-state-shell-column">
		<block wx:if="{{queryState === 'loading'}}">
			<view class="clinical-query-loading-icon" aria-hidden="true"></view>
			<text class="clinical-query-state-title">正在查询记录...</text>
		</block>
		<block wx:elif="{{queryState === 'error'}}">
			<view class="clinical-query-error-icon" aria-hidden="true">!</view>
			<text class="clinical-query-state-title">挂号记录暂时无法获取</text>
			<text class="clinical-query-state-hint">请稍后再试</text>
			<view class="clinical-query-state-action" bindtap="onRetry">再试一次</view>
			<view
				wx:if="{{canSelectPatient}}"
				class="clinical-query-state-action"
				bindtap="onChangePatient"
			>选择就诊人</view>
		</block>
		<block wx:else>
			<image
				class="clinical-query-state-image"
				src="/assets/legacy-user/empty-record.svg"
				mode="aspectFit"
			/>
			<text class="clinical-query-state-title">未查询到您的记录</text>
			<text wx:if="{{selectedPatient}}" class="clinical-query-state-hint">如果要查询其他就诊人，请点击上方更换</text>
			<view wx:else class="clinical-query-state-action" bindtap="onChangePatient">选择就诊人</view>
		</block>
		</view>

		<view wx:elif="{{visibleRecords.length}}" class="record-items">
		<view
			wx:for="{{visibleRecords}}"
			wx:key="viewKey"
			class="record-card"
			bindtap="onRecordTap"
			data-view-key="{{item.viewKey}}"
		>
			<!--
				卡片恢复旧端的阅读顺序：科室/状态 → 医生与院区 → 日期时段 →
				号序 → 操作。业务类型不再占一整行，减少装饰性信息，把视觉焦点
				留给患者真正需要确认的就诊时间和当前状态。
			-->
			<view class="record-card-header">
				<view class="record-card-title-wrap">
					<text class="record-department">{{item.departmentName || "门诊挂号"}}</text>
					<text class="record-card-caption">预约挂号</text>
				</view>
				<view class="record-status-badge {{item.statusClass}}">
					<!-- 原版已预约状态使用蓝色业务图标，其余状态继续显示服务端归一化文案。 -->
					<image
						wx:if="{{item.status === 'scheduled'}}"
						class="record-status-icon"
						src="/assets/legacy-user/appointment-status.svg"
						mode="aspectFit"
					/>
					<text wx:else>{{item.statusLabel}}</text>
				</view>
			</view>

			<view wx:if="{{item.doctorName || item.location}}" class="record-meta">
				<view wx:if="{{item.doctorName}}" class="record-meta-item">
					<text class="record-meta-label">医生</text>
					<text class="record-meta-value">{{item.doctorName}}</text>
				</view>
				<view wx:if="{{item.location}}" class="record-meta-item">
					<text class="record-meta-label">院区</text>
					<text class="record-meta-value">{{item.location}}</text>
				</view>
			</view>

			<!-- 日期、时段和时刻放进同一块浅色信息区，减少卡片内的视觉跳跃。 -->
			<view class="record-schedule">
				<view class="record-schedule-item">
					<text class="record-schedule-label">就诊日期</text>
					<text class="record-date">
						{{item.workDate}}<text wx:if="{{item.periodLabel}}"> {{item.periodLabel}}</text>
					</text>
				</view>
				<view wx:if="{{item.workTime}}" class="record-schedule-item record-schedule-time">
					<text class="record-schedule-label">就诊时段</text>
					<text class="record-time">{{item.workTime}}</text>
				</view>
			</view>
			<view wx:if="{{item.serialNumber}}" class="record-number">
				<text wx:if="{{item.serialNumber}}">第 </text>
				<text wx:if="{{item.serialNumber}}" class="record-number-emphasis">{{item.serialNumber}}</text>
				<text wx:if="{{item.serialNumber}}"> 号</text>
			</view>

			<!-- 未取消记录保留旧端操作区；未迁移的预问诊只显示安全提示。 -->
			<view
				wx:if="{{item.status !== 'cancelled'}}"
				class="record-actions"
				catchtap="stopRecordActionPropagation"
			>
				<button
					class="record-action-button"
					bindtap="onPreVisit"
					data-view-key="{{item.viewKey}}"
					plain="true"
				>预问诊</button>
				<button
					class="record-action-button"
					bindtap="onHospitalGuide"
					data-view-key="{{item.viewKey}}"
					plain="true"
				>院内导航</button>
			</view>
		</view>
		<view wx:if="{{hasMoreRecords}}" class="load-more" bindtap="onLoadMore">加载更多挂号记录</view>
		</view>
	</view>

	<!--
		旧端挂号卡点击后会进入详情；当前公开 contract 只有安全摘要，没有稳定的
		预约详情引用，因此点击时由 onRecordTap 明确提示“详情暂未开放”。取消、
		退号和支付仍保持关闭，不能把卡片索引当作业务主键。
	-->

	<!-- 旧端院内导航弹窗：只展示静态科室位置，不伪造实时路线。 -->
	<view wx:if="{{showLocationModal}}" class="location-mask" catchtap="closeLocationModal">
		<view class="location-popup" catchtap="stopLocationPropagation">
			<view class="location-popup-header">
				<text>科室位置信息</text>
				<!-- 父层需要阻止冒泡，但关闭按钮必须显式绑定，否则 catchtap 会吞掉关闭动作。 -->
				<image
					class="location-close"
					src="/assets/legacy-user/location-close.svg"
					mode="aspectFit"
					bindtap="closeLocationModal"
				/>
			</view>
			<scroll-view wx:if="{{locationResults.length}}" class="location-scroll" scroll-y="true">
				<view wx:for="{{locationResults}}" wx:key="department" class="location-item">
					<view class="location-dot"></view>
					<view class="location-copy">
						<text class="location-department">{{item.department}}</text>
						<text class="location-text">{{item.location}}</text>
					</view>
				</view>
			</scroll-view>
			<view wx:else class="location-empty">
				<image
					class="location-empty-icon"
					src="/assets/legacy-user/location-search.svg"
					mode="aspectFit"
				/>
				<text>未找到相关科室位置信息</text>
			</view>
		</view>
	</view>

</view>
</scroll-view>
