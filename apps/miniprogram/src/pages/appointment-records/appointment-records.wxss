page {
	background: #f8f8f8;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 0 0 calc(40rpx + env(safe-area-inset-bottom));
	background: #f8f8f8;
}

.error-message,
.selector-card,
.status-tabs,
.record-list,
.state-card {
	box-sizing: border-box;
	margin-right: auto;
	margin-left: auto;
	width: 100%;
}

.error-message {
	margin-bottom: 20rpx;
	padding: 20rpx 40rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

/* 旧端 PatientHospitalSelector：白色卡片、两行、分割线和右侧箭头。 */
.selector-card {
	overflow: hidden;
	background: #ffffff;
}

.selector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	padding: 26rpx 30rpx;
	color: #333333;
}

.selector-row-border {
	border-bottom: 1rpx solid #f0f0f0;
}

.selector-label {
	flex: 0 0 150rpx;
	font-size: 28rpx;
}

.selector-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
	color: #333333;
	font-size: 30rpx;
	text-align: right;
}

/*
	旧端选择器把患者资料压在右侧单行区域内；新端展示的是脱敏卡号，
	仍必须为长姓名保留箭头和卡号的可见空间，不能让医疗上下文把布局撑破。
*/
.selector-name {
	overflow: hidden;
	min-width: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.selector-card-number {
	margin-left: 10rpx;
	color: #999999;
	font-size: 23rpx;
}

.selector-arrow {
	margin-left: 14rpx;
	color: #9ca3af;
	font-size: 42rpx;
	font-weight: 300;
	line-height: 0.8;
}

/* 旧端院区行使用 arrow-right 图标；与患者行共用右侧对齐和点击热区。 */
.selector-arrow-image {
	display: block;
	margin-left: 14rpx;
	width: 30rpx;
	height: 30rpx;
}

/* 旧端两个状态标签共用一行，当前项使用医疗蓝和底部短线。 */
.status-tabs {
	display: flex;
	/* 旧端选择区与状态标签连续相接，不额外插入新端间距。 */
	background: #ffffff;
}

.status-tab {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 50%;
	/* 旧端使用 py-4（上下各 16px）+ 32rpx 文本，换算后约 112rpx。 */
	height: 112rpx;
	color: #666666;
	font-size: 30rpx;
}

.status-tab-active {
	color: #3d6df6;
	font-weight: 500;
}

.status-tab-indicator {
	position: absolute;
	bottom: 0;
	left: 50%;
	width: 64rpx;
	height: 4rpx;
	transform: translateX(-50%);
	border-radius: 4rpx;
	background: #3d6df6;
}

.record-list {
	/* 旧端使用 pb-20，即 80px/160rpx；挂号页没有底部导航但仍保留原版底部节奏。 */
	padding: 32rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
	background: #f5f5f5;
}

.record-card {
	position: relative;
	box-sizing: border-box;
	margin-bottom: 32rpx;
	padding: 32rpx;
	border-radius: 16rpx;
	background: #ffffff;
	box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
	transition: transform 0.3s ease;
}

/* 旧端卡片点击会短暂缩小；只反馈触摸，不代表详情或任何写入操作成功。 */
.record-card:active {
	transform: scale(0.98);
}

.record-status-badge {
	position: absolute;
	top: 24rpx;
	right: 24rpx;
	padding: 8rpx 16rpx;
	border-radius: 8rpx;
	font-size: 24rpx;
	line-height: 1.2;
}

.record-status-icon {
	display: block;
	width: 48rpx;
	height: 48rpx;
}

.record-status-badge.record-status-scheduled {
	padding: 0;
	background: transparent;
}

/* 旧端除“已预约”图标外，其他状态统一使用灰色小标签。 */
.record-status-registered,
.record-status-substituted,
.record-status-completed,
.record-status-cancelled,
.record-status-missed,
.record-status-stopped,
.record-status-unknown {
	background: #f5f5f5;
	color: #666666;
}

.record-department {
	padding-right: 96rpx;
	color: #1f2937;
	font-size: 32rpx;
	font-weight: 700;
	line-height: 1.45;
}

.record-meta {
	display: flex;
	flex-wrap: wrap;
	/* 对齐旧端详情区的 mb-3，医生类型和院区不能贴住科室标题。 */
	margin-top: 24rpx;
	color: #4b5563;
	font-size: 24rpx;
	line-height: 1.6;
}

.record-meta text + text {
	margin-left: 16rpx;
}

.record-date {
	/* 旧端日期区使用 mb-4 的 32rpx 节奏。 */
	margin-top: 32rpx;
	color: #1f2937;
	font-size: 24rpx;
	line-height: 1.5;
}

.record-number {
	margin-top: 32rpx;
	color: #4b5563;
	font-size: 24rpx;
	line-height: 1.5;
}

.record-number-emphasis {
	color: #ee875e;
	font-size: 28rpx;
	font-weight: 600;
}

.record-actions {
	display: flex;
	justify-content: flex-end;
	/* 与旧端按钮区域 mt-4 保持一致，避免卡片底部显得拥挤。 */
	margin-top: 32rpx;
}

.record-action-button {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	margin: 0 0 0 12rpx;
	padding: 0;
	width: 120rpx;
	height: 60rpx;
	border: 1rpx solid #e5e5e5;
	border-radius: 30rpx;
	background: #ffffff;
	color: #000000;
	font-size: 24rpx;
	line-height: 60rpx;
}

.record-action-button:active {
	background: #f7f8fb;
}

.load-more {
	box-sizing: border-box;
	margin: 4rpx auto 20rpx;
	padding: 22rpx;
	border-radius: 14rpx;
	background: #ffffff;
	color: #3d6df6;
	font-size: 26rpx;
	line-height: 1.4;
	text-align: center;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	margin-top: 0;
	padding: 80rpx 32rpx;
	border-radius: 0;
	background: #f5f5f5;
	color: #777777;
	font-size: 28rpx;
}

.state-card-empty {
	flex-direction: column;
}

.state-card-loading {
	flex-direction: column;
}

/* 旧端使用 loading 图标；原生端用纯 WXSS 复刻同样的中性旋转指示器。 */
.state-loading-icon {
	box-sizing: border-box;
	margin-bottom: 24rpx;
	width: 48rpx;
	height: 48rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #9ca3af;
	border-radius: 50%;
	animation: appointment-record-loading 900ms linear infinite;
}

@keyframes appointment-record-loading {
	to {
		transform: rotate(360deg);
	}
}

.state-empty-icon {
	display: block;
	margin-bottom: 20rpx;
	width: 48rpx;
	height: 48rpx;
}

.state-hint {
	display: block;
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 24rpx;
}

.state-hint-action {
	color: #3d6df6;
	text-decoration: underline;
}

/* 复刻旧端居中弹窗，并限制滚动区域避免科室资料过多撑满页面。 */
.location-mask {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 50;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(0, 0, 0, 0.45);
}

.location-popup {
	overflow: hidden;
	width: 600rpx;
	max-width: 80vw;
	border-radius: 24rpx;
	background: #ffffff;
	box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.location-popup-header {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	padding: 30rpx 32rpx;
	border-bottom: 1rpx solid #f0f0f0;
	background: #f8f9ff;
	color: #333333;
	font-size: 32rpx;
	font-weight: 600;
}

.location-close {
	position: absolute;
	right: 28rpx;
	top: 22rpx;
	color: #666666;
	font-size: 48rpx;
	font-weight: 300;
	line-height: 1;
}

.location-scroll {
	box-sizing: border-box;
	max-height: 60vh;
}

.location-item {
	display: flex;
	align-items: flex-start;
	box-sizing: border-box;
	padding: 24rpx 32rpx;
	border-bottom: 1rpx solid #f5f5f5;
}

.location-dot {
	flex: 0 0 8rpx;
	margin-top: 12rpx;
	margin-right: 16rpx;
	width: 8rpx;
	height: 8rpx;
	border-radius: 50%;
	background: #3d6df6;
}

.location-copy {
	display: flex;
	min-width: 0;
	flex-direction: column;
}

.location-department {
	color: #333333;
	font-size: 28rpx;
	font-weight: 600;
	line-height: 1.6;
}

.location-text {
	margin-top: 8rpx;
	color: #666666;
	font-size: 24rpx;
	line-height: 1.6;
}

.location-empty {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	padding: 80rpx 32rpx;
	color: #999999;
	flex-direction: column;
	font-size: 28rpx;
}

.location-empty-icon {
	margin-bottom: 24rpx;
	color: #cccccc;
	font-size: 80rpx;
	line-height: 1;
}

/*
	旧端院区选择使用底部弹层。当前只有一个受控院区，面板仍保留旧端的
	宽度、圆角和选中反馈；未来接入动态院区时只替换 option 数据。
*/
.hospital-mask {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 60;
	display: flex;
	align-items: flex-end;
	justify-content: center;
	padding-bottom: env(safe-area-inset-bottom);
	background: rgba(0, 0, 0, 0.45);
}

.hospital-sheet {
	box-sizing: border-box;
	margin-bottom: 20rpx;
	width: 92vw;
	overflow: hidden;
	border-radius: 16rpx;
	background: #ffffff;
}

.hospital-sheet-title {
	box-sizing: border-box;
	padding: 20rpx 24rpx;
	border-bottom: 1rpx solid #f0f0f0;
	color: #333333;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 1.4;
}

.hospital-option {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	padding: 28rpx 24rpx;
	border-bottom: 1rpx solid #f5f5f5;
	color: #333333;
	font-size: 30rpx;
	line-height: 1.4;
}

.hospital-option-check {
	color: #3d6df6;
	font-size: 36rpx;
	font-weight: 600;
}
