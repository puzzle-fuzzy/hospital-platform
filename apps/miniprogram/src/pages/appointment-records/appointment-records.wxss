page {
	background: #f5f5f5;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.error-message,
.patient-strip,
.page-header,
.record-list,
.state-card,
.readonly-note {
	box-sizing: border-box;
	margin-right: auto;
	margin-left: auto;
	width: 710rpx;
}

.error-message {
	margin-bottom: 20rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

.patient-strip {
	display: flex;
	align-items: center;
	padding: 18rpx 22rpx;
	border: 1rpx solid #dbe5ff;
	border-radius: 18rpx;
	background: #f2f6ff;
}

.patient-strip image {
	flex-shrink: 0;
	width: 56rpx;
	height: 56rpx;
}

.patient-strip-copy {
	display: flex;
	flex-direction: column;
	gap: 5rpx;
	min-width: 0;
	margin-left: 18rpx;
}

.patient-strip-name {
	overflow: hidden;
	color: #222222;
	font-size: 30rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.patient-strip-card {
	color: #777777;
	font-size: 23rpx;
}

.patient-strip-change {
	margin-left: auto;
	padding-left: 20rpx;
	color: #3d6df6;
	font-size: 25rpx;
	white-space: nowrap;
}

.page-header {
	margin-top: 26rpx;
	margin-bottom: 20rpx;
}

.page-title {
	color: #222222;
	font-size: 38rpx;
	font-weight: 700;
	line-height: 1.5;
}

.page-description {
	margin-top: 8rpx;
	color: #888888;
	font-size: 26rpx;
	line-height: 1.6;
}

.record-card {
	box-sizing: border-box;
	margin-bottom: 18rpx;
	padding: 26rpx;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(61, 109, 246, 0.06);
}

.record-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.record-date {
	color: #3d6df6;
	font-size: 29rpx;
	font-weight: 700;
}

.record-status {
	padding: 6rpx 12rpx;
	border-radius: 8rpx;
	font-size: 24rpx;
}

.record-status-scheduled {
	background: #f2f6ff;
	color: #3d6df6;
}

.record-status-completed {
	background: #effaf1;
	color: #16a34a;
}

.record-status-cancelled,
.record-status-missed {
	background: #fff1f1;
	color: #d2443c;
}

.record-status-unknown {
	background: #f5f5f5;
	color: #888888;
}

.record-department {
	margin-top: 18rpx;
	color: #222222;
	font-size: 31rpx;
	font-weight: 700;
}

.record-line,
.record-number {
	margin-top: 12rpx;
	color: #666666;
	font-size: 26rpx;
	line-height: 1.5;
}

.record-number {
	color: #999999;
	font-size: 23rpx;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	margin-top: 80rpx;
	padding: 44rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.state-card-empty {
	flex-direction: column;
}

.state-card-empty image {
	display: block;
	margin-bottom: 20rpx;
	width: 220rpx;
}

.state-hint {
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 24rpx;
}

.readonly-note {
	margin-top: 30rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff7ee;
	color: #d56d2a;
	font-size: 24rpx;
	line-height: 1.6;
}
