<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<view wx:if="{{selectedPatient}}" class="patient-strip" bindtap="onChangePatient">
		<image src="/assets/legacy-home/service-patient.svg" mode="aspectFit" />
		<view class="patient-copy">
			<text class="patient-name">{{selectedPatient.displayName}}</text>
			<text class="patient-card">{{selectedPatient.cardNumberMasked}}</text>
		</view>
		<text class="patient-change">更换就诊人</text>
	</view>
	<view class="page-header">
		<view class="page-title">报告查询</view>
		<view class="page-description">按就诊人、日期和报告类型查询院内报告</view>
	</view>

	<view class="query-panel">
		<view class="query-row">
			<text class="query-label">报告日期</text>
			<view class="date-range">
				<picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStartDateChange">
					<view class="date-picker">{{startDate}}</view>
				</picker>
				<text class="date-separator">至</text>
				<picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{today}}" bindchange="onEndDateChange">
					<view class="date-picker">{{endDate}}</view>
				</picker>
			</view>
		</view>
		<view class="query-row query-row-types">
			<text class="query-label">报告类型</text>
			<scroll-view class="kind-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
				<view class="kind-options">
					<view class="kind-option {{activeKind === 'all' ? 'kind-option-active' : ''}}" data-kind="all" bindtap="onKindChange">全部</view>
					<view class="kind-option {{activeKind === 'laboratory' ? 'kind-option-active' : ''}}" data-kind="laboratory" bindtap="onKindChange">检验</view>
					<view class="kind-option {{activeKind === 'imaging' ? 'kind-option-active' : ''}}" data-kind="imaging" bindtap="onKindChange">影像</view>
					<view class="kind-option {{activeKind === 'ecg' ? 'kind-option-active' : ''}}" data-kind="ecg" bindtap="onKindChange">心电</view>
					<view class="kind-option {{activeKind === 'peis' ? 'kind-option-active' : ''}}" data-kind="peis" bindtap="onKindChange">体检</view>
				</view>
			</scroll-view>
		</view>
		<view class="query-summary">
			<text wx:if="{{!loading && !error}}">共查询到 {{filteredReportCount}} 份{{activeKind === 'all' ? '' : '当前类型'}}报告</text>
			<text wx:else>查询条件已保留，可调整后重新查询</text>
		</view>
	</view>

	<!--
		状态外壳在加载、错误和合法空目录之间复用。固定高度只能解决尺寸
		问题，复用同一个节点还可以避免图片重新挂载引起的滚动位置抖动。
	-->
	<view
		wx:if="{{loading || error || !visibleReports.length}}"
		class="state-card query-state-shell query-state-shell-column"
	>
		<block wx:if="{{loading}}">
			<view class="state-loading-icon" aria-hidden="true"></view>
			<text>正在加载报告目录...</text>
		</block>
		<block wx:elif="{{error}}">
			<view class="state-error-mark">!</view>
			<text class="state-error-title">报告暂时未能加载</text>
			<text class="state-error-message">{{error}}</text>
			<view class="state-hint state-hint-action" bindtap="onRetry">再试一次</view>
			<view
				wx:if="{{canSelectPatient}}"
				class="state-hint state-hint-action"
				bindtap="onChangePatient"
			>选择就诊人</view>
		</block>
		<block wx:else>
			<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
			<text wx:if="{{selectedPatient && reportCount > 0}}">当前报告类型下没有记录</text>
			<text wx:elif="{{selectedPatient}}">所选日期内未查询到报告</text>
			<text wx:else>请先选择就诊人</text>
			<text wx:if="{{selectedPatient}}" class="state-hint">如需查询其他就诊人，请点击上方更换</text>
			<view wx:else class="state-hint state-hint-action" bindtap="onChangePatient">点击这里选择就诊人</view>
		</block>
	</view>

	<view wx:elif="{{visibleReports.length}}" class="report-list">
		<view
			wx:for="{{visibleReports}}"
			wx:key="viewKey"
			class="report-card {{item.reportId ? 'report-card-clickable' : ''}}"
			bindtap="onReportTap"
			data-view-key="{{item.viewKey}}"
		>
			<view class="report-card-header">
				<view class="report-title-wrap">
					<text class="report-title">{{item.title}}</text>
					<text class="report-kind">{{item.kindLabel}}</text>
				</view>
				<text class="report-status report-status-{{item.status}}">{{item.statusLabel}}</text>
			</view>
			<view class="report-meta">
				<text>报告时间：{{item.reportedAt}}</text>
				<text wx:if="{{item.hasAttachment}}">含附件</text>
			</view>
			<view wx:if="{{item.reportId}}" class="report-hint">查看安全详情</view>
			<view wx:else class="report-hint">该报告暂无可查看详情</view>
		</view>

		<view wx:if="{{hasMoreReports}}" class="load-more" bindtap="onLoadMore">加载更多报告</view>
	</view>

</view>
</scroll-view>
