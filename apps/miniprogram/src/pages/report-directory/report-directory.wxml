<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view wx:if="{{selectedPatient}}" class="patient-strip" bindtap="onChangePatient">
		<image src="/assets/legacy-home/service-patient.svg" mode="aspectFit" />
		<view class="patient-copy">
			<text class="patient-name">{{selectedPatient.displayName}}</text>
			<text class="patient-card">{{selectedPatient.cardNumberMasked}}</text>
		</view>
		<text class="patient-change">更换就诊人</text>
	</view>
	<!--
		报告查询要先完成 owner、患者和报告目录三段读取，加载期间 selectedPatient
		必然暂时为空。这里保留与真实患者条带相同的高度，但不提供点击入口，
		避免报告目录成功后突然插入患者卡片，把下面的提示和状态卡整体推移。
	-->
	<view wx:elif="{{loading}}" class="patient-strip patient-strip-loading" aria-hidden="true">
		<view class="patient-strip-loading-icon"></view>
		<view class="patient-strip-loading-copy">
			<view class="patient-strip-loading-line patient-strip-loading-line-name"></view>
			<view class="patient-strip-loading-line patient-strip-loading-line-card"></view>
		</view>
	</view>

	<view class="notice">仅展示已接入的检验、影像和心电报告摘要；详情需由服务端生成安全引用后开放。</view>

	<view class="page-header">
		<view class="page-title">报告查询</view>
		<view wx:if="{{reportCount > 0}}" class="page-description">近 30 天共 {{reportCount}} 份报告</view>
	</view>

	<!--
		状态外壳在加载、错误和合法空目录之间复用。固定高度只能解决尺寸
		问题，复用同一个节点还可以避免图片重新挂载引起的滚动位置抖动。
	-->
	<view
		wx:if="{{loading || error || !visibleReports.length}}"
		class="state-card query-state-shell query-state-shell-column"
	>
		<block wx:if="{{loading}}">
			<view class="state-loading-icon" aria-hidden="true"></view>
			<text>正在加载报告目录...</text>
		</block>
		<block wx:elif="{{error}}">
			<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
			<text>本次报告目录未加载成功</text>
			<text class="state-hint">请根据上方提示处理后重试</text>
			<view class="state-hint state-hint-action" bindtap="onRetry">重新加载</view>
			<view
				wx:if="{{canSelectPatient}}"
				class="state-hint state-hint-action"
				bindtap="onChangePatient"
			>选择就诊人</view>
		</block>
		<block wx:else>
			<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
			<text wx:if="{{selectedPatient}}">未查询到相关报告</text>
			<text wx:else>请先选择就诊人</text>
			<text wx:if="{{selectedPatient}}" class="state-hint">如需查询其他就诊人，请点击上方更换</text>
			<view wx:else class="state-hint state-hint-action" bindtap="onChangePatient">点击这里选择就诊人</view>
		</block>
	</view>

	<view wx:elif="{{visibleReports.length}}" class="report-list">
		<view
			wx:for="{{visibleReports}}"
			wx:key="viewKey"
			class="report-card {{item.reportId ? 'report-card-clickable' : ''}}"
			bindtap="onReportTap"
			data-view-key="{{item.viewKey}}"
		>
			<view class="report-card-header">
				<view class="report-title-wrap">
					<text class="report-title">{{item.title}}</text>
					<text class="report-kind">{{item.kindLabel}}</text>
				</view>
				<text class="report-status report-status-{{item.status}}">{{item.statusLabel}}</text>
			</view>
			<view class="report-meta">
				<text>报告时间：{{item.reportedAt}}</text>
				<text wx:if="{{item.hasAttachment}}">含附件</text>
			</view>
			<view wx:if="{{item.reportId}}" class="report-hint">查看安全详情</view>
			<view wx:else class="report-hint">详情引用暂未开放</view>
		</view>

		<view wx:if="{{hasMoreReports}}" class="load-more" bindtap="onLoadMore">加载更多报告</view>
	</view>

</view>
</scroll-view>
