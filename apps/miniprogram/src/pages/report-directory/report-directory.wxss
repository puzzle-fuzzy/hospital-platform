page {
	background: #f5f5f5;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.report-notice,
.selector-card,
.query-panel,
.report-list,
.state-card {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}
.report-notice {
	margin-bottom: 0;
	padding: 26rpx 30rpx;
	border-radius: 16rpx 16rpx 0 0;
	background: #fff8ee;
	color: #e58b63;
	font-size: 29rpx;
	line-height: 1.65;
}

.selector-card {
	overflow: hidden;
	margin-bottom: 20rpx;
	border-radius: 0 0 16rpx 16rpx;
	background: #ffffff;
}

.selector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	padding: 26rpx 30rpx;
	color: #333333;
}

.selector-label {
	flex: 0 0 150rpx;
	font-size: 28rpx;
}

.selector-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
	color: #333333;
	font-size: 30rpx;
	text-align: right;
}

.selector-name {
	overflow: hidden;
	min-width: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.selector-card-number {
	margin-left: 10rpx;
	color: #999999;
	font-size: 23rpx;
}

.selector-arrow-image {
	display: block;
	margin-left: 14rpx;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
}

.query-panel {
	margin-bottom: 22rpx;
	padding: 24rpx;
	border: 1rpx solid #edf1f7;
	border-radius: 20rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(61, 109, 246, 0.05);
}

.query-row {
	display: flex;
	align-items: center;
	min-height: 64rpx;
}

.query-row-types {
	align-items: flex-start;
	margin-top: 20rpx;
}

.query-label {
	flex: 0 0 124rpx;
	padding-top: 10rpx;
	color: #555555;
	font-size: 25rpx;
	font-weight: 600;
}

.date-range {
	display: flex;
	align-items: center;
	gap: 12rpx;
}

.date-picker {
	padding: 12rpx 18rpx;
	border-radius: 12rpx;
	background: #f5f7fb;
	color: #333333;
	font-size: 24rpx;
}

.date-separator {
	color: #999999;
	font-size: 24rpx;
}

.kind-scroll {
	width: 526rpx;
	white-space: nowrap;
}

.kind-options {
	display: inline-flex;
	gap: 12rpx;
	padding: 2rpx 0;
}

.kind-option {
	padding: 10rpx 22rpx;
	border: 1rpx solid #e4e9f2;
	border-radius: 24rpx;
	background: #f8f9fc;
	color: #666666;
	font-size: 24rpx;
}

.kind-option-active {
	border-color: #3d6df6;
	background: #eef3ff;
	color: #2f5fe5;
	font-weight: 600;
}

.query-summary {
	margin-top: 20rpx;
	padding-top: 18rpx;
	border-top: 1rpx solid #f0f2f6;
	color: #8a93a3;
	font-size: 23rpx;
}

.report-card {
	box-sizing: border-box;
	margin-bottom: 18rpx;
	padding: 26rpx;
	border: 1rpx solid #f0f0f0;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(61, 109, 246, 0.06);
}

.report-card-clickable:active {
	opacity: 0.78;
}

.report-card-header {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 16rpx;
}

.report-title-wrap {
	display: flex;
	flex: 1;
	min-width: 0;
	flex-direction: column;
	gap: 10rpx;
}

.report-title {
	overflow: hidden;
	color: #333333;
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1.4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.report-kind {
	color: #999999;
	font-size: 24rpx;
}

.report-status {
	flex-shrink: 0;
	padding: 6rpx 12rpx;
	border-radius: 8rpx;
	font-size: 24rpx;
}

.report-status-available {
	background: #effaf1;
	color: #16a34a;
}

.report-status-abnormal {
	background: #fff1f1;
	color: #d2443c;
}

.report-meta {
	display: flex;
	align-items: center;
	gap: 20rpx;
	margin-top: 18rpx;
	color: #666666;
	font-size: 25rpx;
}

.report-hint {
	margin-top: 18rpx;
	padding-top: 16rpx;
	border-top: 1rpx solid #f5f5f5;
	color: #3d6df6;
	font-size: 24rpx;
}

.report-card:not(.report-card-clickable) .report-hint {
	color: #aaaaaa;
}

.load-more {
	box-sizing: border-box;
	margin: 4rpx auto 20rpx;
	padding: 20rpx;
	border-radius: 14rpx;
	background: #ffffff;
	color: #3d6df6;
	font-size: 26rpx;
	text-align: center;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	/* 报告读取状态与费用/预约页保持同高，避免空目录替换 loading 时跳动。 */
	height: 380rpx;
	min-height: 380rpx;
	margin-top: 22rpx;
	padding: 40rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.state-error-mark {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 66rpx;
	height: 66rpx;
	margin-bottom: 16rpx;
	border-radius: 50%;
	background: #fff0f0;
	color: #d2443c;
	font-size: 34rpx;
	font-weight: 700;
}

.state-error-title {
	color: #333333;
	font-size: 28rpx;
	font-weight: 600;
}

.state-error-message {
	margin-top: 10rpx;
	color: #888888;
	font-size: 24rpx;
	line-height: 1.5;
	text-align: center;
}

.state-card-empty {
	flex-direction: column;
}

.state-card image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.state-card-loading {
	flex-direction: column;
}

.state-loading-icon {
	box-sizing: border-box;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 20rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #9ca3af;
	border-radius: 50%;
	animation: report-directory-loading 900ms linear infinite;
}

@keyframes report-directory-loading {
	to {
		transform: rotate(360deg);
	}
}

.state-hint {
	display: block;
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 24rpx;
}

.state-hint-action {
	color: #3d6df6;
	text-decoration: underline;
}
