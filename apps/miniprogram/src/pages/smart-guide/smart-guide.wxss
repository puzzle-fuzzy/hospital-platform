page {
	height: 100%;
	overflow: hidden;
	background: #ffffff;
}

.smart-guide-page {
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
	background: #ffffff;
}

.smart-guide-scroll {
	box-sizing: border-box;
	height: 100%;
	background: #ffffff;
}

.guide-hero {
	position: relative;
	box-sizing: border-box;
	height: 400rpx;
	overflow: hidden;
	background: linear-gradient(180deg, #a8ddff 0%, #c7eaff 45%, #eef8ff 76%, #ffffff 100%);
}

.guide-hero__copy {
	position: absolute;
	left: 46rpx;
	top: 54rpx;
	z-index: 1;
}

.guide-hero__greeting,
.guide-hero__subtitle {
	display: block;
	color: #145292;
	font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.guide-hero__greeting {
	font-size: 34rpx;
	line-height: 48rpx;
}

.guide-hero__subtitle {
	margin-top: 18rpx;
	font-size: 26rpx;
	line-height: 38rpx;
}

.guide-hero__doctor {
	position: absolute;
	top: 32rpx;
	right: 30rpx;
	display: block;
	width: 176rpx;
	height: 176rpx;
}

.guide-messages {
	box-sizing: border-box;
	margin-top: -106rpx;
	padding-bottom: 18rpx;
}

.guide-message-spacer {
	height: 106rpx;
}

.guide-message {
	display: flex;
	box-sizing: border-box;
	margin-bottom: 36rpx;
	padding-right: 30rpx;
	padding-left: 30rpx;
}

.guide-message--assistant {
	flex-direction: column;
	align-items: stretch;
}

.guide-message--user {
	justify-content: flex-end;
	padding-left: 90rpx;
}

.guide-bubble {
	box-sizing: border-box;
	max-width: 100%;
	border-radius: 15rpx;
	font-size: 30rpx;
	line-height: 48rpx;
	word-break: break-all;
}

.guide-message--assistant .guide-bubble {
	width: 100%;
	padding: 22rpx 30rpx;
	background: #eaf2fd;
	color: #333333;
}

.guide-message--user .guide-bubble {
	display: inline-block;
	padding: 15rpx 30rpx;
	background: #2f73f2;
	color: #ffffff;
}

.guide-bubble--pending {
	color: #a5b4c8;
}

.guide-summary {
	margin-top: 18rpx;
	color: #c4ccd8;
	font-size: 24rpx;
	line-height: 36rpx;
}

.guide-disclaimer {
	margin-top: 12rpx;
	color: #c4ccd8;
	font-size: 24rpx;
	line-height: 36rpx;
}

.guide-advice {
	box-sizing: border-box;
	width: 100%;
	margin-top: -10rpx;
	color: #333333;
	font-size: 26rpx;
	line-height: 42rpx;
}

.guide-departments {
	box-sizing: border-box;
	width: 100%;
	margin-top: 18rpx;
	padding: 22rpx 30rpx;
	border-radius: 15rpx;
	background: #eaf2fd;
}

.guide-department {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: space-between;
	width: 100%;
	height: 68rpx;
	margin: 0 0 14rpx;
	padding: 0 18rpx 0 26rpx;
	border: 0;
	border-radius: 34rpx;
	background: #ffffff;
	color: #3f80f5;
	font-size: 25rpx;
	line-height: 68rpx;
}

.guide-department:last-child {
	margin-bottom: 0;
}

.guide-department::after,
.guide-send::after,
.guide-tool::after {
	border: 0;
}

.guide-department__name {
	min-width: 0;
	overflow: hidden;
	text-align: left;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.guide-department__action {
	box-sizing: border-box;
	flex-shrink: 0;
	height: 52rpx;
	margin-left: 18rpx;
	padding: 0 20rpx;
	border-radius: 26rpx;
	background: #2f73f2;
	color: #ffffff;
	font-size: 24rpx;
	line-height: 52rpx;
}

.guide-bottom-space {
	height: 190rpx;
}

.guide-composer {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 10;
	display: flex;
	box-sizing: border-box;
	align-items: center;
	gap: 18rpx;
	min-height: 128rpx;
	padding: 26rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
	background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, #def7ff 100%);
}

.guide-tool {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: center;
	width: 64rpx;
	height: 64rpx;
	flex: 0 0 64rpx;
	margin: 0;
	padding: 0;
	border-radius: 50%;
	background: #ffffff;
}

.guide-tool--recording {
	background: #fff0f0;
}

.guide-tool[disabled] {
	opacity: 0.76;
}

.guide-tool__icon {
	display: block;
	width: 38rpx;
	height: 38rpx;
}

.guide-tool__label {
	position: absolute;
	left: 26rpx;
	color: #c83f3f;
	font-size: 20rpx;
	line-height: 1;
	white-space: nowrap;
}

.guide-input {
	box-sizing: border-box;
	width: auto;
	height: 66rpx;
	min-width: 0;
	flex: 1;
	padding: 12rpx 22rpx;
	border: 2rpx solid #a066e5;
	border-radius: 34rpx;
	background: #ffffff;
	color: #333333;
	font-size: 25rpx;
	line-height: 40rpx;
}

.guide-send {
	box-sizing: border-box;
	width: 116rpx;
	min-width: 116rpx;
	height: 76rpx;
	flex: 0 0 116rpx;
	margin: 0;
	padding: 0;
	border-radius: 15rpx;
	background: #2f73f2;
	color: #ffffff;
	font-size: 28rpx;
	line-height: 76rpx;
}

.guide-send[disabled] {
	background: #9fbdf7;
	color: #ffffff;
}
