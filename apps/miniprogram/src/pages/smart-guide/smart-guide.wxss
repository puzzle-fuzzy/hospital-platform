page {
	height: 100%;
	overflow: hidden;
	background: #ffffff;
}

.smart-guide-page {
	position: relative;
	width: 100%;
	height: 100%;
	overflow: hidden;
	background: #ffffff;
}

.smart-guide-scroll {
	box-sizing: border-box;
	height: 100%;
	background: #ffffff;
}

.guide-hero {
	position: relative;
	box-sizing: border-box;
	height: 400rpx;
	overflow: hidden;
	background: linear-gradient(180deg, #a8ddff 0%, #c7eaff 45%, #eef8ff 76%, #ffffff 100%);
}

.guide-hero__copy {
	position: absolute;
	left: 46rpx;
	top: 54rpx;
	z-index: 1;
}

.guide-hero__greeting,
.guide-hero__subtitle {
	display: block;
	color: #145292;
	font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.guide-hero__greeting {
	font-size: 34rpx;
	line-height: 48rpx;
}

.guide-hero__subtitle {
	margin-top: 18rpx;
	font-size: 26rpx;
	line-height: 38rpx;
}

.guide-hero__doctor {
	position: absolute;
	top: 32rpx;
	right: 30rpx;
	display: block;
	width: 176rpx;
	height: 176rpx;
}

.guide-messages {
	box-sizing: border-box;
	margin-top: -106rpx;
	padding-bottom: 18rpx;
}

.guide-message-spacer {
	height: 106rpx;
}

.guide-message {
	display: flex;
	box-sizing: border-box;
	align-items: flex-start;
	gap: 16rpx;
	margin-bottom: 28rpx;
	padding-right: 30rpx;
	padding-left: 30rpx;
}

.guide-message--assistant {
	flex-direction: row;
}

.guide-message--user {
	justify-content: flex-end;
	padding-left: 90rpx;
}

.guide-message__avatar {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: center;
	width: 56rpx;
	height: 56rpx;
	flex: 0 0 56rpx;
	margin-top: 4rpx;
	border-radius: 50%;
	background: #e8f5ff;
}

.guide-message__avatar image {
	display: block;
	width: 52rpx;
	height: 52rpx;
}

.guide-message__body {
	min-width: 0;
	max-width: 100%;
}

.guide-message--assistant .guide-message__body {
	flex: 1;
}

.guide-message--user .guide-message__body {
	max-width: 82%;
}

.guide-bubble {
	box-sizing: border-box;
	max-width: 100%;
	border: 1rpx solid transparent;
	border-radius: 14rpx 24rpx 24rpx 24rpx;
	font-size: 29rpx;
	line-height: 44rpx;
	word-break: break-word;
}

.guide-message--assistant .guide-bubble {
	padding: 22rpx 26rpx;
	border-color: #e3edf8;
	background: #f4f8fe;
	box-shadow: 0 8rpx 22rpx rgba(68, 111, 158, 0.08);
	color: #26364a;
}

.guide-message--user .guide-bubble {
	display: block;
	padding: 16rpx 24rpx;
	border-radius: 24rpx 8rpx 24rpx 24rpx;
	background: #2f73f2;
	box-shadow: 0 8rpx 18rpx rgba(47, 115, 242, 0.18);
	color: #ffffff;
}

.guide-bubble--error {
	border-color: #ffe0c8;
	background: #fff8f2;
	box-shadow: 0 8rpx 22rpx rgba(195, 119, 67, 0.08);
	color: #4a3b31;
}

.guide-bubble--pending {
	color: #a5b4c8;
}

.guide-bubble__heading {
	margin-bottom: 6rpx;
	color: #c46b38;
	font-size: 22rpx;
	font-weight: 600;
	line-height: 32rpx;
}

.guide-message__content {
	display: block;
	word-break: break-word;
}

.guide-bubble__code {
	display: block;
	margin-top: 12rpx;
	padding-top: 10rpx;
	border-top: 1rpx solid #f1d4bd;
	color: #b47754;
	font-size: 22rpx;
	line-height: 32rpx;
}

.guide-summary {
	margin-top: 18rpx;
	color: #64748b;
	font-size: 24rpx;
	line-height: 36rpx;
}

.guide-disclaimer {
	margin-top: 12rpx;
	color: #64748b;
	font-size: 24rpx;
	line-height: 36rpx;
}

.guide-advice {
	box-sizing: border-box;
	width: 100%;
	margin-top: 14rpx;
	padding: 0 6rpx;
	color: #333333;
	font-size: 26rpx;
	line-height: 42rpx;
}

.guide-departments {
	box-sizing: border-box;
	width: 100%;
	margin-top: 16rpx;
	padding: 18rpx 20rpx;
	border: 1rpx solid #e3edf8;
	border-radius: 16rpx;
	background: #f4f8fe;
}

.guide-department {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: space-between;
	width: 100%;
	height: 68rpx;
	margin: 0 0 14rpx;
	padding: 0 18rpx 0 26rpx;
	border: 0;
	border-radius: 34rpx;
	background: #ffffff;
	color: #3f80f5;
	font-size: 25rpx;
	line-height: 68rpx;
}

.guide-department:last-child {
	margin-bottom: 0;
}

.guide-department::after,
.guide-send::after,
.guide-tool::after {
	border: 0;
}

.guide-department__name {
	min-width: 0;
	overflow: hidden;
	text-align: left;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.guide-department__action {
	box-sizing: border-box;
	flex-shrink: 0;
	height: 52rpx;
	margin-left: 18rpx;
	padding: 0 20rpx;
	border-radius: 26rpx;
	background: #2f73f2;
	color: #ffffff;
	font-size: 24rpx;
	line-height: 52rpx;
}

.guide-bottom-space {
	height: 190rpx;
}

.guide-composer {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 10;
	display: flex;
	box-sizing: border-box;
	align-items: center;
	gap: 18rpx;
	min-height: 124rpx;
	padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
	background: linear-gradient(180deg, #e9faff 0%, #d8f4ff 100%);
}

.guide-tool {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: center;
	width: 76rpx;
	height: 76rpx;
	flex: 0 0 76rpx;
	margin: 0;
	padding: 0;
	border-radius: 50%;
	background: #ffffff;
	line-height: 1;
	box-shadow: 0 6rpx 18rpx rgba(71, 139, 172, 0.1);
}

.guide-tool--recording {
	background: #fff0f0;
}

.guide-tool[disabled] {
	opacity: 1;
}

.guide-tool--image .guide-tool__icon {
	opacity: 0.58;
}

.guide-tool__icon {
	display: block;
	width: 38rpx;
	height: 38rpx;
}

.guide-tool__label {
	position: absolute;
	left: 26rpx;
	color: #c83f3f;
	font-size: 20rpx;
	line-height: 1;
	white-space: nowrap;
}

.guide-input {
	box-sizing: border-box;
	width: auto;
	height: 76rpx;
	min-width: 0;
	flex: 1;
	display: block;
	padding: 14rpx 24rpx;
	border: 4rpx solid #943df2;
	border-radius: 38rpx;
	background: #ffffff;
	color: #333333;
	font-size: 28rpx;
	line-height: 40rpx;
}

.guide-input__placeholder {
	color: #6f7078;
	opacity: 1;
}

.guide-send {
	box-sizing: border-box;
	width: 116rpx;
	min-width: 116rpx;
	height: 76rpx;
	flex: 0 0 116rpx;
	margin: 0;
	padding: 0;
	border-radius: 15rpx;
	background: #2f73f2;
	color: #ffffff;
	font-size: 30rpx;
	line-height: 76rpx;
}

.guide-send[disabled] {
	background: #9fbdf7;
	color: #ffffff;
}
