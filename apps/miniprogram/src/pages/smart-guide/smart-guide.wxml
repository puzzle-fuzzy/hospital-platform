<view class="smart-guide-page" style="bottom: {{keyboardHeight}}px;">
	<scroll-view
		class="smart-guide-scroll secondary-page-scroll"
		scroll-y="true"
		enhanced="true"
		scroll-into-view="{{scrollIntoView}}"
	>
		<view class="guide-hero">
			<view class="guide-hero__copy">
				<text class="guide-hero__greeting">Hi,亲爱的用户</text>
				<text class="guide-hero__subtitle">就医助手为您服务~</text>
			</view>
			<image class="guide-hero__doctor" src="/assets/legacy-user/doctor.svg" mode="aspectFit"></image>
		</view>

		<view class="guide-messages">
			<view wx:if="{{messages.length === 0}}" class="guide-message-spacer"></view>
			<view
				wx:for="{{messages}}"
				wx:key="id"
				id="{{item.id}}"
				class="guide-message guide-message--{{item.role}}"
			>
				<view class="guide-message__avatar" wx:if="{{item.role === 'assistant'}}">
					<image src="/assets/legacy-user/doctor.svg" mode="aspectFit"></image>
				</view>
				<view class="guide-message__body">
					<view class="guide-bubble {{item.pending ? 'guide-bubble--pending' : ''}} {{item.isError ? 'guide-bubble--error' : ''}}">
						<view class="guide-bubble__heading" wx:if="{{item.isError}}">服务提示</view>
						<text class="guide-message__content" user-select="true">{{item.content}}</text>
						<text class="guide-bubble__code" wx:if="{{item.errorCode}}">错误码 {{item.errorCode}}</text>
						<view class="guide-summary" wx:if="{{item.summary && item.summary !== item.content}}">{{item.summary}}</view>
						<view class="guide-disclaimer" wx:if="{{item.showDisclaimer}}">{{disclaimer}}</view>
					</view>
					<view class="guide-advice" wx:if="{{item.advice}}">{{item.advice}}</view>
					<view class="guide-departments" wx:if="{{item.departments.length > 0}}">
						<button
							wx:for="{{item.departments}}"
							wx:for-item="department"
							wx:key="departmentId"
							class="guide-department"
							data-department-id="{{department.departmentId}}"
							data-display-name="{{department.displayName}}"
							bindtap="onDepartmentTap"
						>
							<text class="guide-department__name">{{department.displayName}}</text>
							<text class="guide-department__action">去挂号</text>
						</button>
					</view>
					<view
						class="guide-doctors"
						wx:if="{{item.doctorsLoading || item.doctors.length > 0}}"
					>
						<view class="guide-doctors__title">
							<text>{{item.doctorsDepartmentName}}坐诊医生，可直接选医生挂号</text>
						</view>
						<view wx:if="{{item.doctorsLoading}}" class="guide-doctors__loading">
							<text>正在获取医生排班…</text>
						</view>
						<button
							wx:for="{{item.doctors}}"
							wx:for-item="doctor"
							wx:key="doctorId"
							class="guide-doctor"
							data-department-id="{{item.doctorsDepartmentId}}"
							data-department-name="{{item.doctorsDepartmentName}}"
							data-doctor-id="{{doctor.doctorId}}"
							data-doctor-name="{{doctor.doctorName}}"
							bindtap="onDoctorTap"
						>
							<text class="guide-doctor__name">{{doctor.doctorName}}</text>
							<text class="guide-doctor__slots">{{doctor.availableSlots > 0 ? '余号 ' + doctor.availableSlots : '约满/待放号'}}</text>
						</button>
					</view>
				</view>
			</view>
		</view>
		<view id="guide-message-end" class="guide-message-end"></view>
	</scroll-view>

	<view class="guide-composer {{keyboardHeight > 0 ? 'guide-composer--keyboard' : ''}}">
		<button
			plain="true"
			class="guide-tool guide-voice {{recording ? 'guide-tool--recording' : ''}}"
			disabled="{{sending}}"
			bindtouchstart="onVoiceTouchStart"
			bindtouchend="onVoiceTouchEnd"
			bindtouchcancel="onVoiceTouchEnd"
		>
			<image class="guide-tool__icon" src="/assets/legacy-user/microphone.svg" mode="aspectFit"></image>
			<text class="guide-tool__label" wx:if="{{recording}}">松开发送</text>
		</button>
		<button plain="true" class="guide-tool guide-tool--image" disabled="true">
			<image class="guide-tool__icon" src="/assets/legacy-user/image.svg" mode="aspectFit"></image>
		</button>
		<view class="guide-input">
			<input
				class="guide-input__control"
				type="text"
				value="{{inputValue}}"
				maxlength="50"
				placeholder="请描述症状"
				placeholder-class="guide-input__placeholder"
				confirm-type="send"
				confirm-hold="{{true}}"
				adjust-position="{{false}}"
				hold-keyboard="{{true}}"
				bindinput="onInput"
				bindfocus="onInputFocus"
				bindkeyboardheightchange="onKeyboardHeightChange"
				bindconfirm="onSend"
			/>
		</view>
		<button class="guide-send" disabled="{{sending}}" bindtap="onSend">{{sending ? '分析中' : '发送'}}</button>
	</view>
</view>
