<scroll-view class="blood-appointment-scroll" scroll-y="true" enhanced="true">
	<view class="blood-appointment-page">
		<view wx:if="{{error}}" class="blood-appointment-error">
			<text>{{error}}</text>
			<button class="blood-appointment-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="blood-appointment-patient" bindtap="onOpenPatientSelector">
			<view class="blood-appointment-patient-copy">
				<text class="blood-appointment-label">就诊人</text>
				<view wx:if="{{patient}}" class="blood-appointment-patient-title">
					<text class="blood-appointment-patient-name">{{patient.displayName}}</text>
					<text class="blood-appointment-patient-relation">{{patient.relationshipLabel}}</text>
				</view>
				<text wx:elif="{{loading}}" class="blood-appointment-patient-name blood-appointment-muted">正在获取就诊人…</text>
				<text wx:else class="blood-appointment-patient-name blood-appointment-muted">请选择就诊人</text>
			</view>
			<image
				class="blood-appointment-arrow"
				src="/assets/legacy-user/selector-arrow-right.svg"
				mode="aspectFit"
				aria-hidden="true"
			/>
		</view>

		<!-- 旧端这里是院区选择器，但没有院区接口；保留位置和视觉层级，明确关闭动态选择。 -->
		<view class="blood-appointment-location">
			<view class="blood-appointment-location-icon">⌖</view>
			<view class="blood-appointment-location-copy">
				<text class="blood-appointment-location-title">采血院区</text>
				<text class="blood-appointment-location-value">院区信息正在准备</text>
			</view>
			<text class="blood-appointment-location-state">暂未开放</text>
		</view>

		<view class="blood-appointment-empty-card">
			<view class="blood-appointment-empty-content">
				<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
				<text class="blood-appointment-empty-title">采血预约服务正在完善中</text>
				<text class="blood-appointment-empty-note">当前暂时无法使用，请稍后再试</text>
			</view>
		</view>

		<button class="blood-appointment-status-button" bindtap="onOpenMigrationStatus">了解服务进度</button>
		<button class="blood-appointment-back-button" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
