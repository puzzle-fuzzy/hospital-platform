page {
	background: var(--hospital-canvas);
}

.appointment-schedule-scroll {
	height: 100vh;
	background: var(--hospital-canvas);
}

.appointment-schedule-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
	background: var(--hospital-canvas);
}

/* 蓝狐 375px 基准：两个页签与短蓝色下划线使用同一条白色工具栏。 */
.appointment-mode-tabs {
	position: relative;
	display: flex;
	box-sizing: border-box;
	height: 96rpx;
	border-bottom: 1rpx solid #ededed;
	background: #ffffff;
}

.appointment-mode-tab {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 1;
	box-sizing: border-box;
	padding-bottom: 2rpx;
	color: #272727;
	font-size: 30rpx;
	line-height: 1;
}

.appointment-mode-tab-active {
	color: var(--hospital-primary);
	font-weight: 600;
}

.appointment-mode-indicator {
	position: absolute;
	bottom: 0;
	width: 144rpx;
	height: 5rpx;
	border-radius: 999rpx;
	background: var(--hospital-primary);
	transition: transform 180ms ease-out;
}

.appointment-mode-indicator-doctor {
	left: calc(25% - 72rpx);
}

.appointment-mode-indicator-date {
	left: calc(25% - 72rpx);
	transform: translateX(375rpx);
}

.schedule-query-state {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-height: 470rpx;
	padding: 48rpx 60rpx;
	color: var(--hospital-subtle);
	font-size: 27rpx;
	line-height: 1.55;
	text-align: center;
	flex-direction: column;
}

.schedule-query-state-error {
	color: #7b4a4a;
}

.schedule-query-state-empty {
	color: var(--hospital-subtle);
}

.schedule-loading-icon {
	box-sizing: border-box;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 20rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: var(--hospital-primary);
	border-radius: 50%;
	animation: appointment-schedule-loading 900ms linear infinite;
}

@keyframes appointment-schedule-loading {
	to {
		transform: rotate(360deg);
	}
}

.schedule-query-error {
	max-width: 560rpx;
}

.schedule-query-retry {
	margin-top: 20rpx;
	padding: 10rpx 30rpx;
	border-radius: 999rpx;
	background: #eaf2ff;
	color: var(--hospital-primary);
	font-size: 25rpx;
}

.schedule-query-hint {
	margin-top: 14rpx;
	color: var(--hospital-subtle);
	font-size: 23rpx;
}

/* 按医生挂号：白色圆角卡片、虚线分隔和浅灰出诊日期块。 */
.doctor-list {
	box-sizing: border-box;
	padding: 24rpx 24rpx 0;
}

.doctor-card {
	box-sizing: border-box;
	margin-bottom: 24rpx;
	padding: 24rpx;
	border-radius: 20rpx;
	background: #ffffff;
}

.doctor-card:active {
	background: #fbfcff;
}

.doctor-card-main {
	display: flex;
	align-items: flex-start;
}

/* 头像组件统一加载真人照片，并在无照片或加载失败时显示本地默认头像。 */
.doctor-avatar,
.schedule-avatar {
	display: block;
	box-sizing: border-box;
	overflow: hidden;
	border-radius: 12rpx;
	background: #f1f2f5;
}

.doctor-avatar {
	flex: 0 0 128rpx;
	width: 128rpx;
	height: 128rpx;
	margin-right: 24rpx;
}

.doctor-card-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
}

.doctor-card-heading,
.schedule-doctor-line {
	display: flex;
	align-items: center;
	min-width: 0;
}

.doctor-card-heading {
	align-items: flex-start;
	justify-content: space-between;
	gap: 12rpx;
}

.doctor-card-name-row {
	display: flex;
	align-items: baseline;
	min-width: 0;
	flex: 1;
	flex-wrap: wrap;
	gap: 4rpx 10rpx;
}

.doctor-card-name {
	overflow: hidden;
	min-width: 0;
	color: #1f1f1f;
	max-width: 100%;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.doctor-card-title {
	color: var(--hospital-subtle);
	font-size: 26rpx;
	line-height: 1.35;
	word-break: break-all;
}

.doctor-card-description {
	display: -webkit-box;
	margin-top: 12rpx;
	overflow: hidden;
	color: #666666;
	font-size: 26rpx;
	line-height: 40rpx;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
}

.doctor-availability {
	flex-shrink: 0;
	padding: 6rpx 16rpx;
	border-radius: 999rpx;
	font-size: 23rpx;
	line-height: 1.35;
}

.doctor-availability-open {
	background: var(--hospital-primary);
	color: #ffffff;
}

.doctor-availability-full {
	background: #f0f0f0;
	color: var(--hospital-subtle);
}

.doctor-card-divider {
	margin-top: 20rpx;
	border-top: 1rpx dashed #e3e3e3;
}

.doctor-date-section {
	margin-top: 18rpx;
}

.doctor-date-heading {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 12rpx;
	gap: 12rpx;
}

.doctor-date-label {
	color: var(--hospital-subtle);
	font-size: 26rpx;
	line-height: 1.4;
}

.doctor-date-summary {
	color: var(--hospital-subtle);
	font-size: 22rpx;
	line-height: 1.4;
}

.doctor-date-list {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 12rpx;
	min-width: 0;
}

.doctor-date-chip {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-height: 64rpx;
	padding: 10rpx 18rpx;
	border-radius: 12rpx;
	background: #f1f2f5;
	color: var(--hospital-text);
	font-size: 26rpx;
	line-height: 1.35;
}

.doctor-date-chip:active {
	background: #e7efff;
	color: var(--hospital-primary);
}

.doctor-more-dates {
	padding: 8rpx 12rpx;
	color: var(--hospital-subtle);
	font-size: 26rpx;
	line-height: 1;
}

.doctor-card-action {
	display: block;
	margin-top: 10rpx;
	color: var(--hospital-primary);
	font-size: 22rpx;
	line-height: 1.5;
}

/* 按日期挂号：蓝狐的两个筛选位、六日横条和列表区域。 */
.date-filter-bar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	height: 84rpx;
	padding: 0 32rpx;
	border-bottom: 1rpx solid #eeeeee;
	background: #ffffff;
	color: #2c2c2c;
	font-size: 25rpx;
}

.date-picker-trigger,
.date-filter-static {
	display: flex;
	align-items: center;
}

.date-filter-static {
	color: var(--hospital-subtle);
}

.date-filter-chevron {
	width: 12rpx;
	height: 12rpx;
	margin: -5rpx 0 0 10rpx;
	border-right: 2rpx solid #a4a4a4;
	border-bottom: 2rpx solid #a4a4a4;
	transform: rotate(45deg);
}

.selected-doctor-filter {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	margin: 18rpx 24rpx 0;
	padding: 16rpx 20rpx;
	border-radius: 10rpx;
	background: #eaf2ff;
	color: var(--hospital-primary);
	font-size: 24rpx;
	line-height: 1.35;
}

.selected-doctor-clear {
	flex-shrink: 0;
	margin-left: 16rpx;
	font-weight: 600;
}

.date-scroll {
	box-sizing: border-box;
	width: 100%;
	border-bottom: 1rpx solid #ededed;
	background: #ffffff;
	white-space: nowrap;
}

.date-list {
	display: inline-flex;
	min-width: 100%;
}

.date-item {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 125rpx;
	height: 112rpx;
	border-right: 1rpx solid #eeeeee;
	background: #ffffff;
	color: #757575;
	flex-direction: column;
}

.date-item-active {
	background: #f3f7ff;
	color: var(--hospital-primary);
}

.date-item-active::after {
	position: absolute;
	bottom: 0;
	left: 24rpx;
	right: 24rpx;
	height: 4rpx;
	border-radius: 999rpx;
	background: var(--hospital-primary);
	content: "";
}

.date-label {
	font-size: 26rpx;
	line-height: 1.3;
}

.date-weekday {
	margin-top: 9rpx;
	font-size: 23rpx;
	line-height: 1.2;
}

.date-section-title {
	box-sizing: border-box;
	padding: 26rpx 30rpx 16rpx;
	color: var(--hospital-subtle);
	font-size: 26rpx;
	line-height: 1.3;
}

.schedule-list {
	box-sizing: border-box;
	padding: 0 24rpx;
}

.schedule-item {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	min-height: 160rpx;
	margin-bottom: 16rpx;
	padding: 24rpx;
	border-radius: 16rpx;
	background: #ffffff;
}

.schedule-item:active {
	background: #fbfcff;
}

.schedule-avatar {
	flex: 0 0 96rpx;
	width: 96rpx;
	height: 96rpx;
	margin-right: 20rpx;
}

.schedule-item-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
}

.schedule-doctor {
	overflow: hidden;
	min-width: 0;
	color: #292929;
	font-size: 29rpx;
	font-weight: 600;
	line-height: 1.3;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-doctor-line {
	align-items: baseline;
	flex-wrap: wrap;
	gap: 4rpx 10rpx;
}

.schedule-doctor-title {
	color: var(--hospital-subtle);
	font-size: 24rpx;
	line-height: 1.4;
}

.schedule-info-line {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 8rpx;
	margin-top: 8rpx;
}

.schedule-shift {
	flex-shrink: 0;
	color: var(--hospital-subtle);
	font-size: 24rpx;
	line-height: 1.3;
}

.schedule-date,
.schedule-time {
	overflow: hidden;
	color: var(--hospital-subtle);
	font-size: 24rpx;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-date {
	margin-top: 10rpx;
}

.schedule-registration-class {
	display: inline-block;
	align-self: flex-start;
	max-width: 100%;
	padding: 4rpx 12rpx;
	border-radius: 8rpx;
	background: #fff0d9;
	color: #925a05;
	font-size: 22rpx;
	line-height: 1.35;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-time {
	margin-top: 4rpx;
}

.schedule-item-action {
	display: flex;
	align-items: flex-end;
	justify-content: center;
	flex: 0 0 112rpx;
	margin-left: 12rpx;
	flex-direction: column;
}

.schedule-slots {
	font-size: 22rpx;
	line-height: 1.3;
	white-space: nowrap;
}

.schedule-slots-available {
	color: #c9473f;
}

.schedule-slots-empty {
	color: var(--hospital-subtle);
}

.schedule-reserve {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 100rpx;
	height: 64rpx;
	margin-top: 10rpx;
	border-radius: 8rpx;
	font-size: 26rpx;
	line-height: 1;
}

.schedule-reserve-active {
	background: var(--hospital-primary);
	color: #ffffff;
}

.schedule-reserve-full {
	background: #efefef;
	color: var(--hospital-subtle);
}

.schedule-load-more {
	box-sizing: border-box;
	margin: 4rpx 0 22rpx;
	padding: 21rpx;
	border-radius: 12rpx;
	background: #ffffff;
	color: var(--hospital-primary);
	font-size: 25rpx;
	line-height: 1.35;
	text-align: center;
}

.schedule-readonly-note {
	padding: 22rpx 40rpx 10rpx;
	color: var(--hospital-subtle);
	font-size: 23rpx;
	line-height: 1.35;
	text-align: center;
}

@media (prefers-reduced-motion: reduce) {
	.appointment-mode-indicator {
		transition: none;
	}

	.schedule-loading-icon {
		animation: none;
	}
}
