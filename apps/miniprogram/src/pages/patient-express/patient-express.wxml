<scroll-view class="patient-express-scroll" scroll-y="true" enhanced="true">
	<view class="patient-express-page">
		<view class="patient-express-patient-card" bindtap="onOpenPatientSelector">
			<image class="patient-express-avatar" src="/assets/legacy-user/default-avatar.svg" mode="aspectFit" />
			<view class="patient-express-patient-copy">
				<text class="patient-express-patient-label">就诊人</text>
				<text wx:if="{{patient}}" class="patient-express-patient-name">{{patient.displayName}}</text>
				<text wx:elif="{{!loading}}" class="patient-express-patient-name patient-express-muted">请选择就诊人</text>
				<text wx:else class="patient-express-patient-name patient-express-muted">正在获取就诊人…</text>
			</view>
			<text class="patient-express-arrow">›</text>
		</view>

		<view wx:if="{{error}}" class="patient-express-error">
			<text>{{error}}</text>
			<button class="patient-express-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="patient-express-empty">
			<image class="patient-express-empty-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
			<text class="patient-express-empty-text">未查询到相关记录!</text>
			<text class="patient-express-empty-note">旧端当前没有接入物流记录服务</text>
		</view>

		<button class="patient-express-link" bindtap="onOpenMigrationStatus">查看物流功能迁移说明</button>
		<button class="patient-express-back" bindtap="onBackMy">返回我的</button>
	</view>
</scroll-view>
