<scroll-view class="convenience-surface-scroll" scroll-y="true" enhanced="true">
	<view class="convenience-surface-page">
		<view wx:if="{{error}}" class="convenience-surface-error">
			<text>{{error}}</text>
			<button class="convenience-surface-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="convenience-surface-patient" bindtap="onOpenPatientSelector">
			<image class="convenience-surface-avatar" src="/assets/legacy-user/default-avatar.svg" mode="aspectFit" />
			<view class="convenience-surface-patient-copy">
				<text class="convenience-surface-label">当前就诊人</text>
				<text wx:if="{{patient}}" class="convenience-surface-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="convenience-surface-name convenience-surface-muted">正在获取就诊人…</text>
				<text wx:else class="convenience-surface-name convenience-surface-muted">请选择就诊人</text>
			</view>
			<text class="convenience-surface-arrow">›</text>
		</view>

		<view class="convenience-surface-hero">
			<text class="convenience-surface-title">{{title}}</text>
			<text class="convenience-surface-subtitle">向医护人员表达感谢，公开记录功能正在迁移</text>
		</view>

		<view class="convenience-surface-card">
			<text class="convenience-surface-card-title">{{recordTitle}}</text>
			<view class="convenience-surface-empty">
				<image class="convenience-surface-empty-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
				<text class="convenience-surface-empty-title">公开记录暂未开放</text>
				<text class="convenience-surface-empty-note">{{recordNote}}</text>
			</view>
		</view>

		<view class="convenience-surface-card">
			<text class="convenience-surface-card-title">开放前还需确认</text>
			<view wx:for="{{contractItems}}" wx:key="*this" class="convenience-surface-row">
				<text class="convenience-surface-dot">·</text><text class="convenience-surface-row-text">{{item}}</text>
			</view>
			<text class="convenience-surface-coverage">{{coverageLabel}}</text>
		</view>

		<button class="convenience-surface-primary" bindtap="onOpenMigrationStatus">查看完整迁移状态</button>
		<button class="convenience-surface-plain" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
