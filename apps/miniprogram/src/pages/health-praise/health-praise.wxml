<scroll-view class="convenience-surface-scroll" scroll-y="true" enhanced="true">
	<view class="convenience-surface-page">
		<view wx:if="{{error}}" class="convenience-surface-error">
			<text>{{error}}</text><button class="convenience-surface-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="convenience-surface-patient" bindtap="onOpenPatientSelector">
			<image class="convenience-surface-avatar" src="/assets/legacy-user/default-avatar.svg" mode="aspectFit" />
			<view class="convenience-surface-patient-copy">
				<text class="convenience-surface-label">当前就诊人</text>
				<text wx:if="{{patient}}" class="convenience-surface-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="convenience-surface-name convenience-surface-muted">正在获取就诊人…</text>
				<text wx:else class="convenience-surface-name convenience-surface-muted">请选择就诊人</text>
			</view>
			<text class="convenience-surface-arrow">›</text>
		</view>

		<view class="convenience-surface-hero">
			<text class="convenience-surface-title">高平市人民医院</text>
			<text class="convenience-surface-subtitle">表扬信</text>
		</view>

		<view class="convenience-surface-card">
			<view class="convenience-surface-card-heading">
				<text class="convenience-surface-card-title">公开表扬信</text>
				<view class="convenience-surface-month"><text data-delta="prev" bindtap="onMonthChange">‹</text><text>{{monthLabel}}</text><text data-delta="next" bindtap="onMonthChange">›</text></view>
			</view>
			<view wx:if="{{recordState === 'loading'}}" class="convenience-surface-empty"><text>正在确认就诊人...</text></view>
			<view wx:elif="{{recordState === 'error'}}" class="convenience-surface-empty"><text>暂时无法展示记录</text><text class="convenience-surface-empty-note">请稍后重试</text></view>
			<view wx:elif="{{records.length}}" class="convenience-surface-record-grid">
				<view wx:for="{{records}}" wx:key="*this" class="convenience-surface-record" bindtap="onRecordTap"><text>{{item}}</text></view>
			</view>
			<view wx:else class="convenience-surface-empty">
				<image class="convenience-surface-empty-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
				<text class="convenience-surface-empty-title">暂无表扬信</text>
				<text class="convenience-surface-empty-note">公开列表服务尚未接入当前平台，本次未发起查询。</text>
			</view>
		</view>

		<view class="convenience-surface-actions">
			<button class="convenience-surface-action-secondary" data-action="{{myRecordsLabel}}" bindtap="onConvenienceAction">{{myRecordsLabel}}</button>
			<button class="convenience-surface-action-primary" data-action="{{createLabel}}" bindtap="onConvenienceAction">{{createLabel}}</button>
		</view>
		<view class="convenience-surface-card convenience-surface-help">
			<text class="convenience-surface-card-title">使用说明</text>
			<view wx:for="{{contractItems}}" wx:key="*this" class="convenience-surface-row"><text class="convenience-surface-dot">·</text><text class="convenience-surface-row-text">{{item}}</text></view>
			<text class="convenience-surface-coverage">{{coverageLabel}}</text>
		</view>
		<button class="convenience-surface-plain" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
