<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<!--
		只有 loading 或没有可信 canonical 快照时才隐藏编辑表单。
		资料读取失败通常会把 loaded 置为 false，必须先重新取得服务端
		version 和会话代际；但保存阶段的暂时网络错误会保留最近一次已确认
		快照，顶部 error-message 负责提示，表单仍然可见并可按 version 安全重试。
		不能因为 error 字符串存在就把两种业务状态混成“没有资料”。
		同一状态外壳还负责稳定 loading/未加载之间的页面高度。
	-->
	<view
		wx:if="{{loading || !loaded}}"
		class="state-card query-state-shell query-state-shell-column"
	>
		<block wx:if="{{loading}}">
			<text>正在加载个人资料...</text>
		</block>
		<block wx:elif="{{error}}">
			<text>本次个人资料未加载成功</text>
			<text class="state-hint">请根据上方提示处理后重试</text>
			<view class="state-hint state-hint-action" bindtap="onRetry">重新加载</view>
		</block>
	</view>

	<view wx:elif="{{!loading && loaded}}" class="form-card">
		<view class="form-row">
			<text class="form-label">昵称</text>
			<input
				class="form-input"
				value="{{displayName}}"
				bindinput="onDisplayNameInput"
				maxlength="64"
				placeholder="请输入昵称"
			/>
		</view>
		<view class="form-row">
			<text class="form-label">性别</text>
			<picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onGenderChange">
				<view class="picker-value">{{genderLabel}} <text class="picker-arrow">›</text></view>
			</picker>
		</view>
		<view class="form-row">
			<text class="form-label">年龄</text>
			<input
				class="form-input"
				type="number"
				value="{{age}}"
				bindinput="onAgeInput"
				maxlength="3"
				placeholder="请输入年龄"
			/>
		</view>
		<view class="form-row">
			<text class="form-label">邮箱</text>
			<input
				class="form-input"
				type="text"
				value="{{email}}"
				bindinput="onEmailInput"
				maxlength="320"
				placeholder="请输入邮箱"
			/>
		</view>
	</view>

	<view class="boundary-card">
		<text class="boundary-title">资料边界</text>
		<text class="boundary-copy">头像、手机号、真实姓名和身份证信息需要独立的安全契约，当前不会通过普通资料接口修改。</text>
	</view>

	<button wx:if="{{loaded}}" class="save-button" loading="{{saving}}" disabled="{{saving || loading || navigationPending}}" bindtap="onSave">
		{{saving ? "保存中" : "保存"}}
	</button>
</view>
</scroll-view>
