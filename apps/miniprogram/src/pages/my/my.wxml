<scroll-view class="tab-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
		<!-- 微信 WXSS 不支持可靠地读取本地 background-image；用 image 还原旧端顶部背景。 -->
		<image
			class="page-background"
			src="/assets/legacy-user/legacy-user-background.png"
			mode="widthFix"
			aria-hidden="true"
		/>

		<view class="page-content">
			<view wx:if="{{error}}" class="error-message">
				<text class="error-message-text">{{error}}</text>
				<text class="error-message-retry" bindtap="onRetry">重新加载</text>
			</view>

			<!--
				旧端头像区仍保持原布局；头像昵称授权必须由用户主动点击，
				不能在 onShow/登录时自动弹窗，也不能把“微信用户”当成真实昵称。
			-->
			<view class="profile-head">
				<image
					class="profile-avatar"
					src="{{avatarUrl || '/assets/legacy-user/default-avatar.svg'}}"
					mode="aspectFill"
					bindtap="onWechatProfileTap"
				/>
				<view class="profile-copy" bindtap="onHeaderTap">
					<!--
						昵称头像来自 App 全局资料仓库；患者目录刷新时不能把已经
						确认的昵称重新替换成“正在获取用户信息”，否则每次切 Tab
						都会出现一次错误的资料闪烁。
					-->
					<text class="profile-name">{{userLabel || "微信用户"}}</text>
					<text
						class="profile-auth-hint"
						catchtap="onWechatProfileTap"
					>
						{{wechatProfileHint || (wechatProfileState === 'ready' ? '已授权头像和昵称' : '点击获取头像和昵称')}}
					</text>
				</view>
			</view>

			<!-- 旧端家庭成员管理卡片；真实切换仍进入独立患者选择页。 -->
			<view class="family-card" bindtap="onFamilyTap">
				<text class="family-title">家庭成员管理</text>
				<image
					class="family-arrow"
					src="/assets/legacy-user/arrow-right.svg"
					mode="aspectFill"
				/>
			</view>

			<!--
				分组和图标顺序来自旧端 userNavData。每个入口仍经过 onAction，
				已迁移能力正常跳转，未完成能力只提示迁移状态，不能伪造成功。
			-->
			<view
				wx:for="{{menuSections}}"
				wx:for-item="section"
				wx:key="index"
				class="menu-section"
			>
				<text class="section-title">{{section.title}}</text>
				<view class="menu-grid">
					<!-- 未迁移入口没有 action；使用 title 作为稳定展示 key，避免多个 undefined key 让真机复用错位。 -->
					<view
						wx:for="{{section.items}}"
						wx:for-item="item"
						wx:key="title"
						class="menu-item"
						bindtap="onAction"
						data-action="{{item.action}}"
					>
						<!-- 旧端使用 aspectFill；这些 SVG 都是方形 viewBox，保留模式可避免后续资源替换时布局漂移。 -->
						<image src="{{item.icon}}" mode="aspectFill" />
						<text>{{item.title}}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</scroll-view>
