<scroll-view class="tab-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
		<!-- 微信 WXSS 不支持可靠地读取本地 background-image；用 image 还原旧端顶部背景。 -->
		<image
			class="page-background"
			src="/assets/legacy-user/legacy-user-background.png"
			mode="widthFix"
			aria-hidden="true"
		/>

		<view class="page-content">
			<view wx:if="{{error}}" class="error-message">
				<text class="error-message-text">{{error}}</text>
				<text class="error-message-retry" bindtap="onRetry">重新加载</text>
			</view>

			<!--
				旧端头像区仍保持原布局；头像昵称授权必须由用户主动点击，
				不能在 onShow/登录时自动弹窗，也不能把“微信用户”当成真实昵称。
			-->
			<view class="profile-head">
				<image
					class="profile-avatar"
					src="{{avatarUrl || '/assets/legacy-user/default-avatar.svg'}}"
					mode="aspectFill"
					bindtap="onWechatProfileTap"
				/>
				<view class="profile-copy" bindtap="onHeaderTap">
					<!--
						昵称头像来自 App 全局资料仓库；患者目录刷新时不能把已经
						确认的昵称重新替换成“正在获取用户信息”，否则每次切 Tab
						都会出现一次错误的资料闪烁。
					-->
					<text class="profile-name">{{userLabel || "微信用户"}}</text>
					<view class="profile-auth-action" catchtap="onWechatProfileTap">
						<text class="profile-auth-hint">
							{{wechatProfileHint || (wechatProfileState === 'ready' ? '头像和昵称已设置' : '点击设置头像和昵称')}}
						</text>
					</view>
				</view>
			</view>

			<!-- 旧端家庭成员管理卡片；真实切换仍进入独立患者选择页。 -->
			<view class="family-card" bindtap="onFamilyTap">
				<text class="family-title">家庭成员管理</text>
				<image
					class="family-arrow"
					src="/assets/legacy-user/arrow-right.svg"
					mode="aspectFill"
				/>
			</view>

			<!--
				分组和图标顺序来自旧端 userNavData。每个入口仍经过 onAction，
				已迁移能力正常跳转，未完成能力只提示迁移状态，不能伪造成功。
			-->
			<view
				wx:for="{{menuSections}}"
				wx:for-item="section"
				wx:key="index"
				class="menu-section"
			>
				<text class="section-title">{{section.title}}</text>
				<view class="menu-grid">
					<!-- 所有可见入口都带固定 action；title 只作为稳定展示 key，避免真机复用错位。 -->
					<view
						wx:for="{{section.items}}"
						wx:for-item="item"
						wx:key="title"
						class="menu-item"
						bindtap="onAction"
						data-action="{{item.action}}"
					>
						<!-- 旧端使用 aspectFill；这些 SVG 都是方形 viewBox，保留模式可避免后续资源替换时布局漂移。 -->
						<image src="{{item.icon}}" mode="aspectFill" />
						<text>{{item.title}}</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</scroll-view>

<!--
	微信权限设置页不提供头像昵称资料。这里使用微信当前的 chooseAvatar 与
	nickname 填写组件，由用户明确选择后再写回当前 owner 的展示资料。
-->
<view
	wx:if="{{profileEditorVisible}}"
	class="profile-editor-mask"
	catchtap="onProfileEditorCancel"
>
	<view class="profile-editor" catchtap="onProfileEditorPanelTap">
		<text class="profile-editor-title">设置头像和昵称</text>
		<text class="profile-editor-copy">请选择头像并填写昵称，保存后会立即显示在个人中心。</text>

		<button
			class="profile-editor-avatar-button"
			open-type="chooseAvatar"
			bindchooseavatar="onProfileAvatarChosen"
		>
			<image
				class="profile-editor-avatar"
				src="{{profileDraftAvatarUrl || '/assets/legacy-user/default-avatar.svg'}}"
				mode="aspectFill"
			/>
			<text>选择头像</text>
		</button>

		<input
			class="profile-editor-nickname"
			type="nickname"
			value="{{profileDraftName}}"
			maxlength="64"
			placeholder="填写昵称"
			confirm-type="done"
			bindinput="onProfileNicknameInput"
		/>

		<view class="profile-editor-actions">
			<button
				class="profile-editor-cancel"
				disabled="{{profileSaving}}"
				bindtap="onProfileEditorCancel"
			>取消</button>
			<button
				class="profile-editor-save"
				loading="{{profileSaving}}"
				disabled="{{profileSaving}}"
				bindtap="onProfileEditorSave"
			>保存并展示</button>
		</view>
	</view>
</view>
