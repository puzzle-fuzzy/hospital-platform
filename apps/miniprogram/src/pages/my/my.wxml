<view class="page">
	<!-- 微信 WXSS 不支持可靠地读取本地 background-image；用 image 还原旧端顶部背景。 -->
	<image
		class="page-background"
		src="/assets/legacy-user/legacy-user-background.png"
		mode="widthFix"
		aria-hidden="true"
	/>

	<view class="page-content">
		<view wx:if="{{error}}" class="error-message">{{error}}</view>

		<!-- 旧端头像区：点击整行进入普通资料编辑，不把头像误当作微信授权结果。 -->
		<view class="profile-head" bindtap="onHeaderTap">
			<image
				class="profile-avatar"
				src="/assets/legacy-user/default-avatar.svg"
				mode="aspectFill"
			/>
			<text class="profile-name">{{userLabel}}</text>
		</view>

		<!-- 旧端家庭成员管理卡片；真实切换仍进入独立患者选择页。 -->
		<view class="family-card" bindtap="onFamilyTap">
			<text class="family-title">家庭成员管理</text>
			<image
				class="family-arrow"
				src="/assets/legacy-user/arrow-right.svg"
				mode="aspectFill"
			/>
		</view>

		<!--
			分组和图标顺序来自旧端 userNavData。每个入口仍经过 onAction，
			已迁移能力正常跳转，未完成能力只提示迁移状态，不能伪造成功。
		-->
		<view wx:for="{{menuSections}}" wx:for-item="section" wx:key="index" class="menu-section">
			<text class="section-title">{{section.title}}</text>
			<view class="menu-grid">
				<view
					wx:for="{{section.items}}"
					wx:for-item="item"
					wx:key="action"
					class="menu-item"
					bindtap="onAction"
					data-action="{{item.action}}"
				>
					<!-- 旧端使用 aspectFill；这些 SVG 都是方形 viewBox，保留模式可避免后续资源替换时布局漂移。 -->
					<image src="{{item.icon}}" mode="aspectFill" />
					<text>{{item.title}}</text>
				</view>
			</view>
		</view>
	</view>

	<!-- 自定义底部栏固定在视口底部，并为安全区预留空间。 -->
	<view class="legacy-tabbar">
		<view
			wx:for="{{tabBarItems}}"
			wx:key="text"
			class="legacy-tabbar-item {{index === 3 ? 'legacy-tabbar-item-current' : ''}}"
			bindtap="onTabTap"
			data-index="{{index}}"
		>
			<image
				class="legacy-tabbar-icon"
				src="{{index === 3 ? item.activeIcon : item.icon}}"
				mode="aspectFit"
			/>
			<text>{{item.text}}</text>
		</view>
	</view>
</view>
