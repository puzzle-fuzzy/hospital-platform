<view class="page">
	<!-- 微信 WXSS 不支持可靠地读取本地 background-image；用 image 还原旧端顶部背景。 -->
	<image
		class="page-background"
		src="/assets/legacy-user/legacy-user-background.png"
		mode="widthFix"
		aria-hidden="true"
	/>

	<view class="page-content">
		<view wx:if="{{error}}" class="error-message">{{error}}</view>

		<!-- 旧端头像区：点击整行进入普通资料编辑，不把头像误当作微信授权结果。 -->
		<view class="profile-head" bindtap="onHeaderTap">
			<image
				class="profile-avatar"
				src="/assets/legacy-user/default-avatar.svg"
				mode="aspectFill"
			/>
			<text class="profile-name">{{userLabel}}</text>
		</view>

		<!-- 旧端家庭成员管理卡片；真实切换仍进入独立患者选择页。 -->
		<view class="family-card" bindtap="onFamilyTap">
			<text class="family-title">家庭成员管理</text>
			<image
				class="family-arrow"
				src="/assets/legacy-user/arrow-right.svg"
				mode="aspectFit"
			/>
		</view>

		<!--
			分组和图标顺序来自旧端 userNavData。每个入口仍经过 onAction，
			已迁移能力正常跳转，未完成能力只提示迁移状态，不能伪造成功。
		-->
		<view wx:for="{{menuSections}}" wx:for-item="section" wx:key="index" class="menu-section">
			<text class="section-title">{{section.title}}</text>
			<view class="menu-grid">
				<view
					wx:for="{{section.items}}"
					wx:for-item="item"
					wx:key="action"
					class="menu-item"
					bindtap="onAction"
					data-action="{{item.action}}"
				>
					<image src="{{item.icon}}" mode="aspectFit" />
					<text>{{item.title}}</text>
				</view>
			</view>
		</view>
	</view>

	<!-- 自定义底部栏固定在视口底部，并为安全区预留空间。 -->
	<view class="legacy-tabbar">
		<view class="legacy-tabbar-item" bindtap="onTabTap" data-index="0">
			<image src="/assets/legacy-home/tab-01.png" mode="aspectFit" />
			<text>医疗服务</text>
		</view>
		<view class="legacy-tabbar-item" bindtap="onTabTap" data-index="1">
			<image src="/assets/legacy-home/tab-02.png" mode="aspectFit" />
			<text>就诊</text>
		</view>
		<view class="legacy-tabbar-item" bindtap="onTabTap" data-index="2">
			<image src="/assets/legacy-home/tab-03.png" mode="aspectFit" />
			<text>互联网医院</text>
		</view>
		<view class="legacy-tabbar-item legacy-tabbar-item-current" bindtap="onTabTap" data-index="3">
			<image src="/assets/legacy-home/tab-04-active.png" mode="aspectFit" />
			<text>我的</text>
		</view>
	</view>
</view>
