page {
	background: #f8f8f8;
}

.page {
	position: relative;
	box-sizing: border-box;
	min-height: 100vh;
	padding: 1rpx 20rpx calc(150rpx + env(safe-area-inset-bottom));
	background: #f8f8f8;
}

/* 旧端 background-size: 100% 的资源尺寸是 750x566，按屏宽等比显示，避免 aspectFill 裁切两侧。 */
.page-background {
	position: fixed;
	top: 0;
	right: 0;
	left: 0;
	z-index: 0;
	width: 100%;
	height: 566rpx;
}

.page-content {
	position: relative;
	z-index: 1;
	padding-bottom: 20rpx;
}

.error-message {
	box-sizing: border-box;
	margin: 24rpx auto 0;
	padding: 20rpx;
	width: 710rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

.profile-head {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	margin: 50rpx auto;
	width: 710rpx;
	min-height: 130rpx;
}

.profile-avatar {
	flex: 0 0 130rpx;
	box-sizing: border-box;
	width: 130rpx;
	height: 130rpx;
	border: 8rpx solid #ffffff;
	border-radius: 50%;
	background: #ffffff;
}

.profile-name {
	margin-left: 20rpx;
	color: #222222;
	font-size: 45rpx;
	line-height: 1.25;
}

.family-card {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	margin: 0 auto;
	padding: 0 20rpx;
	width: 710rpx;
	height: 120rpx;
	border-radius: 30rpx;
	background: linear-gradient(90deg, rgb(40, 115, 255) 0%, rgb(46, 114, 255) 100%);
	color: #ffffff;
}

.family-title {
	font-size: 30rpx;
	line-height: 1.4;
}

.family-arrow {
	margin-left: 20rpx;
	width: 30rpx;
	height: 30rpx;
}

.menu-section {
	box-sizing: border-box;
	margin: 30rpx auto 0;
	padding: 20rpx 0;
	width: 710rpx;
	border-radius: 20rpx;
	background: #ffffff;
}

.section-title {
	display: block;
	margin-bottom: 60rpx;
	padding: 0 30rpx;
	color: #222222;
	font-size: 28rpx;
	font-weight: 700;
	line-height: 1.4;
}

.menu-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	/* 旧端使用 `grid ... gap-20rpx`，行列间距都必须保留。 */
	column-gap: 20rpx;
	row-gap: 20rpx;
	padding-bottom: 20rpx;
}

.menu-item {
	display: flex;
	align-items: center;
	justify-content: center;
	min-width: 0;
	color: #333333;
	flex-direction: column;
	font-size: 26rpx;
	line-height: 1.4;
}

.menu-item image {
	display: block;
	margin-bottom: 20rpx;
	width: 50rpx;
	height: 50rpx;
}

.legacy-tabbar {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 20;
	display: flex;
	align-items: stretch;
	justify-content: space-around;
	box-sizing: border-box;
	height: calc(130rpx + env(safe-area-inset-bottom));
	padding-bottom: env(safe-area-inset-bottom);
	border-top: 1rpx solid #eeeeee;
	background: #ffffff;
}

.legacy-tabbar-item {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 25%;
	height: 100%;
	gap: 6rpx;
	color: #2c2c2c;
	flex-direction: column;
	font-size: 20rpx;
	line-height: 1;
}

.legacy-tabbar-item-current {
	color: #3d6df6;
}

.legacy-tabbar-icon {
	display: block;
	width: 48rpx;
	height: 48rpx;
}
