page {
	height: 100%;
	overflow: hidden;
	background: #f8f8f8;
}

/* scroll-view 的底部安全区属于滚动容器本身，必须同步页面底色，避免
 * 内容不足一屏时在原生 TabBar 上方露出一块突兀的白色区域。 */
.tab-page-scroll {
	background: #f8f8f8;
}

.page {
	position: relative;
	box-sizing: border-box;
	min-height: 100vh;
	padding: 1rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
	background: #f8f8f8;
}

/* 旧端 background-size: 100% 的资源尺寸是 750x566，按屏宽等比显示，避免 aspectFill 裁切两侧。 */
.page-background {
	position: fixed;
	top: 0;
	right: 0;
	left: 0;
	z-index: 0;
	width: 100%;
	height: 566rpx;
}

.page-content {
	position: relative;
	z-index: 1;
	padding-bottom: 20rpx;
}

.error-message {
	box-sizing: border-box;
	margin: 24rpx auto 0;
	padding: 20rpx;
	width: 710rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: left;
}

.error-message-text {
	min-width: 0;
	flex: 1;
}

.error-message-retry {
	flex: 0 0 auto;
	margin-left: 16rpx;
	color: #d9363e;
	font-weight: 700;
	white-space: nowrap;
}

.profile-head {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	margin: 50rpx auto;
	width: 710rpx;
	min-height: 130rpx;
}

.profile-avatar {
	flex: 0 0 130rpx;
	box-sizing: border-box;
	width: 130rpx;
	height: 130rpx;
	border: 8rpx solid #ffffff;
	border-radius: 50%;
	background: #ffffff;
}

.profile-copy {
	display: flex;
	flex: 1;
	min-width: 0;
	margin-left: 20rpx;
	flex-direction: column;
	align-items: flex-start;
}

.profile-name {
	max-width: 560rpx;
	color: #222222;
	font-size: 45rpx;
	line-height: 1.25;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.profile-auth-hint {
	display: block;
	max-width: 560rpx;
	color: #5570a8;
	font-size: 23rpx;
	line-height: 1.4;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* 扩大授权提示的可点击区域，避免用户必须精准点中文字才触发微信弹窗。 */
.profile-auth-action {
	margin-top: 10rpx;
	padding: 8rpx 12rpx;
	margin-left: -12rpx;
	border-radius: 10rpx;
}

.family-card {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	margin: 0 auto;
	padding: 0 20rpx;
	width: 710rpx;
	height: 120rpx;
	border-radius: 30rpx;
	background: linear-gradient(90deg, rgb(40, 115, 255) 0%, rgb(46, 114, 255) 100%);
	color: #ffffff;
}

.family-title {
	font-size: 30rpx;
	line-height: 1.4;
}

.family-arrow {
	margin-left: 20rpx;
	width: 30rpx;
	height: 30rpx;
}

.menu-section {
	box-sizing: border-box;
	margin: 30rpx auto 0;
	padding: 20rpx 0;
	width: 710rpx;
	border-radius: 20rpx;
	background: #ffffff;
}

.section-title {
	display: block;
	margin-bottom: 60rpx;
	padding: 0 30rpx;
	color: #222222;
	font-size: 28rpx;
	font-weight: 700;
	line-height: 1.4;
}

.menu-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	/* 旧端使用 `grid ... gap-20rpx`，行列间距都必须保留。 */
	column-gap: 20rpx;
	row-gap: 20rpx;
	padding-bottom: 20rpx;
}

.menu-item {
	display: flex;
	align-items: center;
	justify-content: center;
	min-width: 0;
	color: #333333;
	flex-direction: column;
	font-size: 26rpx;
	line-height: 1.4;
}

.menu-item image {
	display: block;
	margin-bottom: 20rpx;
	width: 50rpx;
	height: 50rpx;
}
