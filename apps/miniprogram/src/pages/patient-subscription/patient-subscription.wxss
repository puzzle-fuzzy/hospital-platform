page {
	background: #f8f8f8;
}

.subscription-scroll {
	height: 100vh;
}

.subscription-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: 230rpx;
}

.subscription-error {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 76rpx;
	padding: 16rpx 24rpx;
	background: #fff0f0;
	color: #c53b36;
	font-size: 25rpx;
	line-height: 1.5;
}

.subscription-retry {
	flex-shrink: 0;
	margin: 0 0 0 18rpx;
	padding: 0;
	background: transparent;
	color: #3d6df6;
	font-size: 25rpx;
	line-height: 1.5;
}

.subscription-retry::after,
.subscription-status-button::after,
.subscription-back-button::after {
	border: 0;
}

.subscription-warning {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	gap: 8rpx;
	padding: 24rpx 30rpx;
	background: #fff7e8;
	color: #c77715;
	font-size: 26rpx;
	line-height: 1.6;
}

.subscription-warning-note {
	color: #9a6a1d;
	font-size: 23rpx;
}

.subscription-patient {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	padding: 24rpx 30rpx;
	background: #ffffff;
	border-bottom: 1rpx solid #f0f0f0;
}

.subscription-patient image {
	width: 62rpx;
	height: 62rpx;
	margin-right: 20rpx;
}

.subscription-patient-copy {
	display: flex;
	flex: 1;
	flex-direction: column;
	gap: 6rpx;
}

.subscription-patient-label {
	color: #999999;
	font-size: 23rpx;
}

.subscription-patient-name {
	color: #333333;
	font-size: 30rpx;
	font-weight: 600;
}

.subscription-muted {
	color: #999999;
	font-weight: 400;
}

.subscription-arrow {
	color: #999999;
	font-size: 46rpx;
	font-weight: 300;
	line-height: 1;
}

.subscription-search-card {
	box-sizing: border-box;
	padding: 22rpx 30rpx;
	background: #ffffff;
}

.subscription-search-input {
	box-sizing: border-box;
	width: 100%;
	height: 70rpx;
	padding: 0 28rpx;
	border-radius: 36rpx;
	background: #f5f6f6;
	color: #333333;
	font-size: 26rpx;
}

.subscription-placeholder {
	color: #aaaaaa;
}

.subscription-result-state {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	height: 240rpx;
	color: #777777;
	font-size: 27rpx;
	text-align: center;
}

.subscription-result-icon {
	color: #cfd5df;
	font-size: 64rpx;
	line-height: 1;
}

.subscription-result-note {
	margin-top: 10rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.subscription-section {
	margin-top: 16rpx;
}

.subscription-section-header {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 25rpx 30rpx;
	background: #ffffff;
	color: #333333;
	font-size: 29rpx;
	font-weight: 600;
}

.subscription-section-arrow {
	color: #9ca3af;
	font-size: 32rpx;
	font-weight: 400;
}

.subscription-items {
	background: #f2f6ff;
}

.subscription-item {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 94rpx;
	padding: 20rpx 30rpx;
	border-bottom: 1rpx solid #edf1f8;
}

.subscription-item-title {
	flex: 1;
	min-width: 0;
	color: #555f71;
	font-size: 27rpx;
	line-height: 1.5;
}

.subscription-item-control {
	display: flex;
	align-items: center;
	flex-shrink: 0;
	gap: 8rpx;
	margin-left: 16rpx;
}

.subscription-item-control text {
	color: #a5acb8;
	font-size: 21rpx;
}

.subscription-bottom-space {
	height: 24rpx;
}

.subscription-bottom-actions {
	box-sizing: border-box;
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 10;
	display: flex;
	align-items: center;
	gap: 16rpx;
	padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
	background: #ffffff;
	border-top: 1rpx solid #edf0f5;
}

.subscription-status-button,
.subscription-back-button {
	box-sizing: border-box;
	flex: 1;
	margin: 0;
	font-size: 26rpx;
	line-height: 76rpx;
}

.subscription-status-button {
	background: #3d6df6;
	color: #ffffff;
}

.subscription-back-button {
	background: #f5f6f8;
	color: #666666;
}
