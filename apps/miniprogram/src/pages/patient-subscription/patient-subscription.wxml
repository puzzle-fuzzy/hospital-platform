<scroll-view class="subscription-scroll" scroll-y="true" enhanced="true">
	<view class="subscription-page">
		<view wx:if="{{error}}" class="subscription-error">
			<text>{{error}}</text>
			<button class="subscription-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="subscription-warning">
			<text>如您关闭订阅将无法收到相关业务提醒，请您慎重选择。</text>
			<text class="subscription-warning-note">当前仅展示旧端项目，尚未接入微信订阅授权，不会保存修改。</text>
		</view>

		<view class="subscription-patient" bindtap="onOpenPatientSelector">
			<image src="/assets/legacy-user/default-avatar.svg" mode="aspectFit" />
			<view class="subscription-patient-copy">
				<text class="subscription-patient-label">当前就诊人</text>
				<text wx:if="{{patient}}" class="subscription-patient-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="subscription-patient-name subscription-muted">正在获取就诊人…</text>
				<text wx:else class="subscription-patient-name subscription-muted">请选择就诊人</text>
			</view>
			<text class="subscription-arrow">›</text>
		</view>

		<view class="subscription-search-card">
			<input
				class="subscription-search-input"
				value="{{query}}"
				bindinput="onSearch"
				confirm-type="search"
				placeholder="请输入消息标题进行查询"
				placeholder-class="subscription-placeholder"
			/>
		</view>

		<view wx:if="{{query && !sections[0].visible && !sections[1].visible && !sections[2].visible && !sections[3].visible}}" class="subscription-result-state">
			<text class="subscription-result-icon">⌕</text>
			<text>未找到相关提醒项目</text>
			<text class="subscription-result-note">请尝试其他关键词</text>
		</view>

		<block wx:for="{{sections}}" wx:key="key">
			<view wx:if="{{item.visible}}" class="subscription-section">
				<view class="subscription-section-header" bindtap="onToggleSection" data-section-key="{{item.key}}">
					<text>{{item.title}}</text>
					<text class="subscription-section-arrow">{{item.expanded ? "⌃" : "⌄"}}</text>
				</view>
				<view wx:if="{{item.expanded}}" class="subscription-items">
					<view wx:for="{{item.items}}" wx:key="key" class="subscription-item">
						<text class="subscription-item-title">{{item.title}}</text>
						<view class="subscription-item-control">
							<switch checked="{{item.enabled}}" disabled="{{true}}" color="#10B981" />
							<text>暂未接入</text>
						</view>
					</view>
				</view>
			</view>
		</block>

		<view class="subscription-bottom-space"></view>
	</view>
</scroll-view>

<view class="subscription-bottom-actions">
	<button class="subscription-status-button" bindtap="onOpenMigrationStatus">查看完整迁移说明</button>
	<button class="subscription-back-button" bindtap="onBackMy">返回我的</button>
</view>
