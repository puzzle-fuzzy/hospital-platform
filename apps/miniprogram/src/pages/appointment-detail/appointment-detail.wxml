<scroll-view class="appointment-detail-scroll" scroll-y="true" enhanced="true">
	<view class="appointment-detail-page">
		<view wx:if="{{loading}}" class="detail-state-card">
			<view class="detail-loading-dot"></view>
			<text>正在加载挂号详情...</text>
		</view>

		<view wx:elif="{{error}}" class="detail-state-card detail-error-card">
			<text class="detail-state-title">挂号详情不可用</text>
			<text class="detail-state-message">{{error}}</text>
			<button
				wx:if="{{sourceAppointmentId && sourcePatientId}}"
				class="detail-retry-button"
				bindtap="onRetry"
			>重新加载</button>
		</view>

		<block wx:elif="{{status}}">
			<view class="detail-status-card">
				<view class="detail-status-main">
					<view class="detail-status-dot detail-status-{{status}}"></view>
					<text class="detail-status-label">{{statusLabel}}</text>
				</view>
				<text class="detail-total">{{totalLabel}}</text>
			</view>

			<view class="detail-card">
				<view class="detail-card-title">预约信息</view>
				<view class="detail-row">
					<text class="detail-row-label">预约医院</text>
					<text class="detail-row-value">{{hospitalName}}</text>
				</view>
				<view class="detail-row">
					<text class="detail-row-label">预约科室</text>
					<text class="detail-row-value">{{departmentName}}</text>
				</view>
				<view wx:if="{{registrationClassName}}" class="detail-row">
					<text class="detail-row-label">预约号别</text>
					<text class="detail-row-value">{{registrationClassName}}</text>
				</view>
				<view class="detail-row">
					<text class="detail-row-label">预约医生</text>
					<text class="detail-row-value">{{doctorName}}</text>
				</view>
				<view wx:if="{{hospitalAreaName}}" class="detail-row">
					<text class="detail-row-label">就诊院区</text>
					<text class="detail-row-value">{{hospitalAreaName}}</text>
				</view>
				<view class="detail-row">
					<text class="detail-row-label">预约挂号序号</text>
					<text class="detail-row-value">{{sourceSerialNumber}}号</text>
				</view>
				<view class="detail-row detail-row-last">
					<text class="detail-row-label">预约就诊时间</text>
					<view class="detail-row-value detail-time-value">
						<text>{{workDate}} {{periodLabel}}</text>
						<text wx:if="{{workTime}}" class="detail-time">{{workTime}}</text>
					</view>
				</view>
				<view class="detail-row detail-fee-row">
					<text class="detail-row-label">挂号记账金额</text>
					<text class="detail-fee">{{totalLabel}}</text>
				</view>
			</view>

			<view class="detail-card detail-address-card">
				<view class="detail-row detail-row-last">
					<text class="detail-row-label">就诊地址</text>
					<text class="detail-row-value">{{location || "以医院现场指引为准"}}</text>
					<button class="detail-guide-button" bindtap="onHospitalGuide" plain="true">去导航</button>
				</view>
				<text class="detail-notice">请携带有效证件按就诊日期到院取号候诊，具体取号时间以医院现场公示为准。</text>
			</view>

			<view class="detail-card">
				<view class="detail-card-title">就诊人</view>
				<view class="detail-row">
					<text class="detail-row-label">姓名</text>
					<text class="detail-row-value">{{patientName}}</text>
				</view>
				<view class="detail-row detail-row-last">
					<text class="detail-row-label">就诊卡</text>
					<text class="detail-row-value">{{patientCardLabel}}</text>
				</view>
			</view>

			<view wx:if="{{legacySummary}}" class="detail-legacy-note">
				<text>这条记录来自历史挂号摘要，当前未建立平台详情引用，仅展示已核实信息。</text>
			</view>

			<view
				wx:if="{{localDetail && appointmentId && status === 'scheduled'}}"
				class="detail-actions"
			>
				<button
					class="detail-cancel-button"
					bindtap="onCancel"
					disabled="{{canceling}}"
				>{{canceling ? "取消中..." : "取消预约"}}</button>
			</view>

			<button class="detail-home-button" bindtap="onBackHome">返回首页</button>

			<view class="detail-footnote">
				<text>预约状态和金额以服务端及医院最终记录为准。</text>
			</view>
		</block>

		<view wx:if="{{showLocationModal}}" class="detail-location-mask" catchtap="closeLocationModal">
			<view class="detail-location-popup" catchtap="stopLocationPropagation">
				<view class="detail-location-header">
					<text>科室位置信息</text>
					<button class="detail-location-close" bindtap="closeLocationModal" plain="true">×</button>
				</view>
				<scroll-view wx:if="{{locationResults.length}}" class="detail-location-scroll" scroll-y="true">
					<view wx:for="{{locationResults}}" wx:key="department" class="detail-location-item">
						<text class="detail-location-department">{{item.department}}</text>
						<text class="detail-location-text">{{item.location}}</text>
					</view>
				</scroll-view>
				<view wx:else class="detail-location-empty">未找到相关科室位置信息</view>
			</view>
		</view>
	</view>
</scroll-view>
