.self-test-scroll { height: 100vh; background: #f8f8f8; }
.self-test-page { box-sizing: border-box; min-height: 100%; padding: 20rpx 24rpx 48rpx; }
.self-test-hero { padding: 14rpx 6rpx 24rpx; }
.self-test-title { display: block; color: #222b45; font-size: 36rpx; font-weight: 600; }
.self-test-subtitle { display: block; margin-top: 8rpx; color: #8791a5; font-size: 23rpx; line-height: 1.6; }
.self-test-card { overflow: hidden; border-radius: 16rpx; background: #fff; }
.self-test-question { padding: 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.self-test-question:last-child { border-bottom: 0; }
.self-test-question-title { display: block; color: #222; font-size: 27rpx; font-weight: 600; line-height: 1.6; white-space: pre-wrap; }
.self-test-option { display: flex; align-items: flex-start; gap: 12rpx; padding-top: 18rpx; color: #555; font-size: 25rpx; line-height: 1.6; }
.self-test-option.is-selected { color: #3d6df6; }
.self-test-radio { flex: 0 0 auto; width: 34rpx; height: 34rpx; border: 1rpx solid #cfd6e5; border-radius: 50%; color: #fff; font-size: 22rpx; line-height: 34rpx; text-align: center; }
.self-test-option.is-selected .self-test-radio { border-color: #3d6df6; background: #3d6df6; }
.self-test-message { margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 14rpx; background: #fff8e8; color: #a66b00; font-size: 24rpx; line-height: 1.6; }
.self-test-submit, .self-test-back { width: 100%; margin-top: 24rpx; border-radius: 14rpx; font-size: 28rpx; line-height: 84rpx; }
.self-test-submit { background: #3d6df6; color: #fff; }
.self-test-note { display: block; margin-top: 16rpx; color: #9aa3b4; font-size: 22rpx; line-height: 1.6; }
.self-test-back { background: transparent; color: #68738a; }
