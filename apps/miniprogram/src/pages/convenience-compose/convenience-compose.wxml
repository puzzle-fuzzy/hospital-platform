<scroll-view class="convenience-compose-scroll" scroll-y="true" enhanced="true" bindscrolltolower="onRecordsScrollToLower">
	<view class="convenience-compose-page">
		<view wx:if="{{mode === 'records' && records.length}}" class="convenience-compose-record-card">
			<view wx:for="{{records}}" wx:key="feedbackId" class="convenience-compose-record-item">
				<view class="convenience-compose-record-head"><text>{{item.donateDate}} · {{item.departmentName}} · {{item.doctorName}}</text><text class="convenience-compose-record-status">{{item.status === 'pending_review' ? '审核中' : (item.status === 'approved' ? '已通过' : (item.status === 'rejected' ? '未通过' : '已撤回'))}}</text></view>
				<text class="convenience-compose-record-kind">{{item.kind === 'gift-banner' ? '电子锦旗' : '表扬信'}}</text>
				<text class="convenience-compose-record-content">{{item.content}}</text>
			</view>
			<view wx:if="{{recordsHasMore}}" class="convenience-compose-record-more"><text wx:if="{{recordsLoadingMore}}">正在加载更多…</text><text wx:else>上拉加载更多</text></view>
			<view wx:elif="{{records.length}}" class="convenience-compose-record-more">已加载全部记录</view>
		</view>
		<view wx:elif="{{mode === 'records'}}" class="convenience-compose-empty-card">
			<image class="convenience-compose-empty-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
			<text class="convenience-compose-empty-title">暂无{{feature === 'gift-banner' ? '电子锦旗' : '表扬信'}}记录</text>
			<text class="convenience-compose-empty-note">当前就诊人暂无{{feature === 'gift-banner' ? '电子锦旗' : '表扬信'}}记录，已从新服务查询。</text>
			<button class="convenience-compose-primary" bindtap="onBackToSurface">返回{{feature === 'gift-banner' ? '电子锦旗' : '表扬信'}}</button>
		</view>

		<view wx:elif="{{mode === 'create'}}" class="convenience-compose-card">
			<view class="convenience-compose-notice">提倡节俭，拒绝浪费；您可以给科室或者医生送出免费的{{feature === 'gift-banner' ? '电子锦旗' : '表扬信'}}，对于医护人员的褒奖不会打折。</view>
			<view class="convenience-compose-patient" bindtap="onChangePatient">
				<view class="convenience-compose-patient-copy">
					<text class="convenience-compose-label">当前就诊人</text>
					<text wx:if="{{patient}}" class="convenience-compose-name">{{patient.displayName}}</text>
					<text wx:elif="{{loading}}" class="convenience-compose-muted">正在获取就诊人...</text>
					<text wx:else class="convenience-compose-muted">请选择就诊人</text>
					<text wx:if="{{patientError}}" class="convenience-compose-error">{{patientError}}</text>
				</view>
				<text class="convenience-compose-arrow">›</text>
			</view>

			<view class="convenience-compose-row"><text class="convenience-compose-row-label">就诊院区</text><text class="convenience-compose-row-value">高平市人民医院</text></view>
			<view class="convenience-compose-row convenience-compose-row-action" bindtap="onVisitRecordTap"><text class="convenience-compose-row-label">就诊记录</text><text class="convenience-compose-row-value {{visitRecord ? '' : 'is-muted'}}">{{visitRecordLoading ? '正在获取就诊记录…' : (visitRecord || '请选择就诊记录')}}　›</text></view>
			<view class="convenience-compose-row"><text class="convenience-compose-row-label">科室</text><text class="convenience-compose-row-value is-muted">{{department || '选择就诊记录后自动填充'}}</text></view>
			<view class="convenience-compose-row"><text class="convenience-compose-row-label">医护人员</text><text class="convenience-compose-row-value is-muted">{{medicalStaff || '选择就诊记录后自动填充'}}</text></view>
			<view class="convenience-compose-field">
				<text class="convenience-compose-row-label">{{feature === 'gift-banner' ? '感谢文案' : '表扬信内容'}}</text>
				<textarea class="convenience-compose-textarea" data-field="content" value="{{content}}" bindinput="onInput" maxlength="{{feature === 'gift-banner' ? 10 : 1000}}" placeholder="{{feature === 'gift-banner' ? '请输入或选择感谢文案（限制10个字）' : '请输入表扬信内容（限制1000字）'}}"></textarea>
			</view>
			<view class="convenience-compose-template-title">常用文案</view>
			<view class="convenience-compose-templates"><view wx:for="{{templates}}" wx:key="*this" class="convenience-compose-template" data-value="{{item}}" bindtap="onTemplateTap">{{item}}</view></view>
			<view class="convenience-compose-row"><text class="convenience-compose-row-label">赠送日期</text><text class="convenience-compose-row-value">{{donateDate}}</text></view>
			<view class="convenience-compose-row convenience-compose-display-row"><text class="convenience-compose-row-label">{{feature === 'gift-banner' ? '锦旗展示' : '展示方式'}}</text><view class="convenience-compose-display"><text class="convenience-compose-display-option {{displayPublic ? 'is-selected' : ''}}" data-value="public" bindtap="onDisplayTap">{{displayPublic ? '✓ ' : ''}}公开</text><text class="convenience-compose-display-option {{displayPublic ? '' : 'is-selected'}}" data-value="private" bindtap="onDisplayTap">{{displayPublic ? '' : '✓ '}}不公开</text></view></view>
		</view>

		<view wx:if="{{showVisitPicker}}" class="convenience-compose-picker-mask" catchtap="onCloseVisitPicker">
			<view class="convenience-compose-picker" catchtap="onCloseVisitPicker">
				<view class="convenience-compose-picker-title">选择就诊记录</view>
				<view wx:for="{{visitRecords}}" wx:key="index" class="convenience-compose-picker-item" data-index="{{index}}" catchtap="onVisitRecordSelect">
					<text>{{item.workDate}}{{item.workTime ? ' ' + item.workTime : ''}}</text>
					<text class="convenience-compose-picker-subtitle">{{item.departmentName || '未记录科室'}}{{item.doctorName ? ' · ' + item.doctorName : ''}}</text>
				</view>
				<view class="convenience-compose-picker-cancel" catchtap="onCloseVisitPicker">取消</view>
			</view>
		</view>

		<view wx:if="{{message}}" class="convenience-compose-message">{{message}}</view>
		<button wx:if="{{mode === 'create'}}" class="convenience-compose-primary" loading="{{submitting}}" bindtap="onSubmit">{{feature === 'gift-banner' ? '立即赠送' : '提交表扬信'}}</button>
		<text wx:if="{{mode === 'create'}}" class="convenience-compose-note">就诊记录、医护信息、内容审核和提交结果需由当前平台服务端确认；未开放接口不会写入旧端数据。</text>
		<button class="convenience-compose-back" bindtap="onBack">返回上一页</button>
	</view>
</scroll-view>
