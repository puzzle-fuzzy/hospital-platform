page {
	background: #f6f8fc;
}

.invoice-page {
	box-sizing: border-box;
	padding: 32rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.invoice-print-guide {
	box-sizing: border-box;
	display: flex;
	padding: 56rpx 32rpx;
	flex-direction: column;
	align-items: center;
	border-radius: 20rpx;
	background: #ffffff;
	text-align: center;
}

.invoice-print-title {
	color: #303640;
	font-size: 32rpx;
	font-weight: 700;
}

.invoice-print-message {
	margin-top: 24rpx;
	color: #303640;
	font-size: 30rpx;
	line-height: 1.6;
}

.invoice-print-hint {
	margin-top: 20rpx;
	color: #78818c;
	font-size: 25rpx;
	line-height: 1.6;
}
