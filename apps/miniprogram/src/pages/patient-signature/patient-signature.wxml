<scroll-view class="signature-scroll" scroll-y="true" enhanced="true">
	<view class="signature-page">
		<view wx:if="{{error}}" class="signature-error">
			<text>{{error}}</text>
			<button class="signature-retry" bindtap="onRetry">重新获取</button>
		</view>

		<view class="signature-notice">
			<text>请选择需要进行签署的就诊人，确认后将进入签名流程。</text>
			<text class="signature-notice-note">签名服务正在完善中，暂时无法使用。</text>
		</view>

		<view class="signature-section-title">已绑定就诊人</view>

		<view wx:if="{{loading || error || !patients.length}}" class="signature-state-card">
			<view wx:if="{{loading}}" class="signature-loading-icon" aria-hidden="true"></view>
			<text wx:if="{{loading}}">正在获取就诊人...</text>
			<block wx:elif="{{error}}">
				<text>本次就诊人目录未加载成功</text>
			<text class="signature-state-note">请稍后再试</text>
			</block>
			<block wx:else>
				<image src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
				<text>当前微信账号暂无已绑定的就诊人</text>
				<text class="signature-state-note">请先完成医院侧就诊人绑定</text>
			</block>
		</view>

		<view wx:elif="{{patients.length}}" class="signature-patient-list">
			<view
				wx:for="{{patients}}"
				wx:key="id"
				class="signature-patient-row"
				bindtap="onPatientTap"
				data-patient-id="{{item.id}}"
			>
				<view class="signature-radio {{item.id === selectedPatientId ? 'signature-radio-selected' : ''}}">
					<view wx:if="{{item.id === selectedPatientId}}" class="signature-radio-dot"></view>
				</view>
				<view class="signature-patient-copy">
					<view class="signature-patient-title">
						<text class="signature-patient-name">{{item.displayName}}</text>
						<text class="signature-patient-relation">{{item.relationshipLabel}}</text>
					</view>
					<text class="signature-patient-card">电子就诊卡（脱敏）：{{item.cardNumberMasked}}</text>
					<text wx:if="{{item.clinicalAccess !== 'ready'}}" class="signature-patient-unavailable">当前服务暂不可用</text>
				</view>
				<image
					class="signature-arrow"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
					aria-hidden="true"
				/>
			</view>
		</view>

		<view class="signature-other-row" bindtap="onOpenPatientSelector">
			<image src="/assets/legacy-home/service-patient.svg" mode="aspectFit" />
			<text>选择其他就诊人</text>
			<image
				class="signature-arrow"
				src="/assets/legacy-user/selector-arrow-right.svg"
				mode="aspectFit"
				aria-hidden="true"
			/>
		</view>

		<view class="signature-tips">
			<text class="signature-tips-title">签名提示</text>
			<text>· 签名必须绑定明确用途、当前账号和当前就诊人。</text>
			<text>· 当前暂不支持上传签名文件。</text>
			<text>· 若需更换或新增就诊人，请点击“选择其他就诊人”。</text>
		</view>

		<button class="signature-status-button" bindtap="onOpenPatientAgreement">查看患者协议原文</button>
		<button class="signature-status-button" bindtap="onOpenMigrationStatus">了解服务进度</button>
		<button class="signature-back-button" bindtap="onBackMy">返回我的</button>
	</view>
</scroll-view>
