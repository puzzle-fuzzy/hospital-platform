page {
	background: #f8f8f8;
}

.signature-scroll {
	height: 100vh;
}

.signature-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: 48rpx;
}

.signature-notice,
.signature-tips,
.signature-other-row,
.signature-patient-row {
	background: #ffffff;
}

.signature-notice {
	box-sizing: border-box;
	padding: 28rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
	color: #666666;
	font-size: 28rpx;
	line-height: 1.65;
}

.signature-notice-note {
	display: block;
	margin-top: 8rpx;
	color: #9a6a1d;
	font-size: 24rpx;
}

.signature-error {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 76rpx;
	padding: 16rpx 24rpx;
	background: #fff0f0;
	color: #c53b36;
	font-size: 25rpx;
	line-height: 1.5;
}

.signature-retry {
	flex-shrink: 0;
	margin: 0 0 0 18rpx;
	padding: 0;
	background: transparent;
	color: #3d6df6;
	font-size: 25rpx;
	line-height: 1.5;
}

.signature-retry::after,
.signature-back-button::after,
.signature-status-button::after {
	border: 0;
}

.signature-section-title {
	box-sizing: border-box;
	padding: 24rpx 30rpx;
	background: #f8f9fa;
	color: #999999;
	font-size: 28rpx;
}

.signature-state-card {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	height: 330rpx;
	margin: 0 24rpx 20rpx;
	padding: 30rpx;
	background: #ffffff;
	color: #777777;
	font-size: 27rpx;
	text-align: center;
}

.signature-state-card image {
	width: 150rpx;
	height: 130rpx;
	margin-bottom: 18rpx;
}

.signature-state-note {
	margin-top: 10rpx;
	color: #aaaaaa;
	font-size: 24rpx;
}

.signature-loading-icon {
	box-sizing: border-box;
	width: 46rpx;
	height: 46rpx;
	margin-bottom: 18rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #3d6df6;
	border-radius: 50%;
	animation: signature-loading 900ms linear infinite;
}

@keyframes signature-loading {
	to {
		transform: rotate(360deg);
	}
}

.signature-patient-list {
	background: #ffffff;
}

.signature-patient-row {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	min-height: 136rpx;
	padding: 26rpx 30rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.signature-radio {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	width: 42rpx;
	height: 42rpx;
	margin-right: 20rpx;
	border: 2rpx solid #c8cdd6;
	border-radius: 50%;
}

.signature-radio-selected {
	border-color: #3d6df6;
}

.signature-radio-dot {
	width: 22rpx;
	height: 22rpx;
	border-radius: 50%;
	background: #3d6df6;
}

.signature-patient-copy {
	flex: 1;
	min-width: 0;
}

.signature-patient-title {
	display: flex;
	align-items: center;
}

.signature-patient-name {
	max-width: 320rpx;
	overflow: hidden;
	color: #333333;
	font-size: 32rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.signature-patient-relation {
	margin-left: 18rpx;
	padding: 4rpx 12rpx;
	border-radius: 8rpx;
	background: #f2f6ff;
	color: #3d6df6;
	font-size: 23rpx;
}

.signature-patient-card,
.signature-patient-unavailable {
	display: block;
	margin-top: 9rpx;
	color: #999999;
	font-size: 24rpx;
	line-height: 1.5;
}

.signature-patient-unavailable {
	color: #bd3b35;
}

.signature-arrow {
	margin-left: 16rpx;
	color: #999999;
	font-size: 46rpx;
	font-weight: 300;
	line-height: 1;
}

.signature-other-row {
	display: flex;
	align-items: center;
	margin-top: 20rpx;
	padding: 28rpx 30rpx;
	color: #333333;
	font-size: 30rpx;
}

.signature-other-row image {
	width: 46rpx;
	height: 46rpx;
	margin-right: 20rpx;
}

.signature-other-row text:nth-child(2) {
	flex: 1;
}

.signature-tips {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	margin-top: 20rpx;
	padding: 28rpx 30rpx;
	background: #ffffff;
	color: #666666;
	font-size: 26rpx;
	line-height: 1.65;
}

.signature-tips-title {
	color: #333333;
	font-size: 28rpx;
	font-weight: 700;
}

.signature-status-button,
.signature-back-button {
	box-sizing: border-box;
	display: block;
	width: calc(100% - 96rpx);
	margin: 24rpx auto 0;
	font-size: 27rpx;
}

.signature-status-button {
	background: #eef3ff;
	border: 1rpx solid #dce6ff;
	color: #3d6df6;
}

.signature-back-button {
	margin-top: 16rpx;
	background: #ffffff;
	border: 1rpx solid #e5e5e5;
	color: #666666;
}
