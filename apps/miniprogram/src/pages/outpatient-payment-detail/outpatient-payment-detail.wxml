<scroll-view class="detail-scroll" scroll-y="true" enhanced="true">
	<view class="page">
		<view wx:if="{{loading || error}}" class="state-card {{error ? 'error-state' : ''}}">
			<text wx:if="{{loading}}">正在加载门诊费用详情...</text>
			<block wx:else>
				<text class="state-title">门诊费用详情暂不可用</text>
				<text class="state-message">{{error}}</text>
				<button wx:if="{{sourcePatientId && sourceRecordId && sourceStatus}}" class="retry-button" size="mini" bindtap="onRetry">重新加载</button>
				<button class="back-button" size="mini" bindtap="onBack">返回费用记录</button>
				<button class="home-button state-home-button" size="mini" bindtap="onBackHome">返回首页</button>
			</block>
		</view>

		<block wx:elif="{{item}}">
			<view class="card patient-card">
				<view class="patient-card-header">
					<view class="label">就诊人</view>
					<view class="status status-{{item.paymentStatus || item.status}}">{{statusLabel(item.status, item.paymentStatus)}}</view>
				</view>
				<view class="patient-name">{{selectedPatient.displayName}}</view>
				<view class="muted">{{selectedPatient.cardNumberMasked}}</view>
			</view>

			<view class="card">
				<view class="label">医院</view>
				<view class="value">{{hospitalName}}</view>
				<view wx:if="{{item.itemName}}" class="detail-line"><text class="detail-label">费用项目</text><text class="detail-value">{{item.itemName}}</text></view>
				<view class="detail-line"><text class="detail-label">开单科室</text><text class="detail-value">{{item.departmentName || '门诊费用'}}</text></view>
				<view wx:if="{{item.executionDepartmentName}}" class="detail-line"><text class="detail-label">执行科室</text><text class="detail-value">{{item.executionDepartmentName}}</text></view>
				<view wx:if="{{item.doctorName}}" class="detail-line"><text class="detail-label">就诊医生</text><text class="detail-value">{{item.doctorName}}</text></view>
				<view wx:if="{{item.executionDoctorName}}" class="detail-line"><text class="detail-label">执行医生</text><text class="detail-value">{{item.executionDoctorName}}</text></view>
				<view wx:if="{{item.spec || item.quantity || item.unitName}}" class="detail-line"><text class="detail-label">规格数量</text><text class="detail-value">{{formatSpecQuantity(item.spec, item.quantity, item.unitName)}}</text></view>
				<view wx:if="{{item.priceFen >= 0}}" class="detail-line"><text class="detail-label">单价</text><text class="detail-value">{{formatAmount(item.priceFen)}}</text></view>
				<view wx:if="{{item.unitName}}" class="detail-line"><text class="detail-label">计价单位</text><text class="detail-value">{{item.unitName}}</text></view>
				<view wx:if="{{item.chargeClassName}}" class="detail-line"><text class="detail-label">费别</text><text class="detail-value">{{item.chargeClassName}}</text></view>
				<view wx:if="{{item.tradePropName}}" class="detail-line"><text class="detail-label">医嘱分类</text><text class="detail-value">{{item.tradePropName}}</text></view>
				<view wx:if="{{item.networkPatClassName}}" class="detail-line"><text class="detail-label">医保类别</text><text class="detail-value">{{item.networkPatClassName}}</text></view>
				<view wx:if="{{item.typeMemo}}" class="detail-line"><text class="detail-label">项目类型</text><text class="detail-value">{{item.typeMemo}}</text></view>
				<view wx:if="{{item.selfBurdenRatio >= 0}}" class="detail-line"><text class="detail-label">自付比例</text><text class="detail-value">{{formatRatio(item.selfBurdenRatio)}}</text></view>
				<view wx:if="{{item.preferentialAmountFen >= 0}}" class="detail-line"><text class="detail-label">优惠金额</text><text class="detail-value">{{formatAmount(item.preferentialAmountFen)}}</text></view>
				<view wx:if="{{item.ascendAmountFen >= 0}}" class="detail-line"><text class="detail-label">上浮金额</text><text class="detail-value">{{formatAmount(item.ascendAmountFen)}}</text></view>
				<view class="detail-line"><text class="detail-label">费用日期</text><text class="detail-value">{{formatDate(item.billDate)}}</text></view>
				<view class="detail-line detail-line-last"><text class="detail-label">账单金额</text><text class="amount">{{formatAmount(item.amountFen)}}</text></view>
			</view>

			<view class="notice-card">
				<view class="notice-title">费用信息</view>
				<view class="muted notice-text">页面展示的是本次 2.6.33 返回并经过服务端校验的费用字段；订单号、医保编码和诊断等内部字段不会在页面展示。</view>
			</view>

			<view wx:if="{{item.status === 'unpaid'}}" class="payment-card">
				<view class="payment-card-title">选择支付方式</view>
				<view class="payment-card-hint">请根据本次门诊费用选择支付方式</view>
				<view wx:if="{{paymentMessage}}" class="payment-message">{{paymentMessage}}</view>
				<view class="payment-actions">
					<button class="payment-button medical-button" bindtap="onMedicalPay" loading="{{paymentBusy === 'medical'}}" disabled="{{paymentBusy !== ''}}">医保支付</button>
					<button class="payment-button wechat-button" bindtap="onWechatPay" loading="{{paymentBusy === 'wechat'}}" disabled="{{paymentBusy !== ''}}">微信支付</button>
				</view>
			</view>
			<view wx:elif="{{item.paymentStatus === 'refunding'}}" class="refunding-card">
				<view class="paid-icon refunding-icon">!</view>
				<view class="paid-title refunding-title">本笔费用退款中</view>
				<view class="paid-hint">医保资金正在原路退回，到账时间以支付渠道处理结果为准</view>
			</view>
			<view wx:else class="paid-card">
				<view class="paid-icon">✓</view>
				<view class="paid-title">本笔费用已缴费</view>
				<view class="paid-hint">如需查看后续就诊信息，请返回首页</view>
			</view>

			<view class="back-link" bindtap="onBack">返回费用记录</view>
			<button class="home-button" bindtap="onBackHome">返回首页</button>
		</block>
	</view>
</scroll-view>
