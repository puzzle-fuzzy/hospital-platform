<scroll-view class="detail-scroll" scroll-y="true" enhanced="true">
	<view class="page">
		<view wx:if="{{loading || error}}" class="state-card {{error ? 'error-state' : ''}}">
			<text wx:if="{{loading}}">正在加载门诊费用详情...</text>
			<block wx:else>
				<text class="state-title">门诊费用详情暂不可用</text>
				<text class="state-message">{{error}}</text>
				<button wx:if="{{sourcePatientId && sourceRecordId && sourceStatus}}" class="retry-button" size="mini" bindtap="onRetry">重新加载</button>
				<button class="back-button" size="mini" bindtap="onBack">返回费用记录</button>
				<button class="home-button state-home-button" size="mini" bindtap="onBackHome">返回首页</button>
			</block>
		</view>

		<block wx:elif="{{item}}">
			<view class="card patient-card">
				<view class="patient-card-header">
					<view class="label">就诊人</view>
					<view class="status status-{{item.paymentStatus || item.status}}">{{statusLabel(item.status, item.paymentStatus)}}</view>
				</view>
				<view class="patient-name">{{selectedPatient.displayName}}</view>
				<view class="muted">{{selectedPatient.cardNumberMasked}}</view>
			</view>

			<view class="card fee-card">
				<view wx:if="{{hospitalName}}" class="detail-line"><text class="detail-label">医院</text><text class="detail-value">{{hospitalName}}</text></view>
				<view wx:if="{{item.itemName}}" class="detail-line"><text class="detail-label">费用项目</text><text class="detail-value">{{item.itemName}}</text></view>
				<view wx:if="{{item.billDate}}" class="detail-line"><text class="detail-label">费用日期</text><text class="detail-value">{{formatDate(item.billDate)}}</text></view>
				<view wx:if="{{item.amountFen >= 0}}" class="detail-line detail-line-last"><text class="detail-label">缴费金额</text><text class="amount">{{formatAmount(item.amountFen)}}</text></view>
			</view>

			<view wx:if="{{item.status === 'unpaid'}}" class="payment-card">
				<view class="payment-card-title">选择支付方式</view>
				<view class="payment-card-hint">请根据本次门诊费用选择支付方式</view>
				<view wx:if="{{paymentMessage}}" class="payment-message">{{paymentMessage}}</view>
				<view class="payment-actions">
					<button class="payment-button medical-button" bindtap="onMedicalPay" loading="{{paymentBusy === 'medical'}}" disabled="{{paymentBusy !== ''}}">医保支付</button>
					<button class="payment-button wechat-button" bindtap="onWechatPay" loading="{{paymentBusy === 'wechat'}}" disabled="{{paymentBusy !== ''}}">微信支付</button>
				</view>
			</view>
			<view wx:elif="{{item.paymentStatus === 'refunding'}}" class="refunding-card">
				<view class="paid-icon refunding-icon">!</view>
				<view class="paid-title refunding-title">本笔费用退款中</view>
				<view class="paid-hint">医保资金正在原路退回，到账时间以支付渠道处理结果为准</view>
			</view>
			<view wx:else class="paid-card">
				<view class="paid-icon">✓</view>
				<view class="paid-title">本笔费用已缴费</view>
				<view class="paid-hint">如需查看后续就诊信息，请返回首页</view>
			</view>

			<view class="back-link" bindtap="onBack">返回费用记录</view>
			<button class="home-button" bindtap="onBackHome">返回首页</button>
		</block>
	</view>
</scroll-view>
