<scroll-view class="admission-scroll" scroll-y="true" enhanced="true">
	<view class="admission-page">
		<view class="admission-notice">请根据患者当前情况填写，所有项目均为必填项。</view>

		<view class="admission-patient-card" bindtap="onChangePatient">
			<view class="admission-patient-copy">
				<text class="admission-patient-label">当前就诊人</text>
				<text wx:if="{{patient}}" class="admission-patient-name">{{patient.displayName}}</text>
				<text wx:elif="{{loading}}" class="admission-patient-muted">正在获取就诊人...</text>
				<text wx:else class="admission-patient-muted">请选择就诊人</text>
				<text wx:if="{{patient}}" class="admission-card-label">{{patient.cardNumberMasked}}</text>
				<text wx:if="{{patientError}}" class="admission-patient-error">{{patientError}}</text>
			</view>
			<text class="admission-arrow">›</text>
		</view>

		<view wx:for="{{questions}}" wx:key="title" class="admission-question-card">
			<view class="admission-question-title"><text class="admission-required">*</text>{{index + 1}}. {{item.title}}</view>

			<view wx:if="{{item.type === 'sex' || item.type === 'relationship' || item.type === 'choice'}}" class="admission-options">
				<view wx:for="{{item.options}}" wx:for-item="option" wx:for-index="optionIndex" wx:key="*this" class="admission-option {{answers[index] === option ? 'is-selected' : ''}}" data-index="{{index}}" data-value="{{option}}" bindtap="onOptionTap">
					<text>{{option}}</text>
				</view>
			</view>

			<input wx:if="{{item.type === 'number'}}" class="admission-input" type="number" data-index="{{index}}" value="{{answers[index]}}" bindinput="onInput" placeholder="{{item.placeholder}}" />
			<textarea wx:elif="{{item.type === 'text'}}" class="admission-textarea" data-index="{{index}}" value="{{answers[index]}}" bindinput="onInput" maxlength="1000" placeholder="{{item.placeholder}}"></textarea>
			<textarea wx:elif="{{item.type === 'choice' && item.hasInput && answers[index] === '有'}}" class="admission-textarea" data-index="{{index}}" data-field="detail" value="{{details[index]}}" bindinput="onInput" maxlength="1000" placeholder="{{item.placeholder}}"></textarea>
		</view>

		<view wx:if="{{message}}" class="admission-message">{{message}}</view>
		<button class="admission-submit" loading="{{submitting}}" bindtap="onSubmit">提交</button>
		<text class="admission-disclaimer">问卷内容不替代医生问诊；当前提交接口尚未开放，点击提交只会校验填写完整性。</text>
		<button class="admission-back" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
