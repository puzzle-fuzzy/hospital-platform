<scroll-view class="settlement-scroll" scroll-y="true" enhanced="true">
	<view class="settlement-page">
		<block wx:if="{{loading || hasPending}}">
			<view class="settlement-hero">
				<text class="settlement-hero-label">付款给</text>
				<view class="settlement-hero-main">
					<text class="settlement-hero-hospital">{{hospitalName}}</text>
					<view class="hospital-icon" aria-hidden="true">
						<view class="hospital-roof"></view>
						<view class="hospital-building">
							<view class="hospital-window-row">
								<view class="hospital-window"></view>
								<view class="hospital-window"></view>
							</view>
							<view class="hospital-window-row">
								<view class="hospital-window"></view>
								<view class="hospital-window"></view>
							</view>
							<view class="hospital-door"></view>
						</view>
					</view>
				</view>
			</view>

			<view class="amount-card">
				<view class="amount-row amount-total-row">
					<text>费用总额</text>
					<text class="amount-total">{{totalAmountLabel}}</text>
				</view>
				<view class="detail-row">
					<text>医保支付</text>
					<text>{{insuranceAmountLabel}}</text>
				</view>
				<view wx:if="{{hasHospitalDiscount}}" class="detail-row">
					<text>医院优惠</text>
					<text>-{{hospitalDiscountAmountLabel}}</text>
				</view>
				<view class="detail-row amount-cash-row">
					<text>{{cashAmountCaption}}</text>
					<text>{{cashAmountLabel}}</text>
				</view>
				<view class="amount-divider"></view>
				<text class="amount-source">金额以医院结算结果为准</text>
			</view>

			<view wx:if="{{paymentMessage && !loading}}" class="payment-message">{{paymentMessage}}</view>

			<view class="insurance-payment">
				<image
					class="insurance-logo"
					src="/assets/medical-insurance-logo.png"
					mode="widthFix"
				></image>
				<text class="insurance-label">医保移动支付</text>
			</view>

			<view class="settlement-bottom-bar">
				<view class="settlement-remaining">
					<text class="settlement-remaining-label">{{hasActualCashAmount ? '您还需支付：' : '实际支付金额以收银台为准'}}</text>
					<text wx:if="{{hasActualCashAmount}}" class="settlement-remaining-amount">¥{{cashAmountValue}}</text>
				</view>
				<button
					class="primary-button"
					bindtap="onPay"
					loading="{{paymentBusy}}"
					disabled="{{paymentBusy || loading}}"
				>去支付</button>
			</view>
		</block>

		<view wx:elif="{{externalPaymentConfirmed}}" class="state-card">
			<text class="state-title">费用已缴清</text>
			<text class="state-message">费用已通过其他渠道缴清，无需重复支付</text>
			<button class="back-button" bindtap="onBack">返回门诊缴费</button>
		</view>

		<view wx:elif="{{error}}" class="state-card error-state">
			<text class="state-title">结算页面不可用</text>
			<text class="state-message">{{error}}</text>
			<button
				wx:if="{{canRetrySettlement}}"
				class="primary-button"
				bindtap="onRetrySettlement"
				loading="{{paymentBusy}}"
				disabled="{{paymentBusy}}"
			>查询原订单</button>
			<button class="back-button" bindtap="onBack">返回门诊缴费</button>
		</view>

		<view wx:if="{{loading}}" class="settlement-loading-mask" catchtouchmove="onLoadingTouchMove">
			<view class="loading-spinner" aria-label="加载中"></view>
			<text class="loading-text">拼命加载中，请耐心等待 ...</text>
		</view>
	</view>
</scroll-view>
