<scroll-view class="tab-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<!-- 网络异常必须出现在页面首部，避免用户先看到不可用的业务入口。 -->
	<view wx:if="{{error}}" class="error-message">
		<text class="error-message-text">{{error}}</text>
		<text class="error-message-retry" bindtap="onRetry">重新加载</text>
	</view>

	<!-- 顶部卡片：尺寸、层级和内容顺序与旧端首页保持一致。 -->
	<view class="con-main patient-area">
		<view class="patient-card bg1">
			<!-- 微信渲染层不支持 WXSS 的本地 background-image，改用原生 image 作为卡片背景。 -->
			<image
				class="patient-card-background"
				src="/assets/legacy-home/patient-background.png"
				mode="aspectFill"
			/>
			<image
				src="/assets/legacy-home/patient-qr.svg"
				mode="aspectFill"
				class="patient-qr"
				bindtap="onPatientQr"
			/>
			<view class="patient-card-copy">
				<!--
					会话恢复期间不能展示上一轮患者，但也不能把整张卡片收缩成空白。
					固定两行占位可以同时满足隐私边界和视觉稳定性，避免主 Tab 切回
					首页时因为异步验证造成内容首帧闪动。
				-->
				<block wx:if="{{sessionStatus === '验证会话中' || (sessionStatus === '已恢复会话' && !selectedPatient)}}">
					<view class="patient-name patient-card-pending">正在验证就诊人</view>
					<view class="patient-id patient-card-pending">请稍候...</view>
				</block>
				<block wx:else>
					<!-- wx.login 不读取头像昵称；无就诊人时明确显示平台会话已建立，避免误认为登录无效。 -->
					<view class="patient-name">{{selectedPatient.displayName || (sessionStatus === "已登录" || sessionStatus === "已恢复会话" ? "微信已登录" : "匿名")}}</view>
					<!-- 只展示服务端生成的脱敏卡号，绝不把内部 opaque patientId 放到可见 UI。 -->
					<view class="patient-id">就诊卡：{{selectedPatient.cardNumberMasked || "----"}}</view>
				</block>
			</view>
			<view class="patient-change" bindtap="onHeroAction">
				{{selectedPatient.displayName ? "更换就诊人" : "新增就诊人"}}
			</view>
		</view>

		<view class="top-grid">
			<view
				wx:for="{{topTabList}}"
				wx:key="text"
				class="top-grid-item"
				bindtap="onTopAction"
				data-action="{{item.action}}"
			>
				<image class="top-grid-icon" src="{{item.icon}}" mode="heightFix" />
				<text class="top-grid-label">{{item.text}}</text>
			</view>
		</view>
	</view>

	<!-- 快捷入口：左侧 340rpx 轮播，右侧三张原始快捷图。 -->
	<view class="con-main quick-entry">
		<view class="quick-entry-row">
			<swiper
				class="quick-banner"
				indicator-dots
				autoplay
				circular
				indicator-active-color="#3D6DF6"
			>
				<swiper-item wx:for="{{bannerList}}" wx:key="index">
					<image
						class="quick-banner-image"
						src="{{item.image}}"
						mode="aspectFill"
						bindtap="onRightAction"
						data-action="{{item.action}}"
					/>
				</swiper-item>
			</swiper>
			<view class="quick-entry-right">
				<image
					wx:for="{{rightList}}"
					wx:key="image"
					class="quick-right-image"
					src="{{item.image}}"
					mode="heightFix"
					bindtap="onRightAction"
					data-action="{{item.action}}"
				/>
			</view>
		</view>
	</view>

	<!-- 首页服务选项卡：保留旧端 190rpx 标签和四列图标布局。 -->
	<view class="service-con">
		<view class="service-tabs-shell">
			<view class="service-tabbar">
				<view
					wx:for="{{serviceTabs}}"
					wx:key="title"
					class="service-tab {{activeServiceTab === index ? 'service-tab-active' : ''}}"
					bindtap="onServiceTabChange"
					data-index="{{index}}"
				>
					{{item.title}}
				</view>
			</view>
			<view class="service-body">
				<view wx:if="{{activeServiceItems.length}}" class="service-grid">
					<view
						wx:for="{{activeServiceItems}}"
						wx:key="title"
						class="service-grid-item"
						bindtap="onServiceItemTap"
						data-action="{{item.action}}"
					>
						<image class="service-grid-icon" src="{{item.icon}}" mode="heightFix" />
						<text class="service-grid-label">{{item.title}}</text>
					</view>
				</view>
				<view wx:else class="service-empty">
					<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
					<text>暂无相关服务</text>
				</view>
			</view>
		</view>
	</view>

	<image
		class="floating-guide"
		src="/assets/legacy-home/floating-guide.png"
		mode="widthFix"
		bindtap="onFloatingGuide"
	/>

	<!--
		保留旧首页二维码居中弹层的视觉位置，但不伪造可扫码图片。
		医院扫码字段、签名、有效期和撤销规则确认后，未来只替换弹层
		内部的安全 payload，不改变患者上下文门禁和遮罩交互。
	-->
	<view wx:if="{{showPatientQr}}" class="patient-qr-overlay" catchtap="closePatientQr">
		<view class="patient-qr-modal" catchtap="stopPatientQrPropagation">
			<view class="patient-qr-title">就诊人二维码</view>
			<view class="patient-qr-preview">
				<image
					src="/assets/legacy-home/patient-qr.svg"
					mode="aspectFit"
					class="patient-qr-preview-icon"
				/>
				<view class="patient-qr-locked">待开放</view>
			</view>
			<view class="patient-qr-name">{{patientQrName || "----"}}</view>
			<view class="patient-qr-card">就诊卡：{{patientQrCardNumber || "----"}}</view>
			<view class="patient-qr-notice">
				二维码服务正在完善中，当前暂不支持扫码使用。
			</view>
			<view class="patient-qr-status" bindtap="onPatientQrStatus">了解服务进度</view>
			<view class="patient-qr-close" bindtap="closePatientQr">关闭</view>
		</view>
	</view>

	</view>
</scroll-view>
