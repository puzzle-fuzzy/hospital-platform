<view class="page">
	<view class="card">
		<text class="eyebrow">HOSPITAL PLATFORM</text>
		<text class="title">医院服务平台</text>
		<view class="line"><text class="label">API</text><text>{{status}}</text></view>
		<view wx:if="{{service}}" class="line"><text class="label">服务</text><text>{{service}}</text></view>
		<view class="line"><text class="label">会话</text><text>{{sessionStatus}}</text></view>
		<button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onLogin">微信登录并加载就诊人</button>
		<button class="secondary" loading="{{syncingPatients}}" disabled="{{syncingPatients}}" bindtap="onSyncPatients">从医院同步就诊人</button>
		<button class="secondary" loading="{{loadingAppointments}}" disabled="{{loadingAppointments}}" bindtap="onLoadAppointments">查看预约科室与排班</button>
		<button class="secondary" bindtap="onRefresh">刷新</button>
		<text wx:if="{{error}}" class="error">{{error}}</text>
	</view>

	<view class="card patient-card">
		<view class="section-header">
			<text class="section-title">我的就诊人</text>
			<text class="section-hint">服务端归属</text>
		</view>
		<view wx:if="{{!hasPatients}}" class="empty">登录后显示已绑定的就诊人</view>
		<view wx:for="{{patients}}" wx:key="id" class="patient-row">
			<view>
				<text class="patient-name">{{item.displayName}}</text>
				<text class="patient-meta">{{item.relationship}} · {{item.cardNumberMasked}}</text>
			</view>
			<text class="patient-source">{{item.source}}</text>
		</view>
	</view>

	<view class="card appointment-card">
		<view class="section-header">
			<text class="section-title">预约目录</text>
			<text class="section-hint">服务端只读</text>
		</view>
		<view wx:if="{{!hasAppointmentData}}" class="empty">点击上方按钮读取科室和未来 7 天排班</view>
		<view wx:for="{{appointmentDepartments}}" wx:key="departmentId" class="appointment-row">
			<text>{{item.displayName}}</text>
			<text class="patient-meta">{{item.location || "院内"}}</text>
		</view>
		<view wx:for="{{appointmentSchedules}}" wx:key="scheduleId" class="appointment-row">
			<view>
				<text class="patient-name">{{item.workDate}} · {{item.shiftName}}</text>
				<text class="patient-meta">{{item.departmentName}} · {{item.doctorName}}</text>
			</view>
			<text class="patient-source">余 {{item.availableSlots}}</text>
		</view>
	</view>
</view>
