.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
	background: #ffffff;
}

/* 旧端 App.vue 的固定内容宽度，首页所有主区块都以 710rpx 对齐。 */
.con-main {
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.patient-area {
	position: relative;
	margin-top: 26rpx;
}

.patient-card {
	position: relative;
	/* 旧端的 w-580rpx 与 px-30rpx 都使用 content-box，外框实际宽度为 640rpx。 */
	box-sizing: content-box;
	z-index: 4;
	display: flex;
	align-items: center;
	gap: 20rpx;
	width: 580rpx;
	margin-right: auto;
	margin-left: auto;
	padding: 25rpx 30rpx;
	border-radius: 30rpx;
}

.bg1 {
	background-color: #3d6df6;
	overflow: hidden;
}

/* 本地图片必须通过 WXML image 加载，避免渲染层拒绝 WXSS url()。 */
.patient-card-background {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 0;
	display: block;
	border-radius: 30rpx;
}

.patient-qr {
	position: relative;
	z-index: 1;
	flex-shrink: 0;
	width: 70rpx;
	height: 70rpx;
}

.patient-card-copy {
	position: relative;
	z-index: 1;
	color: #ffffff;
	font-size: 28rpx;
}

.patient-name {
	font-size: 32rpx;
}

.patient-id {
	font-size: 28rpx;
}

.patient-change {
	position: absolute;
	z-index: 1;
	right: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 180rpx;
	height: 66rpx;
	border-radius: 33rpx 0 0 33rpx;
	background: radial-gradient(0% 0% at 0% 0%, #a1c0ff 16%, #e4ecff 100%), #ffffff;
	color: #3d6df6;
	font-size: 28rpx;
	white-space: nowrap;
}

.top-grid {
	position: relative;
	z-index: 2;
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	box-sizing: border-box;
	height: 220rpx;
	top: -15rpx;
	border: 1rpx solid #85aeff;
	border-radius: 25rpx;
	background: #f2f6ff;
}

.top-grid-item {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	gap: 20rpx;
}

.top-grid-icon {
	display: block;
	height: 75rpx;
}

.top-grid-label {
	color: #333333;
	font-size: 30rpx;
	line-height: 1.2;
	white-space: nowrap;
}

.quick-entry {
	margin-top: 20rpx;
}

.quick-entry-row {
	display: flex;
	align-items: flex-start;
	gap: 20rpx;
}

.quick-banner {
	flex: 0 0 340rpx;
	box-sizing: border-box;
	width: 340rpx;
	height: 306rpx;
	overflow: hidden;
	border-radius: 20rpx;
}

.quick-banner-image {
	display: block;
	width: 340rpx;
	height: 306rpx;
}

.quick-entry-right {
	display: flex;
	flex: 0 0 350rpx;
	align-items: flex-start;
	flex-direction: column;
	gap: 20rpx;
	width: 350rpx;
	height: 306rpx;
}

.quick-right-image {
	display: block;
	width: 350rpx;
	height: 94rpx;
}

.service-con {
	margin-top: 20rpx;
}

.service-tabs-shell {
	box-sizing: border-box;
	padding: 8rpx;
	border-radius: 20rpx;
	background: #f5f5f5;
}

.service-tabbar {
	display: flex;
	align-items: center;
}

.service-tab {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 190rpx;
	height: 80rpx;
	border-radius: 20rpx 20rpx 0 0;
	color: #333333;
	font-size: 30rpx;
	line-height: 1;
	transition: all 180ms ease;
}

.service-tab-active {
	background: #ffffff;
	font-weight: 700;
}

.service-body {
	box-sizing: border-box;
	min-height: 300rpx;
	padding: 60rpx 0;
	border-radius: 0 0 20rpx 20rpx;
	background: #ffffff;
}

.service-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	row-gap: 60rpx;
}

.service-grid-item {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	gap: 14rpx;
	min-width: 0;
}

.service-grid-icon {
	display: block;
	width: 64rpx;
	height: 64rpx;
}

.service-grid-label {
	max-width: 150rpx;
	overflow: hidden;
	color: #333333;
	font-size: 25rpx;
	line-height: 1.2;
	text-align: center;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.service-empty {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	color: #888888;
	font-size: 28rpx;
}

.service-empty image {
	display: block;
	width: 240rpx;
	margin-bottom: 12rpx;
}

.error-message {
	box-sizing: border-box;
	/* 提示位于首页首部；底部留白交给后面的 patient-area 控制。 */
	margin: 20rpx 20rpx 0;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	text-align: center;
}

.floating-guide {
	position: fixed;
	top: 50%;
	right: 0;
	z-index: 10;
	display: block;
	width: 150rpx;
	transform: translateY(-50%);
}

.legacy-tabbar {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 20;
	display: flex;
	align-items: flex-start;
	justify-content: space-around;
	box-sizing: border-box;
	height: calc(130rpx + env(safe-area-inset-bottom));
	padding-top: 6rpx;
	padding-bottom: env(safe-area-inset-bottom);
	border-top: 1rpx solid #eeeeee;
	background: #ffffff;
}

.legacy-tabbar-item {
	display: flex;
	align-items: center;
	justify-content: flex-start;
	flex-direction: column;
	width: 25%;
	gap: 6rpx;
	color: #2c2c2c;
	font-size: 20rpx;
	line-height: 1;
}

.legacy-tabbar-item-active {
	color: #3d6df6;
}

.legacy-tabbar-icon {
	display: block;
	width: 48rpx;
	height: 48rpx;
}
