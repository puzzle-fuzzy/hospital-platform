@import "../../styles/migration-surface.wxss";

.clinical-surface-scroll {
	height: 100vh;
	background: #f6f8fc;
}

.clinical-surface-page {
	box-sizing: border-box;
	min-height: 100%;
	padding: 28rpx 24rpx 52rpx;
}

.clinical-surface-hero,
.clinical-surface-card {
	box-sizing: border-box;
	border-radius: 20rpx;
	background: #fff;
	box-shadow: 0 8rpx 26rpx rgba(40, 74, 150, 0.06);
}

.clinical-surface-hero {
	display: flex;
	align-items: center;
	padding: 34rpx 30rpx;
}

.clinical-surface-icon {
	flex: 0 0 auto;
	width: 82rpx;
	height: 82rpx;
	margin-right: 22rpx;
}

.clinical-surface-hero-copy {
	display: flex;
	flex-direction: column;
}

.clinical-surface-title {
	color: #222b45;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 1.4;
}

.clinical-surface-label {
	display: inline-block;
	margin-top: 12rpx;
	color: #3d6df6;
	font-size: 24rpx;
	line-height: 1.5;
}

.clinical-surface-card {
	margin-top: 22rpx;
	padding: 30rpx;
}

.clinical-surface-card-title {
	display: block;
	color: #222b45;
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1.5;
}

.clinical-surface-card-copy {
	display: block;
	margin-top: 16rpx;
	color: #68738a;
	font-size: 27rpx;
	line-height: 1.7;
}

.clinical-surface-list {
	margin-top: 20rpx;
}

.clinical-surface-list-row {
	display: flex;
	align-items: flex-start;
	margin-top: 12rpx;
}

.clinical-surface-list-dot {
	width: 28rpx;
	color: #3d6df6;
	font-size: 30rpx;
	line-height: 1.4;
}

.clinical-surface-list-text {
	flex: 1;
	color: #68738a;
	font-size: 26rpx;
	line-height: 1.7;
}

.clinical-surface-coverage {
	display: block;
	margin-top: 22rpx;
	padding-top: 18rpx;
	border-top: 1rpx solid #edf0f5;
	color: #8791a5;
	font-size: 23rpx;
	line-height: 1.6;
}

.clinical-surface-primary-button,
.clinical-surface-secondary-button,
.clinical-surface-plain-button {
	box-sizing: border-box;
	width: 100%;
	border-radius: 16rpx;
	font-size: 28rpx;
	line-height: 84rpx;
}

.clinical-surface-primary-button {
	margin-top: 28rpx;
	background: #3d6df6;
	color: #fff;
}

.clinical-surface-secondary-button {
	margin: 24rpx 0 0;
	background: #edf3ff;
	color: #3d6df6;
}

.clinical-surface-plain-button {
	margin-top: 14rpx;
	background: transparent;
	color: #68738a;
}
