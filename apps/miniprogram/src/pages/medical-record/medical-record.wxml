<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="medical-record-page">
		<!-- 网络异常固定在顶部，不让用户滚动后才看到原因。 -->
		<view wx:if="{{error}}" class="clinical-query-error-message">{{error}}</view>

		<!-- 与旧端 electronic_record.vue 保持一致：就诊人与院区两行选择器。 -->
		<view class="medical-record-selector-card">
			<view class="medical-record-selector-row medical-record-selector-row-border" bindtap="onChangePatient">
				<text class="medical-record-selector-label">就诊人</text>
				<view class="medical-record-selector-value">
					<text wx:if="{{selectedPatient}}" class="medical-record-selector-name">{{selectedPatient.displayName}}</text>
					<text wx:elif="{{loading}}" class="medical-record-selector-name">正在加载就诊人...</text>
					<text wx:elif="{{canSelectPatient}}" class="medical-record-selector-name">请先选择就诊人</text>
					<text wx:else class="medical-record-selector-name">当前就诊人信息暂时无法读取</text>
					<text wx:if="{{selectedPatient}}" class="medical-record-selector-card-number">（{{selectedPatient.cardNumberMasked}}）</text>
					<image class="medical-record-selector-arrow" src="/assets/legacy-user/selector-arrow-right.svg" mode="aspectFit" />
				</view>
			</view>
			<view class="medical-record-selector-row">
				<text class="medical-record-selector-label">当前院区</text>
				<view class="medical-record-selector-value">
					<text>高平市人民医院</text>
					<image class="medical-record-selector-arrow" src="/assets/legacy-user/selector-arrow-right.svg" mode="aspectFit" />
				</view>
			</view>
		</view>

		<view class="medical-record-content">
			<!-- 固定高度复用同一个状态外壳，避免加载态到空态的跳变。 -->
			<view wx:if="{{queryState !== 'ready'}}" class="clinical-query-state query-state-shell query-state-shell-column">
				<block wx:if="{{queryState === 'loading'}}">
					<view class="clinical-query-loading-icon" aria-hidden="true"></view>
					<text class="clinical-query-state-title">正在查询记录...</text>
				</block>
				<block wx:elif="{{queryState === 'error'}}">
					<view class="clinical-query-error-icon" aria-hidden="true">!</view>
					<text class="clinical-query-state-title">门诊病历暂时无法获取</text>
					<text class="clinical-query-state-hint">请稍后再试</text>
					<view class="clinical-query-state-action" bindtap="onRetry">再试一次</view>
					<view wx:if="{{canSelectPatient}}" class="clinical-query-state-action" bindtap="onChangePatient">选择就诊人</view>
				</block>
				<block wx:else>
					<image class="clinical-query-state-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
					<text class="clinical-query-state-title">未查询到您的记录</text>
				</block>
			</view>

			<view wx:elif="{{visibleRecords.length}}" class="medical-record-list">
				<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="medical-record-card">
					<view class="medical-record-header">
						<view class="medical-record-main">
							<text class="medical-record-title">{{item.departmentName || "科室"}} · {{item.doctorName || "医生"}}</text>
							<view class="medical-record-subtitle">
								<text wx:if="{{item.hospitalName}}">{{item.hospitalName}}</text>
								<text wx:if="{{item.clinicTypeName}}"> {{item.clinicTypeName}}</text>
								<text wx:if="{{item.chargeClassName}}"> · {{item.chargeClassName}}</text>
							</view>
						</view>
						<text class="medical-record-visit-time">{{item.visitTime}}</text>
					</view>
					<view wx:if="{{item.diagnosis}}" class="medical-record-diagnosis">
						<text class="medical-record-diagnosis-label">诊断结果：</text>
						<text class="medical-record-diagnosis-value">{{item.diagnosis}}</text>
					</view>
				</view>
				<view wx:if="{{hasMoreRecords}}" class="medical-record-load-more" bindtap="onLoadMore">加载更多记录</view>
			</view>
		</view>
	</view>
</scroll-view>
