<scroll-view class="clinical-surface-scroll" scroll-y="true" enhanced="true">
	<view class="clinical-surface-page">
		<view class="clinical-surface-hero">
			<image class="clinical-surface-icon" src="{{icon}}" mode="aspectFit" />
			<view class="clinical-surface-hero-copy">
				<text class="clinical-surface-title">{{title}}</text>
				<text class="clinical-surface-label">{{surfaceLabel}}</text>
			</view>
		</view>

		<view class="clinical-surface-card">
			<text class="clinical-surface-card-title">{{scopeTitle}}</text>
			<text class="clinical-surface-card-copy">{{scopeDescription}}</text>
		</view>

		<view class="migration-surface-patient-card">
			<view class="migration-surface-patient-copy">
				<text class="migration-surface-patient-label">当前就诊人</text>
				<block wx:if="{{patientContextLoading}}">
					<text class="migration-surface-patient-name">正在获取就诊人...</text>
					<text class="migration-surface-patient-meta">当前只读取已确认的患者目录</text>
				</block>
				<block wx:elif="{{patientContextError}}">
					<text class="migration-surface-patient-error">{{patientContextError}}</text>
					<button class="migration-surface-patient-retry" bindtap="onRetry">重新读取</button>
				</block>
				<block wx:else>
					<text class="migration-surface-patient-name">{{currentPatientName}}</text>
					<text class="migration-surface-patient-meta">{{currentPatientCardLabel}}</text>
				</block>
			</view>
			<button class="migration-surface-patient-action" bindtap="onOpenPatientSelector">{{patientActionLabel}}</button>
		</view>

		<view class="clinical-surface-card">
			<text class="clinical-surface-card-title">当前迁移状态</text>
			<text class="clinical-surface-card-copy">{{description}}</text>
			<view class="clinical-surface-list">
				<view wx:for="{{boundaryItems}}" wx:key="*this" class="clinical-surface-list-row">
					<text class="clinical-surface-list-dot">·</text>
					<text class="clinical-surface-list-text">{{item}}</text>
				</view>
			</view>
		</view>

		<view class="clinical-surface-card">
			<text class="clinical-surface-card-title">开放前还需确认</text>
			<view class="clinical-surface-list">
				<view wx:for="{{contractItems}}" wx:key="*this" class="clinical-surface-list-row">
					<text class="clinical-surface-list-dot">·</text>
					<text class="clinical-surface-list-text">{{item}}</text>
				</view>
			</view>
			<text class="clinical-surface-coverage">{{coverageLabel}}</text>
		</view>

		<button class="clinical-surface-primary-button" bindtap="onOpenMigrationStatus">查看完整迁移说明</button>
		<button class="clinical-surface-plain-button" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
