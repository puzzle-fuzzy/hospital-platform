<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<patient-hospital-context bindchangepatient="onChangePatient" />
	<view class="medical-record-page">
		<view class="medical-record-boundary">
			当前仅展示近 30 天门诊就诊摘要；病历正文、附件和住院病历尚未开放。
		</view>

		<view class="medical-record-content">
			<!-- 固定高度复用同一个状态外壳，避免加载态到空态的跳变。 -->
			<view wx:if="{{loading || error || !visibleRecords.length}}" class="medical-record-state query-state-shell query-state-shell-column">
				<block wx:if="{{loading}}">
					<view class="medical-record-loading-icon" aria-hidden="true"></view>
					<text class="medical-record-state-title">加载中...</text>
				</block>
				<block wx:elif="{{error}}">
					<image class="medical-record-state-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
					<text class="medical-record-state-title">本次门诊病历未加载成功</text>
					<text class="medical-record-state-hint">{{error}}</text>
					<view wx:if="{{canSelectPatient}}" class="medical-record-state-action medical-record-state-action-secondary" bindtap="onChangePatient">选择就诊人</view>
					<view class="medical-record-state-action" bindtap="onRetry">重新加载</view>
				</block>
				<block wx:else>
					<image class="medical-record-state-image" src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
					<text class="medical-record-state-title">暂无门诊病历</text>
					<text class="medical-record-state-hint">当前没有可展示的门诊病历记录</text>
				</block>
			</view>

			<view wx:elif="{{visibleRecords.length}}" class="medical-record-list">
				<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="medical-record-card">
					<view class="medical-record-header">
						<view class="medical-record-main">
							<text class="medical-record-title">{{item.departmentName || "科室"}} · {{item.doctorName || "医生"}}</text>
							<view class="medical-record-subtitle">
								<text wx:if="{{item.hospitalName}}">{{item.hospitalName}}</text>
								<text wx:if="{{item.clinicTypeName}}"> {{item.clinicTypeName}}</text>
								<text wx:if="{{item.chargeClassName}}"> · {{item.chargeClassName}}</text>
							</view>
						</view>
						<text class="medical-record-visit-time">{{item.visitTime}}</text>
					</view>
					<view wx:if="{{item.patientName || item.patientSex || item.patientAge || item.maritalStatus}}" class="medical-record-patient-snapshot">
						<text wx:if="{{item.patientName}}">姓名：{{item.patientName}}</text>
						<text wx:if="{{item.patientSex}}">性别：{{item.patientSex}}</text>
						<text wx:if="{{item.patientAge}}">年龄：{{item.patientAge}}</text>
						<text wx:if="{{item.maritalStatus}}">婚姻：{{item.maritalStatus}}</text>
					</view>
					<view wx:if="{{item.diagnosis}}" class="medical-record-diagnosis">
						<text class="medical-record-diagnosis-label">诊断结果：</text>
						<text class="medical-record-diagnosis-value">{{item.diagnosis}}</text>
					</view>
				</view>
				<view wx:if="{{hasMoreRecords}}" class="medical-record-load-more" bindtap="onLoadMore">加载更多记录</view>
			</view>
		</view>
	</view>
</scroll-view>
