<scroll-view class="my-doctor-detail-scroll" scroll-y="true" enhanced="true" scroll-into-view="{{scheduleScrollIntoView}}">
	<view class="my-doctor-detail-page">
		<view wx:if="{{loading}}" class="detail-state">
			<view class="detail-spinner"></view>
			<text>正在加载医生信息...</text>
		</view>

		<view wx:elif="{{error}}" class="detail-state detail-state-error">
			<image class="detail-state-icon" src="/assets/legacy-user/doctor.svg" mode="aspectFit" />
			<text>{{error}}</text>
			<view class="detail-retry" bindtap="onRetry">重新加载</view>
		</view>

		<block wx:else>
			<view class="doctor-profile-hero">
				<view class="doctor-profile-background" aria-hidden="true"></view>
				<view class="doctor-profile-card">
					<doctor-avatar class="doctor-profile-avatar" src="{{doctor.doctorAvatarUrl}}" label="{{doctor.doctorName}}的头像" />
					<button
						class="doctor-follow-button {{followed ? 'doctor-followed' : ''}}"
						size="mini"
						disabled="{{actionLoading}}"
						bindtap="onFollowTap"
						aria-label="{{followed ? '取消关注该医生' : '关注该医生'}}"
					>
						<text class="doctor-follow-heart" aria-hidden="true">{{followed ? '♥' : '♡'}}</text>
						<text>{{actionLoading ? '处理中' : followed ? '已关注' : '关注'}}</text>
					</button>
					<view class="doctor-profile-name-row">
						<text class="doctor-profile-name">{{doctor.doctorName}}</text>
						<text wx:if="{{doctor.titleName}}" class="doctor-profile-title">{{doctor.titleName}}</text>
					</view>
					<view wx:if="{{doctor.introduction || doctor.expertise}}" class="doctor-profile-summary">
						<text class="doctor-summary-label">{{doctor.expertise ? '擅长领域' : '个人简介'}}</text>
						<view class="doctor-summary-body">
							<text class="doctor-introduction-copy">{{doctor.expertise || doctor.introduction}}</text>
							<button class="doctor-profile-link" size="mini" bindtap="onProfileTap">查看简介 <text aria-hidden="true">›</text></button>
						</view>
					</view>
					<text wx:else class="doctor-introduction-empty">医生简介暂未提供</text>
				</view>
			</view>

			<view id="doctor-schedule-section" class="doctor-schedule-card">
				<view class="detail-section-heading">
					<view class="detail-section-marker" aria-hidden="true"></view>
					<text class="detail-section-title">门诊排班</text>
				</view>
				<view class="doctor-hospital-heading">
					<text class="doctor-hospital-tab">{{doctor.hospitalAreaName || '高平市人民医院'}}</text>
					<text wx:if="{{doctor.departmentLocation || !schedules.length}}" class="doctor-location-caption">{{doctor.departmentName}}<text wx:if="{{doctor.departmentLocation}}"> · {{doctor.departmentLocation}}</text></text>
				</view>
				<scroll-view wx:if="{{dateOptions.length}}" class="doctor-date-scroll" scroll-x="true" show-scrollbar="false">
					<view class="doctor-date-list">
						<view
							wx:for="{{dateOptions}}"
							wx:key="workDate"
							class="doctor-date-item {{item.workDate === selectedDate ? 'doctor-date-item-active' : ''}}"
							bindtap="onDateTap"
							data-date="{{item.workDate}}"
							role="button"
							aria-label="{{item.dateLabel + ' ' + item.weekdayLabel}}"
							aria-pressed="{{item.workDate === selectedDate}}"
						>
							<text class="doctor-date-weekday">{{item.weekdayLabel}}</text>
							<text>{{item.dateLabel}}</text>
						</view>
					</view>
				</scroll-view>
				<view wx:if="{{scheduleLoading}}" class="schedule-state"><text>正在获取排班...</text></view>
				<view wx:elif="{{visibleSchedules.length}}" class="doctor-schedule-list">
					<view
						wx:for="{{visibleSchedules}}"
						wx:key="scheduleId"
						class="doctor-schedule-row"
						bindtap="onScheduleTap"
						data-schedule-id="{{item.scheduleId}}"
					>
						<view class="doctor-schedule-period"><text>{{item.shiftName}}</text></view>
						<view class="doctor-schedule-copy">
							<text class="doctor-schedule-department">{{item.hospitalAreaName || doctor.hospitalAreaName || '高平市人民医院'}}-{{item.departmentName}}</text>
							<view wx:if="{{item.registrationClassName}}" class="doctor-schedule-tags">
								<text class="doctor-schedule-registration-class">{{item.registrationClassName}}</text>
							</view>
							<text class="doctor-schedule-doctor">{{item.doctorName}}</text>
							<text wx:if="{{item.startTime}}" class="doctor-schedule-time">{{item.startTime}}<text wx:if="{{item.endTime}}"> - {{item.endTime}}</text></text>
							<text wx:else class="doctor-schedule-time">具体时段以医院排班为准</text>
						</view>
						<view class="doctor-schedule-action">
							<text wx:if="{{item.availabilityStatus === 'stopped'}}" class="doctor-schedule-slots">已停诊</text>
							<text wx:elif="{{item.availabilityStatus !== 'open'}}" class="doctor-schedule-slots">状态待确认</text>
							<text wx:else class="doctor-schedule-slots {{item.availableSlots > 0 ? 'doctor-slots-available' : ''}}">{{item.availableSlots > 0 ? '余 ' + item.availableSlots + ' 号' : '已约满'}}</text>
							<button
								class="doctor-schedule-booking"
								size="mini"
								disabled="{{item.availabilityStatus !== 'open' || item.availableSlots <= 0}}"
								catchtap="onScheduleTap"
								data-schedule-id="{{item.scheduleId}}"
							>预约</button>
						</view>
					</view>
				</view>
				<view wx:elif="{{dateOptions.length}}" class="schedule-state"><text>当天暂无出诊安排</text></view>
				<view wx:else class="schedule-state"><text>未来七天暂无排班</text></view>
			</view>

			<view class="doctor-online-services">
				<view class="detail-section-heading">
					<view class="detail-section-marker" aria-hidden="true"></view>
					<text class="detail-section-title">在线服务</text>
				</view>
				<view class="doctor-consult-tags">
					<button class="doctor-consult-tag" size="mini" bindtap="onConsultTap"><text class="doctor-consult-name">图文问诊</text><text class="doctor-consult-state">暂未开放</text></button>
					<button class="doctor-consult-tag" size="mini" bindtap="onConsultTap"><text class="doctor-consult-name">视频问诊</text><text class="doctor-consult-state">暂未开放</text></button>
				</view>
			</view>
			<text class="detail-note">号源和出诊时间以医院实时安排为准，点击有余号的时段查看预约信息。</text>
		</block>

		<view wx:if="{{showProfile}}" class="doctor-profile-modal">
			<view class="doctor-profile-modal-panel">
				<view class="doctor-profile-modal-header">
					<text class="doctor-profile-modal-title">医生简介</text>
					<text class="doctor-profile-modal-close" bindtap="onProfileClose">关闭</text>
				</view>
				<scroll-view class="doctor-profile-modal-scroll" scroll-y="true">
					<view wx:if="{{doctor.introduction}}" class="doctor-profile-modal-section">
						<text class="doctor-profile-modal-section-title">个人介绍</text>
						<text class="doctor-profile-modal-copy">{{doctor.introduction}}</text>
					</view>
					<view wx:if="{{doctor.expertise}}" class="doctor-profile-modal-section">
						<text class="doctor-profile-modal-section-title">擅长领域</text>
						<text class="doctor-profile-modal-copy">{{doctor.expertise}}</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</scroll-view>
