page {
	background: #f8f8f8;
}

.my-doctor-detail-scroll {
	height: 100vh;
	background: #f8f8f8;
}

.my-doctor-detail-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
	background: #ffffff;
}

/* 蓝湖 750px 画板：背景 270rpx，白卡从 70rpx 开始，头像悬浮于卡片顶边。 */
.doctor-profile-hero {
	position: relative;
	padding: 70rpx 30rpx 0;
}

.doctor-profile-background {
	position: absolute;
	top: 0;
	right: 0;
	left: 0;
	height: 270rpx;
	background: radial-gradient(ellipse at 44% 20%, rgba(255, 255, 255, 0.96) 0%, rgba(239, 248, 255, 0.7) 32%, transparent 72%), linear-gradient(150deg, #c7f5ff 0%, #c3d8f5 55%, #6bb7ee 100%);
}

.doctor-profile-card {
	position: relative;
	box-sizing: border-box;
	min-height: 272rpx;
	padding: 100rpx 30rpx 16rpx;
	border-radius: 12rpx;
	background: #ffffff;
	box-shadow: 0 10rpx 28rpx rgba(40, 67, 118, 0.05);
}

.doctor-profile-avatar {
	position: absolute;
	top: -38rpx;
	left: 30rpx;
	display: block;
	width: 92rpx;
	height: 92rpx;
	border-radius: 50%;
	background: #eef3fa;
}

/* 覆盖 v2 原生按钮的尺寸和 auto 边距，限定在名片页的小按钮。 */
button.doctor-follow-button[size="mini"] {
	position: absolute;
	top: -30rpx;
	right: 36rpx;
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: center;
	gap: 10rpx;
	width: 148rpx;
	min-width: 0;
	height: 60rpx;
	margin: 0;
	padding: 0;
	border-radius: 30rpx;
	background: #d87518;
	color: #ffffff;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 60rpx;
	white-space: nowrap;
}

.doctor-follow-heart {
	font-size: 36rpx;
	font-weight: 400;
	line-height: 1;
}

button.doctor-follow-button.doctor-followed[size="mini"] {
	background: #fff1e2;
	color: #a7530c;
}

button.doctor-follow-button[size="mini"][disabled] {
	opacity: 0.7;
}

.doctor-profile-name-row {
	display: flex;
	min-width: 0;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 6rpx 14rpx;
}

.doctor-profile-name {
	max-width: 100%;
	color: #111111;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 48rpx;
	word-break: break-all;
}

.doctor-profile-title {
	color: #222222;
	font-size: 24rpx;
	line-height: 36rpx;
	word-break: break-all;
}

.doctor-profile-summary {
	display: flex;
	align-items: flex-start;
	gap: 16rpx;
	margin-top: 12rpx;
}

.doctor-summary-label {
	flex: 0 0 118rpx;
	color: #136fd7;
	font-size: 26rpx;
	font-style: italic;
	font-weight: 700;
	line-height: 48rpx;
}

.doctor-summary-body {
	position: relative;
	min-width: 0;
	flex: 1;
	min-height: 96rpx;
}

.doctor-introduction-copy {
	display: -webkit-box;
	max-height: 96rpx;
	overflow: hidden;
	color: #757575;
	font-size: 26rpx;
	line-height: 48rpx;
	word-break: break-all;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
}

button.doctor-profile-link[size="mini"] {
	position: absolute;
	right: -2rpx;
	bottom: 0;
	box-sizing: border-box;
	display: block;
	width: auto;
	min-width: 0;
	height: 48rpx;
	margin: 0;
	padding: 0 0 0 24rpx;
	border-radius: 0;
	background: linear-gradient(90deg, rgba(255, 255, 255, 0), #ffffff 18rpx);
	color: #386ec9;
	font-size: 26rpx;
	line-height: 48rpx;
}

.doctor-introduction-empty {
	display: block;
	margin-top: 12rpx;
	color: #757575;
	font-size: 26rpx;
	line-height: 48rpx;
}

.doctor-schedule-card {
	margin-top: 30rpx;
	background: #ffffff;
}

.detail-section-heading {
	display: flex;
	align-items: center;
	gap: 18rpx;
	min-height: 48rpx;
}

.detail-section-marker {
	width: 10rpx;
	height: 36rpx;
	flex: 0 0 10rpx;
	background: linear-gradient(#83d0ff, #1474ff);
}

.detail-section-title {
	color: #111111;
	font-size: 34rpx;
	font-weight: 400;
	line-height: 48rpx;
}

.doctor-hospital-heading {
	margin-top: 8rpx;
	padding: 0 30rpx;
	border-bottom: 2rpx solid #e8e8e8;
}

.doctor-hospital-tab {
	display: inline-block;
	box-sizing: border-box;
	max-width: 100%;
	padding: 4rpx 0 28rpx;
	border-bottom: 2rpx solid #4c8fff;
	color: #386ec9;
	font-size: 26rpx;
	line-height: 38rpx;
	word-break: break-all;
}

.doctor-location-caption {
	display: block;
	padding: 0 0 18rpx;
	color: #757575;
	font-size: 24rpx;
	line-height: 36rpx;
	word-break: break-all;
}

.doctor-date-scroll {
	width: 100%;
	padding: 36rpx 0;
	white-space: nowrap;
}

.doctor-date-list {
	display: flex;
}

.doctor-date-item {
	display: flex;
	box-sizing: border-box;
	width: 150rpx;
	height: 86rpx;
	flex: 0 0 150rpx;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	color: #222222;
	font-size: 28rpx;
	line-height: 44rpx;
}

.doctor-date-item-active {
	background: #e9f1ff;
	color: #386ec9;
}

.doctor-date-weekday {
	display: block;
}

.doctor-schedule-list {
	border-top: 2rpx solid #e8e8e8;
}

.doctor-schedule-row {
	display: flex;
	box-sizing: border-box;
	align-items: stretch;
	min-height: 194rpx;
	border-bottom: 2rpx solid #e8e8e8;
}

.doctor-schedule-period {
	display: flex;
	width: 54rpx;
	flex: 0 0 54rpx;
	align-items: center;
	justify-content: center;
	background: #e9f1ff;
	color: #386ec9;
	font-size: 26rpx;
	line-height: 38rpx;
	text-align: center;
	word-break: break-all;
}

.doctor-schedule-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
	justify-content: center;
	padding: 10rpx 12rpx 10rpx 20rpx;
}

.doctor-schedule-department {
	color: #222222;
	font-size: 28rpx;
	line-height: 44rpx;
	word-break: break-all;
}

.doctor-schedule-tags {
	display: flex;
	flex-wrap: wrap;
	margin: 10rpx 0 4rpx;
}

.doctor-schedule-registration-class {
	max-width: 100%;
	padding: 0 10rpx;
	border-radius: 4rpx;
	background: #f9ecd9;
	color: #835a34;
	font-size: 24rpx;
	line-height: 36rpx;
	word-break: break-all;
}

.doctor-schedule-doctor,
.doctor-schedule-time {
	display: block;
	color: #333333;
	font-size: 24rpx;
	line-height: 34rpx;
	word-break: break-all;
}

.doctor-schedule-time {
	color: #757575;
	font-size: 22rpx;
}

.doctor-schedule-action {
	display: flex;
	box-sizing: border-box;
	width: 150rpx;
	flex: 0 0 150rpx;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 12rpx;
	padding: 14rpx 18rpx 14rpx 0;
}

.doctor-schedule-slots {
	color: #757575;
	font-size: 24rpx;
	line-height: 36rpx;
	text-align: center;
}

.doctor-slots-available {
	color: #c6532e;
}

button.doctor-schedule-booking[size="mini"] {
	box-sizing: border-box;
	display: flex;
	width: 106rpx;
	min-width: 0;
	max-width: 100%;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	height: 54rpx;
	margin: 0;
	padding: 0;
	border-radius: 27rpx;
	background: #4c8fff;
	color: #ffffff;
	font-size: 28rpx;
	font-weight: 600;
	line-height: 54rpx;
	white-space: nowrap;
}

button.doctor-schedule-booking[size="mini"][disabled] {
	background: #eeeeee;
	color: #757575;
}

.doctor-online-services {
	box-sizing: border-box;
	min-height: 306rpx;
	padding-top: 32rpx;
	background: #ffffff;
}

.doctor-consult-tags {
	display: flex;
	flex-wrap: wrap;
	justify-content: flex-start;
	gap: 14rpx;
	padding: 34rpx 30rpx 40rpx;
}

button.doctor-consult-tag[size="mini"] {
	display: flex;
	box-sizing: border-box;
	width: 164rpx;
	min-height: 110rpx;
	flex: 0 0 164rpx;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 12rpx;
	margin: 0;
	padding: 12rpx 8rpx;
	border: 2rpx solid #eeeeee;
	border-radius: 10rpx;
	background: #ffffff;
	line-height: 36rpx;
}

.doctor-consult-name {
	color: #111111;
	font-size: 28rpx;
	font-weight: 600;
}

.doctor-consult-state {
	color: #757575;
	font-size: 24rpx;
}

.detail-note {
	display: block;
	padding: 20rpx 30rpx;
	background: #f8f8f8;
	color: #757575;
	font-size: 22rpx;
	line-height: 34rpx;
}

.schedule-state,
.detail-state {
	display: flex;
	box-sizing: border-box;
	align-items: center;
	justify-content: center;
	padding: 40rpx;
	color: #757575;
	font-size: 26rpx;
	line-height: 40rpx;
	text-align: center;
}

.schedule-state {
	min-height: 194rpx;
	border-top: 2rpx solid #e8e8e8;
	border-bottom: 2rpx solid #e8e8e8;
}

.detail-state {
	min-height: 600rpx;
	flex-direction: column;
	gap: 24rpx;
}

.detail-state-icon {
	width: 112rpx;
	height: 112rpx;
}

.detail-retry {
	padding: 12rpx 34rpx;
	border-radius: 30rpx;
	background: #e9f1ff;
	color: #386ec9;
}

.detail-spinner {
	box-sizing: border-box;
	width: 50rpx;
	height: 50rpx;
	border: 6rpx solid #e9f1ff;
	border-top-color: #4c8fff;
	border-radius: 50%;
	animation: detail-spin 900ms linear infinite;
}

@keyframes detail-spin {
	to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
	.detail-spinner { animation: none; }
}

.doctor-profile-modal {
	position: fixed;
	z-index: 20;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	display: flex;
	align-items: flex-end;
	background: rgba(24, 34, 54, 0.42);
}

.doctor-profile-modal-panel {
	box-sizing: border-box;
	width: 100%;
	max-height: 80vh;
	padding-bottom: env(safe-area-inset-bottom);
	border-radius: 24rpx 24rpx 0 0;
	background: #ffffff;
}

.doctor-profile-modal-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 28rpx;
	border-bottom: 2rpx solid #eeeeee;
}

.doctor-profile-modal-title {
	color: #222222;
	font-size: 32rpx;
	font-weight: 600;
}

.doctor-profile-modal-close {
	color: #386ec9;
	font-size: 26rpx;
}

.doctor-profile-modal-scroll {
	box-sizing: border-box;
	max-height: calc(80vh - 96rpx);
	padding: 26rpx 28rpx 36rpx;
}

.doctor-profile-modal-section + .doctor-profile-modal-section {
	margin-top: 26rpx;
}

.doctor-profile-modal-section-title,
.doctor-profile-modal-copy {
	display: block;
}

.doctor-profile-modal-section-title {
	color: #222222;
	font-size: 28rpx;
	font-weight: 600;
}

.doctor-profile-modal-copy {
	margin-top: 12rpx;
	color: #666666;
	font-size: 26rpx;
	line-height: 1.7;
	word-break: break-all;
}
