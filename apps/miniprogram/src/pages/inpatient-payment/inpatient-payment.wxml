<scroll-view class="inpatient-payment-scroll" scroll-y="true" enhanced="true">
	<patient-hospital-context bindchangepatient="onChangePatient" />
	<view class="inpatient-payment-page">
		<view class="inpatient-payment-notice">请核对患者信息后再进行缴费！</view>

		<view class="inpatient-payment-card">
			<view class="inpatient-payment-field inpatient-payment-field-border">
				<view class="inpatient-payment-label"><text class="inpatient-payment-required">*</text>就诊人姓名</view>
				<input class="inpatient-payment-input" value="{{patientName}}" bindinput="onPatientInput" placeholder="请输入住院就诊人姓名" />
			</view>
			<view class="inpatient-payment-field">
				<view class="inpatient-payment-label"><text class="inpatient-payment-required">*</text>手机号码</view>
				<input class="inpatient-payment-input" type="number" value="{{mobile}}" bindinput="onMobileInput" maxlength="11" placeholder="请输入联系手机号" />
			</view>
		</view>

		<view wx:if="{{message}}" class="inpatient-payment-message inpatient-payment-message-{{messageKind}}">{{message}}</view>
		<button class="inpatient-payment-primary" loading="{{querying}}" bindtap="onQuery">查询</button>
		<button class="inpatient-payment-plain" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
