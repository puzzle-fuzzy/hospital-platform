<scroll-view class="tab-page-scroll" scroll-y="true" enhanced="true">
	<view class="consult-page">
		<view class="consult-intro">
			<text class="consult-intro-title">电子导诊单</text>
			<text class="consult-intro-copy">仅显示 30 天内导诊单信息，取药、检查地点及执行状态仅供参考。</text>
		</view>

		<view class="consult-patient-card">
			<image class="consult-patient-icon" src="/assets/legacy-home/patient-qr.svg" mode="aspectFit" />
			<view class="consult-patient-copy">
				<text class="consult-patient-name">{{selectedPatientName}}</text>
				<text class="consult-patient-id">{{selectedPatientIdLabel}}</text>
			</view>
			<button class="consult-patient-switch" bindtap="onChangePatient">切换就诊人</button>
		</view>

		<view wx:if="{{!visibleRecords.length}}" class="consult-state query-state-shell query-state-shell-column">
			<block wx:if="{{loading}}">
				<text class="consult-state-title">正在获取导诊信息...</text>
				<text class="consult-state-hint">页面结构已准备好，请稍候</text>
			</block>
			<block wx:elif="{{error}}">
				<text class="consult-state-title">{{error}}</text>
				<button class="consult-retry" bindtap="onRetry">重新查询</button>
			</block>
			<block wx:else>
				<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
				<text class="consult-state-title">未查询到您的记录</text>
				<text class="consult-state-hint">当前仅展示已确认的预约摘要</text>
			</block>
		</view>

		<view wx:if="{{!loading && !error && visibleRecords.length}}" class="consult-record-list">
			<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="consult-record-card">
				<view class="consult-record-header">
					<view class="consult-record-title-wrap">
						<text class="consult-record-department">{{item.departmentName || "科室"}}</text>
						<text class="consult-record-caption">{{item.sourceTypeLabel}}</text>
					</view>
					<text class="consult-record-status {{item.statusClass}}">{{item.statusLabel}}</text>
				</view>
				<view class="consult-record-schedule">
					<text class="consult-record-label">就诊时间</text>
					<text class="consult-record-date">{{item.workDate}}</text>
					<text wx:if="{{item.workTime}}" class="consult-record-time">{{item.workTime}}</text>
				</view>
				<view class="consult-record-meta">
					<text wx:if="{{item.serialNumber}}">序号：{{item.serialNumber}}</text>
					<text wx:if="{{item.location}}">地点：{{item.location}}</text>
				</view>
			</view>
			<view wx:if="{{hasMoreRecords}}" class="consult-record-load-more" bindtap="onLoadMore">加载更多导诊记录</view>
			<text class="consult-record-footnote">当前为旧服务兼容版，实时导诊与执行状态仍未开放。</text>
		</view>

		<view class="consult-related-actions">
			<view class="consult-related-action" bindtap="onOpenBill">
				<image class="consult-related-action-icon" src="/assets/legacy-home/top-payment.svg" mode="aspectFit" />
				<text>缴费账单</text>
			</view>
			<view class="consult-related-action" bindtap="onOpenMedicalRecord">
				<image class="consult-related-action-icon" src="/assets/legacy-home/top-record.svg" mode="aspectFit" />
				<text>病历查询</text>
			</view>
			<view class="consult-related-action" bindtap="onOpenInpatientBooking">
				<image class="consult-related-action-icon" src="/assets/legacy-home/service-inpatient.svg" mode="aspectFit" />
				<text>住院预约</text>
			</view>
		</view>
	</view>
</scroll-view>
