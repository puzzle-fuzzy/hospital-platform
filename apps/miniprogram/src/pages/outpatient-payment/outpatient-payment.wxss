page {
	background: #f8f8f8;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.error-message,
.selector-card,
.tabs,
.record-list,
.state-card,
.readonly-note {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.error-message {
	margin-bottom: 18rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

/* 旧端 PatientHospitalSelector：白色两行、分割线和右侧灰色箭头。 */
.selector-card {
	overflow: hidden;
	background: #ffffff;
}

.selector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	padding: 26rpx 30rpx;
	color: #333333;
}

.selector-row-border {
	border-bottom: 1rpx solid #f0f0f0;
}

.selector-label {
	flex: 0 0 150rpx;
	font-size: 28rpx;
}

.selector-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
	color: #333333;
	font-size: 30rpx;
	text-align: right;
}

.selector-name {
	overflow: hidden;
	min-width: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.selector-card-number {
	margin-left: 10rpx;
	color: #999999;
	font-size: 23rpx;
}

.selector-arrow-image {
	display: block;
	margin-left: 14rpx;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
}

.tabs {
	display: flex;
	margin-top: 18rpx;
	background: #ffffff;
	border-bottom: 1rpx solid #f0f0f0;
}

.tab {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 50%;
	height: 88rpx;
	color: #666666;
	font-size: 29rpx;
}

.tab-active {
	color: #3d6df6;
	font-weight: 700;
}

.tab-active::after {
	position: absolute;
	bottom: 0;
	left: 50%;
	width: 120rpx;
	height: 6rpx;
	border-radius: 6rpx;
	background: #3d6df6;
	content: "";
	transform: translateX(-50%);
}

.record-list {
	padding-top: 20rpx;
}

.record-card {
	box-sizing: border-box;
	margin-bottom: 16rpx;
	padding: 24rpx;
	border-radius: 16rpx;
	background: #ffffff;
}

.record-card-paid {
	background: #f5f5f5;
}

.record-card-refunding {
	background: #fffaf0;
}

.record-header,
.record-line {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-width: 0;
}

.record-hospital {
	overflow: hidden;
	color: #222222;
	font-size: 29rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.record-arrow-image {
	display: block;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
	margin-left: 14rpx;
}

.record-line {
	margin-top: 16rpx;
	color: #777777;
	font-size: 25rpx;
}

.record-line-last {
	margin-bottom: 2rpx;
}

.record-label {
	flex: 0 0 160rpx;
}

.record-value,
.record-time {
	overflow: hidden;
	flex: 1;
	color: #333333;
	text-align: right;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.record-amount {
	flex: 1;
	color: #ee875e;
	font-size: 29rpx;
	font-weight: 700;
	text-align: right;
}

.record-time {
	color: #ee875e;
}

.record-status-wrap {
	display: flex;
	justify-content: flex-end;
	margin-top: 18rpx;
	padding-top: 16rpx;
	border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.record-status {
	flex-shrink: 0;
	padding: 6rpx 12rpx;
	border-radius: 8rpx;
	background: #f2f6ff;
	color: #3d6df6;
	font-size: 23rpx;
}

.record-status-refunding {
	background: #fff1d6;
	color: #b66a00;
}

.record-amount-right {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
}

.record-payment-action {
	display: flex;
	justify-content: flex-end;
	margin-left: 18rpx;
}

.record-pay-button {
	box-sizing: border-box;
	display: block;
	width: 116rpx;
	height: 54rpx;
	margin: 0;
	padding: 0;
	border: 1rpx solid #16b8c4;
	border-radius: 10rpx;
	background: #ffffff;
	color: #0aa7b5;
	font-size: 24rpx;
	line-height: 52rpx;
}

.record-pay-button::after {
	border: 0;
}

.load-more {
	box-sizing: border-box;
	margin: 4rpx auto 20rpx;
	padding: 22rpx;
	border-radius: 14rpx;
	background: #ffffff;
	color: #3d6df6;
	font-size: 26rpx;
	line-height: 1.4;
	text-align: center;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	/* 统一记录页状态容器，加载到空数据时不让业务卡片突然跳高。 */
	height: 380rpx;
	min-height: 380rpx;
	margin-top: 60rpx;
	padding: 40rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.state-card-empty {
	flex-direction: column;
}

.state-card image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.state-card-loading {
	flex-direction: column;
}

.state-loading-icon {
	box-sizing: border-box;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 20rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #9ca3af;
	border-radius: 50%;
	animation: outpatient-payment-loading 900ms linear infinite;
}

@keyframes outpatient-payment-loading {
	to {
		transform: rotate(360deg);
	}
}

.state-hint {
	display: block;
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.state-hint-action {
	color: #3d6df6;
	text-decoration: underline;
}

.readonly-note {
	margin-top: 24rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff7ee;
	color: #d56d2a;
	font-size: 24rpx;
	line-height: 1.6;
}

.payment-mask {
	position: fixed;
	z-index: 20;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: rgba(0, 0, 0, 0.45);
}

.payment-sheet {
	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	box-sizing: border-box;
	padding: 10rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
	border-radius: 28rpx 28rpx 0 0;
	background: #ffffff;
}

.payment-sheet-header {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	height: 54rpx;
}

.payment-sheet-close {
	padding: 0 0 8rpx 24rpx;
	color: #8b949e;
	font-size: 52rpx;
	font-weight: 300;
	line-height: 48rpx;
}

.payment-method-list {
	margin-top: 0;
}

.payment-method {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	margin-top: 4rpx;
	padding: 12rpx 12rpx;
	border-bottom: 1rpx solid #f0f1f3;
	background: #ffffff;
}

.payment-method:first-child {
	margin-top: 0;
}

.payment-method-active {
	background: #fbffff;
}

.payment-method-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 52rpx;
	width: 52rpx;
	height: 52rpx;
	margin-right: 18rpx;
	border-radius: 12rpx;
	font-size: 22rpx;
	font-weight: 700;
}

.medical-payment-icon {
	background: #e9f7ff;
	color: #22a6d8;
}

.wechat-payment-icon {
	border-radius: 16rpx;
	background: #35c759;
	color: #ffffff;
}

.payment-method-copy {
	display: flex;
	min-width: 0;
	flex-direction: column;
	align-items: flex-start;
}

.payment-method-title {
	color: #20242b;
	font-size: 29rpx;
	font-weight: 700;
}

.payment-radio {
	position: relative;
	flex: 0 0 34rpx;
	width: 34rpx;
	height: 34rpx;
	margin-left: 24rpx;
	border: 3rpx solid #cbd2da;
	border-radius: 50%;
}

.payment-radio-active {
	border-color: #3d6df6;
}

.payment-radio-active::after {
	position: absolute;
	top: 7rpx;
	left: 7rpx;
	width: 14rpx;
	height: 14rpx;
	border-radius: 50%;
	background: #3d6df6;
	content: "";
}

.payment-radio-wechat.payment-radio-active {
	border-color: #20b26b;
}

.payment-radio-wechat.payment-radio-active::after {
	background: #20b26b;
}

.sheet-pay-button {
	box-sizing: border-box;
	display: block;
	width: 100%;
	height: 84rpx;
	margin: 22rpx 0 0;
	padding: 0;
	border-radius: 8rpx;
	background: #08a9b8;
	color: #ffffff;
	font-size: 30rpx;
	line-height: 84rpx;
}

.sheet-pay-button::after {
	border: 0;
}
