page {
	background: #f8f8f8;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.error-message,
.notice,
.selector-card,
.tabs,
.record-list,
.state-card,
.readonly-note {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.error-message {
	margin-bottom: 18rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

.notice {
	margin-bottom: 18rpx;
	padding: 18rpx 20rpx;
	border-radius: 14rpx;
	background: #fff3e9;
	color: #fe7527;
	font-size: 25rpx;
	line-height: 1.6;
}

/* 旧端 PatientHospitalSelector：白色两行、分割线和右侧灰色箭头。 */
.selector-card {
	overflow: hidden;
	background: #ffffff;
}

.selector-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 92rpx;
	padding: 26rpx 30rpx;
	color: #333333;
}

.selector-row-border {
	border-bottom: 1rpx solid #f0f0f0;
}

.selector-label {
	flex: 0 0 150rpx;
	font-size: 28rpx;
}

.selector-value {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex: 1;
	min-width: 0;
	color: #333333;
	font-size: 30rpx;
	text-align: right;
}

.selector-name {
	overflow: hidden;
	min-width: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.selector-card-number {
	margin-left: 10rpx;
	color: #999999;
	font-size: 23rpx;
}

.selector-arrow-image {
	display: block;
	margin-left: 14rpx;
	flex: 0 0 28rpx;
	width: 28rpx;
	height: 28rpx;
}

.tabs {
	display: flex;
	margin-top: 18rpx;
	background: #ffffff;
	border-bottom: 1rpx solid #f0f0f0;
}

.tab {
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 50%;
	height: 88rpx;
	color: #666666;
	font-size: 29rpx;
}

.tab-active {
	color: #3d6df6;
	font-weight: 700;
}

.tab-active::after {
	position: absolute;
	bottom: 0;
	left: 50%;
	width: 120rpx;
	height: 6rpx;
	border-radius: 6rpx;
	background: #3d6df6;
	content: "";
	transform: translateX(-50%);
}

.record-list {
	padding-top: 20rpx;
}

.record-card {
	box-sizing: border-box;
	margin-bottom: 16rpx;
	padding: 24rpx;
	border-radius: 16rpx;
	background: #ffffff;
}

.record-header,
.record-footer {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-width: 0;
}

.record-department {
	overflow: hidden;
	color: #222222;
	font-size: 29rpx;
	font-weight: 700;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.record-status {
	flex-shrink: 0;
	margin-left: 16rpx;
	padding: 6rpx 12rpx;
	border-radius: 8rpx;
	background: #f2f6ff;
	color: #3d6df6;
	font-size: 23rpx;
}

.record-line,
.record-footer {
	margin-top: 16rpx;
	color: #777777;
	font-size: 25rpx;
}

.record-amount {
	color: #ee875e;
	font-size: 29rpx;
	font-weight: 700;
}

.load-more {
	box-sizing: border-box;
	margin: 4rpx auto 20rpx;
	padding: 22rpx;
	border-radius: 14rpx;
	background: #ffffff;
	color: #3d6df6;
	font-size: 26rpx;
	line-height: 1.4;
	text-align: center;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	/* 统一记录页状态容器，加载到空数据时不让业务卡片突然跳高。 */
	height: 380rpx;
	min-height: 380rpx;
	margin-top: 60rpx;
	padding: 40rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.state-card-empty {
	flex-direction: column;
}

.state-card image {
	display: block;
	width: 150rpx;
	height: 150rpx;
	margin-bottom: 18rpx;
}

.state-card-loading {
	flex-direction: column;
}

.state-loading-icon {
	box-sizing: border-box;
	width: 48rpx;
	height: 48rpx;
	margin-bottom: 20rpx;
	border: 6rpx solid #e5e7eb;
	border-top-color: #9ca3af;
	border-radius: 50%;
	animation: outpatient-payment-loading 900ms linear infinite;
}

@keyframes outpatient-payment-loading {
	to {
		transform: rotate(360deg);
	}
}

.state-hint {
	display: block;
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.state-hint-action {
	color: #3d6df6;
	text-decoration: underline;
}

.readonly-note {
	margin-top: 24rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff7ee;
	color: #d56d2a;
	font-size: 24rpx;
	line-height: 1.6;
}
