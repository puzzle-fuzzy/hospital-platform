<view class="page">
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<!-- 旧端提示包含支付、退费和医保引导；当前页面只开放费用查询，不能复制旧文案造成能力已开放的误导。 -->
	<view class="notice">当前仅展示门诊费用查询结果，支付、退费和医保结算请以医院正式渠道为准。</view>

	<!--
		旧端 PatientHospitalSelector 的两行布局必须保留在提示下方：
		患者行进入独立选择页，院区行只展示已核对的单院区配置。
	-->
	<view class="selector-card">
		<view class="selector-row selector-row-border" bindtap="onChangePatient">
			<text class="selector-label">就诊人</text>
			<view class="selector-value">
				<text wx:if="{{selectedPatient}}" class="selector-name">{{selectedPatient.displayName}}</text>
				<!--
					门诊费用在患者目录确认后还要读取费用列表。两阶段之间
					selectedPatient 可能暂时为空，但这不等于用户没有选择；
					先展示加载状态，避免把网络等待误导成业务拒绝。
				-->
				<text wx:elif="{{loading}}" class="selector-name">正在加载就诊人...</text>
				<text wx:else class="selector-name">请先选择就诊人</text>
				<text wx:if="{{selectedPatient}}" class="selector-card-number">（{{selectedPatient.cardNumberMasked}}）</text>
				<image
					class="selector-arrow-image"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
				/>
			</view>
		</view>
		<view class="selector-row" bindtap="onHospitalTap">
			<text class="selector-label">当前院区</text>
			<view class="selector-value">
				<text>{{hospitalName}}</text>
				<image
					class="selector-arrow-image"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
				/>
			</view>
		</view>
	</view>

	<view class="tabs">
		<view class="tab {{activeStatus === 'unpaid' ? 'tab-active' : ''}}" bindtap="onStatusTap" data-status="unpaid">待缴费</view>
		<view class="tab {{activeStatus === 'paid' ? 'tab-active' : ''}}" bindtap="onStatusTap" data-status="paid">已缴费</view>
	</view>

	<view wx:if="{{loading}}" class="state-card">
		<text>正在加载门诊缴费记录...</text>
	</view>

	<view wx:elif="{{visibleItems.length}}" class="record-list">
		<view wx:for="{{visibleItems}}" wx:key="recordId" class="record-card" bindtap="onRecordTap" data-view-key="{{item.viewKey}}">
			<view class="record-header">
				<text class="record-department">{{item.departmentName || '门诊费用'}}</text>
				<text class="record-status">{{item.status === 'unpaid' ? '待缴费' : '已缴费'}}</text>
			</view>
			<view wx:if="{{item.doctorName}}" class="record-line">医生：{{item.doctorName}}</view>
			<view class="record-footer">
				<text>{{item.billDateLabel}}</text>
				<text class="record-amount">{{item.amountLabel}}</text>
			</view>
		</view>
		<view wx:if="{{hasMoreItems}}" class="load-more" bindtap="onLoadMore">加载更多缴费记录</view>
	</view>

	<view wx:elif="{{!loading}}" class="state-card state-card-empty">
		<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
		<text wx:if="{{selectedPatient}}">{{activeStatus === 'unpaid' ? '未查询到待缴费记录' : '未查询到已缴费记录'}}</text>
		<text wx:else>请先选择就诊人</text>
		<text wx:if="{{selectedPatient}}" class="state-hint">如需查询其他就诊人，请点击上方更换</text>
		<view wx:else class="state-hint state-hint-action" bindtap="onChangePatient">点击这里选择就诊人</view>
	</view>

	<view class="readonly-note">当前已接入门诊费用查询。支付调起、医保授权和结算回写将在独立业务契约验收后开放。</view>
</view>
