<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<patient-hospital-context
		hospital-selectable="{{true}}"
		bindchangepatient="onChangePatient"
		bindhospitaltap="onHospitalTap"
	/>
	<view class="page">
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view class="tabs">
		<view class="tab {{activeStatus === 'unpaid' ? 'tab-active' : ''}}" bindtap="onStatusTap" data-status="unpaid">待缴费</view>
		<view class="tab {{activeStatus === 'paid' ? 'tab-active' : ''}}" bindtap="onStatusTap" data-status="paid">已缴费</view>
	</view>
	<view class="invoice-print-notice">
		<text class="invoice-print-notice-title">发票打印</text>
		<text class="invoice-print-notice-hint">请前往导诊机自主打印发票</text>
	</view>

	<!--
		加载、错误和空结果共用同一个状态节点。费用查询是患者最容易
		反复点击的页面之一，不能让空态插图在请求完成时重新撑开卡片。
	-->
	<view
		wx:if="{{loading || error || !visibleItems.length}}"
		class="state-card query-state-shell query-state-shell-column"
	>
		<block wx:if="{{loading}}">
			<view class="state-loading-icon" aria-hidden="true"></view>
			<text>正在加载费用记录...</text>
		</block>
		<block wx:elif="{{error}}">
			<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
			<text>本次门诊费用未加载成功</text>
			<text class="state-hint">请稍后再试</text>
			<view class="state-hint state-hint-action" bindtap="onRetry">再试一次</view>
			<view
				wx:if="{{canSelectPatient}}"
				class="state-hint state-hint-action"
				bindtap="onChangePatient"
			>选择就诊人</view>
		</block>
		<block wx:else>
			<image src="/assets/legacy-home/empty-services.png" mode="aspectFit" />
			<text wx:if="{{selectedPatient}}">{{activeStatus === 'unpaid' ? '未查询到待缴费记录' : '未查询到已缴费记录'}}</text>
			<text wx:else>请先选择就诊人</text>
			<text wx:if="{{selectedPatient}}" class="state-hint">如需查询其他就诊人，请点击上方更换</text>
			<view wx:else class="state-hint state-hint-action" bindtap="onChangePatient">点击这里选择就诊人</view>
		</block>
	</view>

	<!-- 卡片主体进入只读详情；待缴费记录的缴费按钮直接打开支付方式半窗口。 -->
	<view wx:elif="{{visibleItems.length}}" class="record-list">
		<view
			wx:for="{{visibleItems}}"
			wx:key="recordId"
			class="record-card record-card-{{item.paymentStatus || item.status}} {{item.items ? 'record-card-group' : ''}}"
		>
			<view class="record-line">
				<text class="record-label">患者姓名</text>
				<text class="record-value">{{selectedPatient.displayName}}</text>
			</view>
			<view class="record-line">
				<text class="record-label">就诊科室</text>
				<text class="record-value">{{item.departmentName || '门诊费用'}}</text>
			</view>
			<view wx:if="{{!item.items && item.itemName}}" class="record-line">
				<text class="record-label">费用项目</text>
				<text class="record-value">{{item.itemName}}</text>
			</view>
			<view wx:if="{{!item.items && item.executionDepartmentName}}" class="record-line">
				<text class="record-label">执行科室</text>
				<text class="record-value">{{item.executionDepartmentName}}</text>
			</view>
			<view wx:if="{{item.doctorName}}" class="record-line">
				<text class="record-label">就诊医生</text>
				<text class="record-value">{{item.doctorName}}</text>
			</view>
			<view wx:if="{{!item.items && item.executionDoctorName}}" class="record-line">
				<text class="record-label">执行医生</text>
				<text class="record-value">{{item.executionDoctorName}}</text>
			</view>
			<view wx:if="{{item.items}}" class="record-fee-items">
				<view class="record-fee-heading">
					<text>费用明细</text>
					<text class="record-fee-count">共 {{item.itemCount}} 项</text>
				</view>
				<view wx:for="{{item.items}}" wx:for-item="fee" wx:key="recordId" class="record-fee-item">
					<view class="record-fee-title-line">
						<text class="record-fee-name">{{fee.itemName || '门诊费用项目'}}</text>
						<text class="record-fee-amount">{{fee.amountLabel}}</text>
					</view>
					<view wx:if="{{fee.executionDepartmentName}}" class="record-fee-meta">执行科室：{{fee.executionDepartmentName}}</view>
					<view wx:if="{{fee.executionDoctorName}}" class="record-fee-meta">执行医生：{{fee.executionDoctorName}}</view>
					<view wx:if="{{fee.specQuantityLabel || fee.priceLabel}}" class="record-fee-meta record-fee-spec">
						<text wx:if="{{fee.specQuantityLabel}}">{{fee.specQuantityLabel}}</text>
						<text wx:if="{{fee.priceLabel}}">单价 {{fee.priceLabel}}</text>
					</view>
					<view wx:if="{{fee.chargeClassName || fee.tradePropName || fee.typeMemo}}" class="record-fee-meta">{{fee.chargeClassName || fee.tradePropName || fee.typeMemo}}</view>
				</view>
			</view>
			<view wx:if="{{!item.items && item.specQuantityLabel}}" class="record-line">
				<text class="record-label">规格数量</text>
				<text class="record-value">{{item.specQuantityLabel}}</text>
			</view>
			<view wx:if="{{!item.items && item.priceLabel}}" class="record-line">
				<text class="record-label">单价</text>
				<text class="record-value">{{item.priceLabel}}</text>
			</view>
			<view wx:if="{{item.chargeClassName || item.tradePropName || item.typeMemo}}" class="record-line">
				<text class="record-label">费用类别</text>
				<text class="record-value">{{item.chargeClassName || item.tradePropName || item.typeMemo}}</text>
			</view>
			<view class="record-line record-amount-line">
				<text class="record-label">{{item.items ? '合计金额' : '缴费金额'}}</text>
				<text class="record-amount">{{item.amountLabel}}</text>
			</view>
			<view class="record-line record-line-last">
				<text class="record-label">就诊时间</text>
				<text class="record-time">{{item.billDateLabel}}</text>
			</view>
			<view class="record-footer">
				<view wx:if="{{item.status === 'unpaid'}}" class="record-payment-action" catchtap="onPaymentTap" data-view-key="{{item.viewKey}}">
					<button wx:if="{{item.items}}" class="record-pay-button record-group-pay-button">合并缴费</button>
					<block wx:else><button class="record-pay-button">缴费</button></block>
				</view>
				<view wx:if="{{item.status !== 'unpaid'}}" class="record-status-wrap">
					<text class="record-status record-status-{{item.paymentStatus || item.status}}">{{item.paymentStatus === 'refunding' ? '退款中' : item.status === 'unpaid' ? '待缴费' : '已缴费'}}</text>
				</view>
			</view>
		</view>
		<view wx:if="{{hasMoreItems}}" class="load-more" bindtap="onLoadMore">加载更多缴费记录</view>
	</view>
	</view>
</scroll-view>

	<view wx:if="{{paymentSheetVisible}}" class="payment-mask" catchtap="onClosePaymentSheet">
	<view class="payment-sheet" catchtap="onStopPaymentSheet">
		<view class="payment-sheet-header">
			<text class="payment-sheet-close" bindtap="onClosePaymentSheet">×</text>
		</view>
		<view wx:if="{{paymentRecord}}" class="payment-sheet-summary">
			<view>
				<text class="payment-sheet-title">本次缴费</text>
				<text class="payment-sheet-count">共 {{paymentRecord.itemCount}} 项费用</text>
			</view>
			<text class="payment-sheet-amount">{{paymentRecord.amountLabel}}</text>
		</view>
		<view class="payment-method-list">
			<view wx:if="{{medicalEligibilityMessage}}" class="payment-eligibility-message">{{medicalEligibilityMessage}}</view>
			<view wx:elif="{{medicalEligibilityChecking}}" class="payment-eligibility-message">正在确认医保支付是否可用...</view>
			<view wx:if="{{medicalEligibility !== 'unsupported' && !medicalEligibilityChecking}}" class="payment-method {{paymentMethod === 'medical' ? 'payment-method-active' : ''}}" bindtap="onPaymentMethodTap" data-method="medical">
				<view class="payment-method-icon medical-payment-icon">医保</view>
				<view class="payment-method-copy">
					<text class="payment-method-title">医保支付</text>
				</view>
				<view class="payment-radio {{paymentMethod === 'medical' ? 'payment-radio-active' : ''}}"></view>
			</view>
			<view class="payment-method {{paymentMethod === 'wechat' ? 'payment-method-active' : ''}}" bindtap="onPaymentMethodTap" data-method="wechat">
				<view class="payment-method-icon wechat-payment-icon">微</view>
				<view class="payment-method-copy">
					<text class="payment-method-title">微信支付</text>
				</view>
				<view class="payment-radio payment-radio-wechat {{paymentMethod === 'wechat' ? 'payment-radio-active' : ''}}"></view>
			</view>
		</view>
		<button wx:if="{{medicalEligibility === 'unsupported' && hasOriginalMedicalPayment}}" class="original-medical-payment" bindtap="onOriginalMedicalPayment" disabled="{{paymentBusy}}">查询原医保订单</button>
		<button class="sheet-pay-button" bindtap="onConfirmPayment" loading="{{paymentBusy !== ''}}" disabled="{{!paymentMethod || paymentBusy}}">支付</button>
	</view>
</view>
