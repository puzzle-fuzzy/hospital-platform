<view class="page">
	<!-- 错误区域必须在页面最上方，网络异常时用户无需滚动查找原因。 -->
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view class="trust-notice">
		<text class="trust-notice-icon">!</text>
		<text>守信就诊，共建良好就医环境</text>
	</view>

	<view wx:if="{{selectedPatient}}" class="patient-strip" bindtap="onChangePatient">
		<image src="/assets/legacy-home/service-patient.svg" mode="aspectFit" />
		<view class="patient-strip-copy">
			<text class="patient-strip-name">{{selectedPatient.displayName}}</text>
			<text class="patient-strip-card">{{selectedPatient.cardNumberMasked}}</text>
		</view>
		<text class="patient-strip-change">更换就诊人</text>
	</view>

	<view class="page-header">
		<view class="page-title">爽约记录</view>
		<view class="page-description">展示当前就诊人过去 90 天的爽约记录</view>
	</view>

	<view wx:if="{{loading}}" class="state-card">
		<text>正在加载爽约记录...</text>
	</view>

	<view wx:elif="{{visibleRecords.length}}" class="record-list">
		<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="record-card missed-record-card">
			<view class="record-header">
				<text class="record-date">{{item.workDate}}</text>
				<text class="record-status record-status-missed">已爽约</text>
			</view>
			<view class="record-department">{{item.departmentName || "门诊挂号"}}</view>
			<view wx:if="{{item.doctorName}}" class="record-line">医生：{{item.doctorName}}</view>
			<view wx:if="{{item.workTime}}" class="record-line">时间：{{item.workTime}}</view>
			<view wx:if="{{item.location}}" class="record-line">地点：{{item.location}}</view>
			<view wx:if="{{item.serialNumber}}" class="record-number">流水号：{{item.serialNumber}}</view>
			<text class="missed-stamp">已爽约</text>
		</view>
		<view wx:if="{{hasMoreRecords}}" class="load-more" bindtap="onLoadMore">加载更多爽约记录</view>
	</view>

	<!--
		爽约列表是预约历史的派生读模型。查询异常时不能显示“暂无爽约记录”，
		否则会把 Provider 失败误报成用户没有爽约；恢复动作必须重新读取当前患者。
	-->
	<view wx:elif="{{error}}" class="state-card state-card-empty state-card-error">
		<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
		<text>本次爽约记录未加载成功</text>
		<text class="state-hint">请根据上方提示处理后重试</text>
		<view class="state-hint state-hint-action" bindtap="onRetry">重新加载</view>
		<view class="state-hint state-hint-action" bindtap="onChangePatient">选择就诊人</view>
	</view>

	<view wx:elif="{{!loading}}" class="state-card state-card-empty">
		<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
		<text wx:if="{{selectedPatient}}">暂无爽约记录</text>
		<text wx:else>请先选择就诊人</text>
		<text wx:if="{{selectedPatient}}" class="state-hint">请继续保持按时就诊的好习惯</text>
		<view wx:else class="state-hint state-hint-action" bindtap="onChangePatient">点击这里选择就诊人</view>
	</view>

	<view class="readonly-note">
		本页面仅展示服务端预约记录中已确认的爽约状态，查询范围为过去 90 天；状态未知或服务异常时不会推断为爽约。
	</view>
</view>
