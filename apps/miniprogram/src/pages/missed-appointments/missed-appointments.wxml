<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<!-- 错误区域必须在页面最上方，网络异常时用户无需滚动查找原因。 -->
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view class="trust-notice">
		<text class="trust-notice-icon">!</text>
		<text>守信就诊，共建良好就医环境</text>
	</view>

	<view class="selector-card">
		<view class="selector-row" bindtap="onChangePatient">
			<text class="selector-label">就诊人</text>
			<view class="selector-value">
				<text wx:if="{{selectedPatient}}" class="selector-name">{{selectedPatient.displayName}}</text>
				<text wx:elif="{{loading}}" class="selector-name">正在加载就诊人...</text>
				<text wx:else class="selector-name">请先选择就诊人</text>
				<text wx:if="{{selectedPatient}}" class="selector-card-number">（{{selectedPatient.cardNumberMasked}}）</text>
				<image
					class="selector-arrow-image"
					src="/assets/legacy-user/selector-arrow-right.svg"
					mode="aspectFit"
				/>
			</view>
		</view>
	</view>

	<!--
		爽约列表是预约历史的派生读模型。查询异常时不能显示“暂无爽约记录”，
		否则会把 Provider 失败误报成用户没有爽约；恢复动作必须重新读取当前患者。
		这个状态外壳在 loading/error/empty 之间复用，避免插图加载造成页面跳动。
	-->
	<view class="record-list">
		<view
			wx:if="{{loading || error || !visibleRecords.length}}"
			class="state-card query-state-shell query-state-shell-column {{loading ? 'state-card-loading' : 'state-card-empty'}}"
		>
		<block wx:if="{{loading}}">
			<view class="state-loading-icon" aria-hidden="true"></view>
			<text>正在加载爽约记录...</text>
		</block>
		<block wx:elif="{{error}}">
			<image src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
			<text>本次爽约记录未加载成功</text>
		<text class="state-hint">请稍后再试</text>
		<view class="state-hint state-hint-action" bindtap="onRetry">再试一次</view>
		</block>
		<block wx:else>
			<image src="/assets/legacy-user/empty-record.svg" mode="aspectFit" />
			<text>暂无爽约记录</text>
			<text class="state-hint">请继续保持按时就诊的好习惯</text>
		</block>
		</view>

		<view wx:elif="{{visibleRecords.length}}" class="record-items">
		<view wx:for="{{visibleRecords}}" wx:key="viewKey" class="record-card missed-record-card">
			<!-- 爽约页沿用挂号卡片的层级，只替换状态事实，避免两页视觉语言分裂。 -->
			<view class="record-card-header">
				<view class="record-card-title-wrap">
					<text class="record-department">{{item.departmentName || "门诊挂号"}}</text>
					<text class="record-card-caption">预约挂号</text>
				</view>
				<view class="record-status-badge record-status-missed record-status-stamp">已爽约</view>
			</view>
			<view wx:if="{{item.doctorName || item.hospitalAreaName || item.location}}" class="record-meta">
				<view wx:if="{{item.doctorName}}" class="record-meta-item">
					<text class="record-meta-label">医生</text>
					<text class="record-meta-value">{{item.doctorName}}</text>
				</view>
				<view wx:if="{{item.hospitalAreaName}}" class="record-meta-item">
					<text class="record-meta-label">院区</text>
					<text class="record-meta-value">{{item.hospitalAreaName}}</text>
				</view>
				<view wx:if="{{item.location}}" class="record-meta-item">
					<text class="record-meta-label">科室位置</text>
					<text class="record-meta-value">{{item.location}}</text>
				</view>
			</view>
			<view class="record-schedule">
				<view class="record-schedule-item">
					<text class="record-schedule-label">就诊日期</text>
					<text class="record-date">{{item.workDate}}</text>
				</view>
				<view wx:if="{{item.workTime}}" class="record-schedule-item record-schedule-time">
					<text class="record-schedule-label">就诊时段</text>
					<text class="record-time">{{item.workTime}}</text>
				</view>
			</view>
			<view wx:if="{{item.serialNumber}}" class="record-number">
				<text>第 </text><text class="record-number-emphasis">{{item.serialNumber}}</text><text> 号</text>
			</view>
		</view>
		<view wx:if="{{hasMoreRecords}}" class="load-more" bindtap="onLoadMore">加载更多爽约记录</view>
		</view>
	</view>

	<view class="readonly-note">
		本页面仅展示服务端预约记录中已确认的爽约状态，查询范围为过去 90 天；状态未知或服务异常时不会推断为爽约。
	</view>
	</view>
</scroll-view>
