<scroll-view class="patient-binding-scroll" scroll-y="true" enhanced="true">
	<view class="patient-binding-page">
		<view class="patient-binding-hero">
			<text class="patient-binding-title">添加就诊人</text>
			<text class="patient-binding-subtitle">请输入就诊人的真实信息，提交后由医院服务端完成核验和关联。</text>
		</view>

		<view class="patient-binding-card">
			<view class="patient-binding-field">
				<text class="patient-binding-label">姓名</text>
				<input class="patient-binding-input" value="{{displayName}}" data-field="displayName" bindinput="onInput" maxlength="128" placeholder="请输入就诊人姓名" />
			</view>
			<view class="patient-binding-field">
				<text class="patient-binding-label">手机号</text>
				<input class="patient-binding-input" value="{{mobile}}" data-field="mobile" bindinput="onInput" maxlength="11" type="number" placeholder="请输入就诊人手机号" />
			</view>
			<view class="patient-binding-field patient-binding-field-last">
				<text class="patient-binding-label">身份证号</text>
				<input class="patient-binding-input" value="{{identityNumber}}" data-field="identityNumber" bindinput="onInput" maxlength="18" type="idcard" placeholder="请输入就诊人身份证号" />
			</view>
		</view>

		<view class="patient-binding-consent" bindtap="onToggleConsent">
			<view class="patient-binding-checkbox {{consent ? 'patient-binding-checkbox-on' : ''}}">
				<text wx:if="{{consent}}">✓</text>
			</view>
			<text class="patient-binding-consent-copy">我已阅读并同意</text>
			<text class="patient-binding-agreement" catchtap="onOpenPatientAgreement">《患者服务协议》</text>
		</view>

		<view wx:if="{{error}}" class="patient-binding-error">{{error}}</view>

		<button class="patient-binding-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '正在提交' : '提交添加'}}</button>
		<button class="patient-binding-back" bindtap="onBack">返回选择就诊人</button>
		<text class="patient-binding-notice">信息仅用于本次就诊人核验和医院档案关联。</text>
	</view>
</scroll-view>
