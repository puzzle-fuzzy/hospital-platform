<web-view wx:if="{{webViewUrl}}" src="{{webViewUrl}}" binderror="onWebViewError"></web-view>
<view wx:else class="patient-binding-page">
	<view class="patient-binding-card">
		<text class="patient-binding-title">在医院公众号添加就诊人</text>
		<text class="patient-binding-description">请在医院公众号页面完成绑定，完成后点击左上角返回，小程序会刷新就诊人列表。</text>
		<text wx:if="{{error}}" class="patient-binding-error">{{error}}</text>
		<button class="patient-binding-retry" bindtap="onRetry">重新打开公众号页面</button>
		<button class="patient-binding-back" bindtap="onBack">返回选择就诊人</button>
	</view>
</view>
