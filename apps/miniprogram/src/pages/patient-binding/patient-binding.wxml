<scroll-view class="binding-scroll" scroll-y="true" enhanced="true">
  <view class="binding-page">
    <view class="binding-header">
      <view class="binding-back" bindtap="onBack">‹</view>
      <text class="binding-title">添加就诊人</text>
      <view class="binding-header-placeholder"></view>
    </view>

    <view class="binding-intro">
      <text class="binding-intro-title">完善就诊人信息</text>
      <text class="binding-intro-copy">请填写本人或家属的实名信息，医院将据此查找或建立就诊档案。</text>
    </view>

    <view class="binding-card">
      <view class="binding-field">
        <text class="binding-label"><text class="binding-required">*</text>姓名</text>
        <input class="binding-input" value="{{displayName}}" maxlength="128" placeholder="请输入真实姓名" placeholder-class="binding-placeholder" bindinput="onDisplayNameInput" />
      </view>
      <view class="binding-divider"></view>
      <view class="binding-field">
        <text class="binding-label"><text class="binding-required">*</text>手机号</text>
        <input class="binding-input" type="number" value="{{mobile}}" maxlength="11" placeholder="请输入就诊人手机号" placeholder-class="binding-placeholder" bindinput="onMobileInput" />
      </view>
      <view class="binding-divider"></view>
      <view class="binding-field">
        <text class="binding-label"><text class="binding-required">*</text>身份证号</text>
        <input class="binding-input binding-identity" value="{{identityNumber}}" maxlength="18" placeholder="请输入15或18位身份证号" placeholder-class="binding-placeholder" bindinput="onIdentityNumberInput" />
      </view>
    </view>

    <view class="binding-note">身份证号用于匹配医院档案，提交后不会在小程序页面展示。</view>

    <checkbox-group class="binding-consent" bindchange="onAgreementChange">
      <label class="binding-consent-label">
        <checkbox value="agree" checked="{{agreed}}" color="#2f80ed" />
        <text>我已阅读并同意</text>
        <text class="binding-agreement-link" bindtap="onOpenAgreement">《就诊人信息使用说明》</text>
      </label>
    </checkbox-group>

    <view wx:if="{{error}}" class="binding-error">{{error}}</view>
    <button class="binding-submit {{submitting ? 'binding-submit-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '正在添加…' : '确认添加'}}</button>
    <text class="binding-footnote">添加成功后，系统会自动刷新就诊人列表。</text>
  </view>
</scroll-view>
