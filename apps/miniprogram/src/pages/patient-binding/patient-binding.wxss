.patient-binding-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 48rpx 28rpx;
	background: #f6f8fc;
}

.patient-binding-card {
	padding: 36rpx 30rpx;
	border-radius: 20rpx;
	background: #fff;
}

.patient-binding-title,
.patient-binding-description,
.patient-binding-error {
	display: block;
}

.patient-binding-title {
	color: #222b45;
	font-size: 34rpx;
	font-weight: 600;
	line-height: 1.5;
}

.patient-binding-description,
.patient-binding-error {
	margin-top: 24rpx;
	color: #68738a;
	font-size: 28rpx;
	line-height: 1.75;
}

.patient-binding-error {
	padding: 22rpx;
	border-radius: 12rpx;
	background: #f3f6fc;
}

.patient-binding-retry,
.patient-binding-back {
	box-sizing: border-box;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	min-height: 92rpx;
	margin-top: 32rpx;
	padding: 16rpx 20rpx;
	border-radius: 14rpx;
	font-size: 29rpx;
	line-height: 1.5;
}

.patient-binding-retry {
	background: #3d6df6;
	color: #fff;
}

.patient-binding-back {
	margin-top: 18rpx;
	background: #f3f6fc;
	color: #455774;
}
