page {
	background: #ffffff;
}

.hospital-list-page {
	min-height: 100vh;
	background: #ffffff;
}

/* 与旧端 h-86rpx、px-30rpx、27rpx 红色提示保持一致。 */
.campus-warning {
	box-sizing: border-box;
	width: 100%;
	height: 86rpx;
	padding: 0 30rpx;
	display: flex;
	align-items: center;
	background: #fff7ee;
	color: #fe2b15;
	font-size: 27rpx;
}

.hospital-list-content {
	box-sizing: border-box;
	width: 710rpx;
	margin: 40rpx auto 0;
	display: flex;
	flex-direction: column;
	gap: 40rpx;
}

/* 旧端卡片固定 380rpx 高、20rpx 圆角，并使用 aspectFill 裁剪封面。 */
.hospital-card {
	position: relative;
	box-sizing: border-box;
	height: 380rpx;
	overflow: hidden;
	border-radius: 20rpx;
	background: #e8edf6;
}

.hospital-image {
	display: block;
	width: 100%;
	height: 100%;
}

.hospital-overlay {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	box-sizing: border-box;
	padding: 20rpx 30rpx;
	background: rgba(0, 0, 0, 0.5);
	color: #ffffff;
}

.hospital-summary {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.hospital-name {
	font-size: 28rpx;
	font-weight: 700;
}

.route-button {
	box-sizing: border-box;
	padding: 10rpx 30rpx;
	border: 1rpx solid rgba(255, 255, 255, 0.9);
	border-radius: 999rpx;
	font-size: 24rpx;
	opacity: 0.9;
}

.hospital-address {
	margin-top: 12rpx;
	font-size: 24rpx;
}

.register-button {
	position: absolute;
	right: 0;
	top: 20rpx;
	box-sizing: border-box;
	width: 180rpx;
	height: 66rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 33rpx 0 0 33rpx;
	background: #628ff6;
	color: #ffffff;
	font-size: 28rpx;
}
