page {
	background: #f8f8f8;
}

.appointment-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.registration-hero,
.appointment-search,
.error-message,
.cascade-shell,
.readonly-note,
.state-card {
	box-sizing: border-box;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

/* 旧端 registration 页的白色导诊区域。 */
.registration-hero {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	min-height: 170rpx;
	padding: 28rpx 30rpx 24rpx;
	border-radius: 20rpx 20rpx 0 0;
	background: #ffffff;
}

.registration-hero-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
}

.registration-hero-title {
	color: #282828;
	font-size: 32rpx;
	font-weight: 700;
	line-height: 1.45;
}

.registration-hero-guide {
	display: flex;
	align-items: center;
	margin-top: 20rpx;
	color: #666666;
	font-size: 27rpx;
	line-height: 1.35;
}

.guide-button {
	flex-shrink: 0;
	margin-left: 22rpx;
	padding: 6rpx 18rpx;
	border-radius: 999rpx;
	background: #4b8eff;
	color: #ffffff;
	font-size: 23rpx;
	line-height: 1.2;
}

.registration-hero-image {
	display: block;
	flex: 0 0 108rpx;
	width: 108rpx;
	height: 118rpx;
	margin-left: 18rpx;
}

.appointment-search {
	display: flex;
	align-items: center;
	height: 92rpx;
	padding: 0 0 0 20rpx;
	border: 1rpx solid #5c8df7;
	border-radius: 0 0 20rpx 20rpx;
	background: #ffffff;
	overflow: hidden;
}

.appointment-search-icon {
	display: block;
	flex: 0 0 36rpx;
	width: 36rpx;
	height: 36rpx;
	margin-right: 16rpx;
}

.appointment-search-input {
	flex: 1;
	min-width: 0;
	height: 90rpx;
	color: #333333;
	font-size: 28rpx;
	line-height: 90rpx;
}

.appointment-search-placeholder {
	color: #aaaaaa;
}

.appointment-search-button {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 118rpx;
	align-self: stretch;
	background: #5c8df7;
	color: #ffffff;
	font-size: 28rpx;
}

.error-message {
	margin-top: 20rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

/* 旧端布局的核心：左右两栏独立滚动，左栏切换右栏上下文。 */
.cascade-shell {
	display: flex;
	align-items: stretch;
	height: calc(100vh - 490rpx);
	min-height: 700rpx;
	margin-top: 24rpx;
	border-radius: 20rpx;
	overflow: hidden;
	background: #ffffff;
}

.department-panel {
	flex: 0 0 228rpx;
	box-sizing: border-box;
	height: 100%;
	background: #f8f8f8;
}

.department-item {
	position: relative;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	min-height: 88rpx;
	padding: 18rpx 18rpx 18rpx 30rpx;
	border-bottom: 1rpx solid #e5e5e5;
	color: #555555;
	font-size: 27rpx;
	line-height: 1.35;
}

.department-item-active {
	background: #ffffff;
	color: #3981f7;
	font-weight: 700;
}

.department-active-line {
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	width: 8rpx;
	background: transparent;
}

.department-item-active .department-active-line {
	background: #5c8df7;
}

.department-name {
	display: -webkit-box;
	min-width: 0;
	overflow: hidden;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
}

.schedule-panel {
	display: flex;
	flex: 1;
	min-width: 0;
	flex-direction: column;
	background: #ffffff;
}

.schedule-panel-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 106rpx;
	padding: 18rpx 20rpx;
	border-bottom: 1rpx solid #eeeeee;
}

.schedule-panel-heading {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
}

.schedule-panel-title {
	overflow: hidden;
	color: #222222;
	font-size: 30rpx;
	font-weight: 700;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-panel-description {
	margin-top: 6rpx;
	overflow: hidden;
	color: #999999;
	font-size: 21rpx;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-panel-count {
	flex-shrink: 0;
	margin-left: 12rpx;
	color: #999999;
	font-size: 21rpx;
}

.appointment-mode-tabs {
	position: relative;
	display: flex;
	box-sizing: border-box;
	height: 88rpx;
	border-bottom: 1rpx solid #eeeeee;
	background: #ffffff;
}

.appointment-mode-tab {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 1;
	box-sizing: border-box;
	padding-bottom: 4rpx;
	color: #333333;
	font-size: 28rpx;
	line-height: 1;
}

.appointment-mode-tab-active {
	color: #3981f7;
	font-weight: 700;
}

.appointment-mode-indicator {
	position: absolute;
	bottom: 0;
	width: 126rpx;
	height: 4rpx;
	border-radius: 999rpx;
	background: #3981f7;
	transition: left 180ms ease;
}

.appointment-mode-indicator-doctor {
	left: calc(25% - 63rpx);
}

.appointment-mode-indicator-date {
	left: calc(75% - 63rpx);
}

.schedule-scroll {
	flex: 1;
	box-sizing: border-box;
	min-height: 0;
	background: #f8f8f8;
}

.panel-state-shell {
	height: 500rpx;
	min-height: 500rpx;
	background: #ffffff;
}

.panel-loading,
.panel-empty,
.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	color: #777777;
	font-size: 26rpx;
}

.panel-loading,
.panel-empty {
	height: 500rpx;
	min-height: 500rpx;
}

.panel-empty {
	flex-direction: column;
}

.panel-empty image {
	display: block;
	width: 170rpx;
	margin-bottom: 16rpx;
}

.state-card {
	margin-top: 24rpx;
	padding: 44rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
}

.state-card image {
	display: block;
	width: 180rpx;
	margin-bottom: 16rpx;
}

.state-hint {
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 23rpx;
}

.state-hint-action {
	padding: 10rpx 28rpx;
	border-radius: 999rpx;
	background: #f2f6ff;
	color: #3d6df6;
}

/* 旧端“按医生挂号”的白色卡片层级。 */
.doctor-list {
	padding: 20rpx;
}

.doctor-card {
	box-sizing: border-box;
	margin-bottom: 20rpx;
	padding: 22rpx;
	border-radius: 20rpx;
	background: #ffffff;
	box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.doctor-card-main {
	display: flex;
	align-items: flex-start;
}

.doctor-avatar {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 92rpx;
	width: 92rpx;
	height: 92rpx;
	margin-right: 18rpx;
	border-radius: 14rpx;
	background: #dce8ff;
	color: #3d6df6;
	font-size: 34rpx;
	font-weight: 700;
}

.doctor-card-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
}

.doctor-card-name-row {
	display: flex;
	align-items: center;
	min-width: 0;
}

.doctor-card-name {
	overflow: hidden;
	color: #222222;
	font-size: 32rpx;
	font-weight: 700;
	line-height: 1.3;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.doctor-available,
.doctor-unavailable {
	flex-shrink: 0;
	margin-left: 14rpx;
	padding: 4rpx 14rpx;
	border-radius: 999rpx;
	font-size: 22rpx;
	line-height: 1.2;
}

.doctor-available {
	background: #3981f7;
	color: #ffffff;
}

.doctor-unavailable {
	background: #eeeeee;
	color: #888888;
}

.doctor-card-meta {
	margin-top: 10rpx;
	overflow: hidden;
	color: #666666;
	font-size: 24rpx;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.doctor-card-hint {
	margin-top: 8rpx;
	color: #999999;
	font-size: 22rpx;
	line-height: 1.35;
}

.doctor-card-divider {
	height: 1rpx;
	margin-top: 20rpx;
	border-top: 1rpx dashed #e5e5e5;
}

.doctor-date-section {
	display: flex;
	align-items: flex-start;
	margin-top: 18rpx;
}

.doctor-date-label {
	flex: 0 0 82rpx;
	padding-top: 10rpx;
	color: #888888;
	font-size: 24rpx;
	line-height: 1.3;
}

.doctor-date-list {
	display: flex;
	flex: 1;
	flex-wrap: wrap;
	gap: 10rpx;
	min-width: 0;
}

.doctor-date-chip {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-height: 56rpx;
	padding: 8rpx 12rpx;
	border-radius: 12rpx;
	background: #f1f2f5;
	color: #333333;
	font-size: 22rpx;
	line-height: 1.25;
	flex-direction: column;
}

.doctor-date-slots {
	margin-top: 3rpx;
	color: #888888;
	font-size: 19rpx;
}

.doctor-card-footer {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-top: 18rpx;
	color: #888888;
	font-size: 22rpx;
	line-height: 1.3;
}

.doctor-card-action {
	color: #3d6df6;
}

/* 旧端“按日期挂号”的横向日期条和医生排班行。 */
.selected-doctor-filter {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	margin: 16rpx 20rpx 0;
	padding: 14rpx 18rpx;
	border-radius: 12rpx;
	background: #eaf2ff;
	color: #3d6df6;
	font-size: 24rpx;
	line-height: 1.35;
}

.selected-doctor-clear {
	flex-shrink: 0;
	margin-left: 12rpx;
	color: #3d6df6;
	font-weight: 700;
}

.date-scroll {
	width: 100%;
	border-bottom: 1rpx solid #eeeeee;
	background: #ffffff;
	white-space: nowrap;
}

.date-list {
	display: inline-flex;
	padding: 18rpx 16rpx 14rpx;
}

.date-item {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	min-width: 150rpx;
	margin-right: 12rpx;
	padding: 12rpx 14rpx;
	border-radius: 14rpx;
	background: #f7f7f7;
	color: #777777;
	flex-direction: column;
}

.date-item-active {
	background: #eaeffd;
	color: #3d6df6;
}

.date-label {
	font-size: 23rpx;
	line-height: 1.3;
}

.date-count {
	margin-top: 5rpx;
	font-size: 20rpx;
}

.schedule-list {
	padding: 18rpx 20rpx 0;
}

.schedule-item {
	display: flex;
	align-items: stretch;
	box-sizing: border-box;
	min-height: 156rpx;
	margin-bottom: 14rpx;
	overflow: hidden;
	border-radius: 14rpx;
	background: #ffffff;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.schedule-shift-badge {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 0 0 54rpx;
	box-sizing: border-box;
	padding: 10rpx 8rpx;
	background: #eaf2ff;
	color: #2f82f8;
	font-size: 23rpx;
	line-height: 1.25;
	text-align: center;
	writing-mode: vertical-rl;
}

.schedule-item-copy {
	display: flex;
	min-width: 0;
	flex: 1;
	padding: 20rpx 12rpx 18rpx 16rpx;
	flex-direction: column;
}

.schedule-doctor {
	overflow: hidden;
	color: #222222;
	font-size: 30rpx;
	font-weight: 700;
	line-height: 1.3;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-department,
.schedule-time {
	margin-top: 7rpx;
	overflow: hidden;
	color: #777777;
	font-size: 22rpx;
	line-height: 1.35;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.schedule-item-action {
	display: flex;
	align-items: flex-end;
	justify-content: center;
	flex: 0 0 104rpx;
	padding: 20rpx 16rpx 18rpx 0;
	flex-direction: column;
}

.schedule-slots {
	font-size: 21rpx;
	line-height: 1.3;
	white-space: nowrap;
}

.schedule-slots-available {
	color: #16a34a;
}

.schedule-slots-empty {
	color: #999999;
}

.schedule-reserve {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 90rpx;
	height: 54rpx;
	margin-top: 12rpx;
	border-radius: 999rpx;
	font-size: 25rpx;
	line-height: 1;
}

.schedule-reserve-active {
	background: #3981f7;
	color: #ffffff;
}

.schedule-reserve-disabled {
	background: #eeeeee;
	color: #999999;
}

.load-more-button {
	box-sizing: border-box;
	width: calc(100% - 40rpx);
	height: 72rpx;
	margin: 8rpx 20rpx 26rpx;
	border: 1rpx solid #dbe5ff;
	border-radius: 36rpx;
	background: #f2f6ff;
	color: #3d6df6;
	font-size: 25rpx;
	line-height: 70rpx;
}

.readonly-note {
	margin-top: 22rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff7ee;
	color: #d56d2a;
	font-size: 24rpx;
	line-height: 1.6;
}

/*
 * 蓝湖「选择科室」：该页原本把导诊、级联和排班卡片放进一张圆角卡片。
 * 这里改为旧端相同的全宽导诊区 + 搜索区 + 两列级联，保留现有数据和事件。
 */
.appointment-page {
	min-height: 100vh;
	padding: 0;
	background: #f8f8f8;
}

.registration-hero-section {
	background: #ffffff;
}

.registration-hero {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	box-sizing: border-box;
	width: 710rpx;
	height: 170rpx;
	margin: 0 auto;
	padding: 0 0 30rpx;
	border-radius: 0;
	background: transparent;
}

.registration-hero-copy {
	justify-content: flex-end;
}

.registration-hero-title {
	color: #282828;
	font-size: 32rpx;
	font-weight: 400;
	line-height: 1.4;
}

.registration-hero-guide {
	margin-top: 20rpx;
	color: #666666;
	font-size: 32rpx;
	line-height: 1.35;
}

.guide-button {
	margin-left: 30rpx;
	padding: 4rpx 20rpx;
	border-radius: 999rpx;
	background: radial-gradient(
		0% 0% at 0% 0%,
		#5494ff 0%,
		#77aaff 76%
	), #4c8ffe;
	font-size: 24rpx;
	line-height: 1.35;
}

.registration-hero-illustration {
	position: relative;
	display: flex;
	align-items: flex-end;
	justify-content: center;
	flex: 0 0 104rpx;
	width: 104rpx;
	height: 140rpx;
	margin: 0;
}

.registration-hero-portrait {
	position: absolute;
	right: -2rpx;
	bottom: 0;
	width: 108rpx;
	height: 88rpx;
	overflow: hidden;
}

.registration-hero-image {
	position: absolute;
	top: 0;
	left: -21rpx;
	display: block;
	width: 150rpx;
	height: auto;
	max-width: none;
	margin: 0;
}

.guide-scan-corner {
	position: absolute;
	z-index: 1;
	box-sizing: border-box;
	width: 22rpx;
	height: 22rpx;
	border-color: #86cfe9;
	border-style: solid;
}

.guide-scan-corner-top-left {
	top: 42rpx;
	left: -2rpx;
	border-width: 3rpx 0 0 3rpx;
}

.guide-scan-corner-top-right {
	top: 42rpx;
	right: -2rpx;
	border-width: 3rpx 3rpx 0 0;
}

.guide-scan-corner-bottom-left {
	bottom: 10rpx;
	left: -2rpx;
	border-width: 0 0 3rpx 3rpx;
}

.guide-scan-corner-bottom-right {
	right: -2rpx;
	bottom: 10rpx;
	border-width: 0 3rpx 3rpx 0;
}

.registration-search-section {
	box-sizing: border-box;
	padding: 30rpx 0;
	background: #f8f8f8;
}

.appointment-search {
	box-sizing: border-box;
	width: 710rpx;
	height: 90rpx;
	margin: 0 auto;
	padding-left: 20rpx;
	border: 1rpx solid #5c8df7;
	border-radius: 20rpx;
	background: #ffffff;
}

.appointment-search-icon {
	flex: 0 0 40rpx;
	width: 40rpx;
	height: 40rpx;
	margin-right: 20rpx;
}

.appointment-search-input {
	height: 88rpx;
	font-size: 30rpx;
	line-height: 88rpx;
}

.appointment-search-button {
	flex: 0 0 128rpx;
	background: #5c8df7;
	font-size: 30rpx;
}

.error-message,
.state-card {
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.error-message {
	margin-top: 0;
	margin-bottom: 24rpx;
}

.state-card {
	margin-top: 0;
	margin-bottom: 24rpx;
}

.cascade-shell {
	display: flex;
	align-items: stretch;
	box-sizing: border-box;
	width: 100%;
	height: calc(100vh - 450rpx);
	min-height: 0;
	margin: 0;
	border-radius: 0;
	overflow: hidden;
	background: #ffffff;
}

.department-panel {
	flex: 0 0 300rpx;
	width: 300rpx;
	background: #f8f8f8;
}

.department-item {
	min-height: 87rpx;
	height: 87rpx;
	padding: 0 30rpx;
	border-bottom: 1rpx solid #dddddd;
	color: #282828;
	font-size: 28rpx;
	line-height: 87rpx;
}

.department-item-active {
	background: #ffffff;
	color: #282828;
	font-weight: 400;
}

.department-active-line {
	width: 10rpx;
	background: #dddddd;
}

.department-item-active .department-active-line {
	background: #5c8df7;
}

.department-name {
	display: block;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.directory-panel {
	display: flex;
	min-width: 0;
	flex: 1;
	flex-direction: column;
	background: #ffffff;
}

.directory-scroll {
	box-sizing: border-box;
	height: 100%;
	min-height: 0;
	background: #ffffff;
}

.panel-state-shell,
.panel-loading,
.panel-empty {
	box-sizing: border-box;
	height: 100%;
	min-height: 560rpx;
	background: #ffffff;
}

.department-option-list {
	background: #ffffff;
}

.department-option {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	min-height: 87rpx;
	height: 87rpx;
	padding: 0 30rpx;
	border-bottom: 1rpx solid #dddddd;
	background: #ffffff;
	color: #282828;
	font-size: 28rpx;
}

.department-option-active {
	background: #f1f1f1;
}

.department-option-name {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.department-option-chevron {
	box-sizing: border-box;
	width: 18rpx;
	height: 18rpx;
	margin-left: 20rpx;
	border-right: 3rpx solid #b7b7b7;
	border-bottom: 3rpx solid #b7b7b7;
	transform: rotate(45deg);
}

.department-option-chevron-open {
	transform: rotate(225deg);
}

.department-child-option-list {
	background: #eaeffd;
}

.department-child-option {
	display: flex;
	align-items: center;
	box-sizing: border-box;
	min-height: 87rpx;
	padding: 0 30rpx;
	border-bottom: 1rpx solid #dddddd;
	background: #eaeffd;
	color: #4b8eff;
	font-size: 28rpx;
	line-height: 1.35;
}
}

.selected-doctor-filter {
	box-sizing: border-box;
	height: 87rpx;
	margin: 0;
	padding: 0 30rpx;
	border-bottom: 1rpx solid #dddddd;
	border-radius: 0;
	background: #f1f1f1;
	color: #333333;
	font-size: 27rpx;
}

.selected-doctor-clear {
	color: #4b8eff;
	font-weight: 400;
}

.date-scroll {
	border-bottom: 1rpx solid #dddddd;
	background: #ffffff;
}

.date-list {
	padding: 16rpx 20rpx;
}

.date-item {
	min-width: 136rpx;
	margin-right: 12rpx;
	padding: 10rpx 14rpx;
	border-radius: 12rpx;
	background: #f1f2f5;
	color: #666666;
}

.date-item-active {
	background: #eaeffd;
	color: #4b8eff;
}

.schedule-list {
	padding: 0;
}

.schedule-item {
	min-height: 136rpx;
	margin: 0;
	border-bottom: 1rpx solid #dddddd;
	border-radius: 0;
	background: #ffffff;
	box-shadow: none;
}

.schedule-shift-badge {
	flex-basis: 58rpx;
	background: #eaeffd;
	color: #4b8eff;
}

.schedule-item-copy {
	padding: 18rpx 12rpx 16rpx 20rpx;
}

.schedule-item-action {
	flex-basis: 118rpx;
	padding: 18rpx 20rpx 16rpx 0;
}

.schedule-reserve {
	width: 92rpx;
	height: 52rpx;
	margin-top: 10rpx;
}

.load-more-button {
	width: calc(100% - 40rpx);
	margin: 20rpx;
}

.directory-scroll .readonly-note {
	box-sizing: border-box;
	width: auto;
	margin: 0 20rpx 20rpx;
	padding: 16rpx;
	border-radius: 12rpx;
	font-size: 22rpx;
}
