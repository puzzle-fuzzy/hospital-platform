page {
	background: #f5f5f5;
}

.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding: 24rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
}

.page-header,
.error-message,
.section,
.state-card,
.readonly-note {
	box-sizing: border-box;
	margin-right: auto;
	margin-left: auto;
	width: 710rpx;
}

.page-header {
	margin-bottom: 20rpx;
}

.page-title {
	color: #222222;
	font-size: 38rpx;
	font-weight: 700;
	line-height: 1.5;
}

.page-description {
	margin-top: 8rpx;
	color: #888888;
	font-size: 26rpx;
	line-height: 1.6;
}

.error-message {
	margin-bottom: 20rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff1f1;
	color: #ff4444;
	font-size: 26rpx;
	line-height: 1.5;
	text-align: center;
}

.section {
	margin-bottom: 24rpx;
}

.section-title {
	margin-bottom: 16rpx;
	color: #333333;
	font-size: 30rpx;
	font-weight: 700;
}

.department-scroll {
	width: 710rpx;
	white-space: nowrap;
}

.department-list {
	display: inline-flex;
	gap: 16rpx;
}

.department-chip {
	display: inline-flex;
	align-items: flex-start;
	flex-direction: column;
	box-sizing: border-box;
	padding: 18rpx 22rpx;
	min-width: 220rpx;
	border: 1rpx solid #dbe5ff;
	border-radius: 16rpx;
	background: #f2f6ff;
}

.department-name {
	color: #3d6df6;
	font-size: 28rpx;
	font-weight: 700;
}

.department-location {
	margin-top: 8rpx;
	color: #777777;
	font-size: 23rpx;
}

.schedule-card {
	box-sizing: border-box;
	margin-bottom: 16rpx;
	padding: 24rpx 26rpx;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 24rpx rgba(61, 109, 246, 0.06);
}

.schedule-header,
.schedule-main,
.schedule-footer {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.schedule-date {
	color: #3d6df6;
	font-size: 29rpx;
	font-weight: 700;
}

.schedule-slots {
	color: #16a34a;
	font-size: 25rpx;
}

.schedule-main {
	justify-content: flex-start;
	gap: 20rpx;
	margin-top: 18rpx;
}

.schedule-department {
	color: #222222;
	font-size: 31rpx;
	font-weight: 700;
}

.schedule-doctor {
	color: #666666;
	font-size: 27rpx;
}

.schedule-footer {
	justify-content: flex-start;
	gap: 24rpx;
	margin-top: 14rpx;
	color: #888888;
	font-size: 25rpx;
}

.state-card {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	margin-top: 80rpx;
	padding: 44rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	color: #777777;
	font-size: 28rpx;
}

.state-card-empty {
	flex-direction: column;
}

.state-card-empty image {
	display: block;
	margin-bottom: 20rpx;
	width: 220rpx;
}

.state-hint {
	margin-top: 12rpx;
	color: #aaaaaa;
	font-size: 24rpx;
}

.readonly-note {
	margin-top: 30rpx;
	padding: 20rpx;
	border-radius: 12rpx;
	background: #fff7ee;
	color: #d56d2a;
	font-size: 24rpx;
	line-height: 1.6;
}
