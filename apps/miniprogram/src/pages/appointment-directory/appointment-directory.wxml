<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="appointment-page">
		<!-- 蓝湖“选择科室”首屏：导诊区域保持独立的白色背景。 -->
		<view class="registration-hero-section">
			<view class="registration-hero">
				<view class="registration-hero-copy">
					<text class="registration-hero-title">挂什么科？找哪个医生？</text>
					<view class="registration-hero-guide">
						<text>智能导诊为您推荐</text>
						<view class="guide-button" bindtap="onGuideTap">去看看 &gt;</view>
					</view>
				</view>

				<!-- 使用本地导诊插画；裁切掉素材自带的悬浮按钮，只保留产品图中的医生。 -->
				<view class="registration-hero-illustration">
					<view class="guide-scan-corner guide-scan-corner-top-left"></view>
					<view class="guide-scan-corner guide-scan-corner-top-right"></view>
					<view class="guide-scan-corner guide-scan-corner-bottom-left"></view>
					<view class="guide-scan-corner guide-scan-corner-bottom-right"></view>
					<view class="registration-hero-portrait">
						<image
							class="registration-hero-image"
							src="/assets/legacy-home/floating-guide.png"
							mode="widthFix"
						/>
					</view>
				</view>
			</view>
		</view>

		<!-- 搜索只匹配已读取的安全目录，不把自由文本透传给 Provider。 -->
		<view class="registration-search-section">
			<view class="appointment-search">
				<image
					class="appointment-search-icon"
					src="/assets/legacy-user/location-search.svg"
					mode="aspectFit"
				/>
				<input
					class="appointment-search-input"
					value="{{searchText}}"
					placeholder="请输入科室或医生名字"
					placeholder-class="appointment-search-placeholder"
					maxlength="32"
					confirm-type="search"
					bindinput="onSearchInput"
					bindconfirm="onSearchTap"
				/>
				<view class="appointment-search-button" bindtap="onSearchTap">搜索</view>
			</view>
		</view>

		<!-- 错误提示置于页面首部，避免用户先看到不可用的业务内容。 -->
		<view wx:if="{{error}}" class="error-message">{{error}}</view>

		<!--
			首层目录的状态必须复用同一个外壳。错误必须先于级联和空态判断，
			避免 Provider 失败被显示成无科室；空科室和加载中也不能改变页面高度。
		-->
		<view wx:if="{{error || !departments.length}}" class="state-card query-state-shell query-state-shell-column">
			<block wx:if="{{loading}}">
				<text>正在加载预约科室...</text>
			</block>
			<block wx:elif="{{error}}">
				<text>本次预约目录未加载成功</text>
				<text class="state-hint">请稍后再试</text>
				<view class="state-hint state-hint-action" bindtap="onRetry">再试一次</view>
			</block>
			<block wx:else>
				<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
				<text>当前暂无可预约科室</text>
				<text class="state-hint">请稍后刷新，或联系医院确认排班安排</text>
			</block>
		</view>

		<!-- 图 1 的真实三级目录：左栏一级科室，右栏二级科室，展开后才读取细分门诊。 -->
		<view wx:elif="{{departments.length}}" class="cascade-shell">
			<scroll-view class="department-panel" scroll-y="true" enhanced="true">
				<view
					wx:for="{{departmentGroups}}"
					wx:for-item="group"
					wx:key="groupId"
					class="department-item {{group.groupId === selectedDepartmentGroupId ? 'department-item-active' : ''}}"
					bindtap="onDepartmentGroupTap"
					data-group-id="{{group.groupId}}"
				>
					<view class="department-active-line"></view>
					<text class="department-name">{{group.displayName}}</text>
				</view>
			</scroll-view>

			<view class="directory-panel">
				<scroll-view class="directory-scroll" scroll-y="true" enhanced="true">
					<view wx:if="{{!currentGroupDepartments.length}}" class="panel-empty query-state-shell query-state-shell-column">
						<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
						<text>当前分类暂无可预约科室</text>
						<text class="state-hint">请切换其他分类或稍后刷新</text>
					</view>

					<block wx:else>
						<view
							wx:for="{{currentGroupDepartments}}"
							wx:for-item="department"
							wx:key="departmentId"
							class="department-option-list"
						>
							<view
								class="department-option {{department.departmentId === selectedDepartmentId ? 'department-option-active' : ''}}"
								bindtap="onDepartmentTap"
								data-department-id="{{department.departmentId}}"
							>
								<text class="department-option-name">{{department.displayName}}</text>
								<view class="department-option-chevron {{department.departmentId === selectedDepartmentId ? 'department-option-chevron-open' : ''}}"></view>
							</view>

							<block wx:if="{{department.departmentId === selectedDepartmentId}}">
								<view wx:if="{{clinicLoading}}" class="panel-loading query-state-shell query-state-shell-column">
									<text>正在加载细分门诊...</text>
								</view>
								<view wx:elif="{{clinicError}}" class="panel-empty query-state-shell query-state-shell-column">
									<text>{{clinicError}}</text>
									<view class="state-hint state-hint-action" bindtap="onClinicRetry">重新加载细分门诊</view>
								</view>

								<!-- 二级科室展开后先展示旧项目中的真实三级门诊，而不是医生。 -->
								<view wx:elif="{{clinicDepartments.length}}" class="department-child-option-list">
									<block
										wx:for="{{clinicDepartments}}"
										wx:for-item="clinic"
										wx:key="departmentId"
									>
										<view
										class="department-child-option {{clinic.departmentId === selectedClinicDepartmentId ? 'department-child-option-active' : ''}}"
										bindtap="onClinicDepartmentTap"
										data-clinic-department-id="{{clinic.departmentId}}"
									>
										<text>{{clinic.displayName}}</text>
									</view>

									<!-- 只有明确选择三级门诊后，才进入医生和号源读取。 -->
									<block wx:if="{{clinic.departmentId === selectedClinicDepartmentId}}">
										<view wx:if="{{scheduleLoading}}" class="panel-loading query-state-shell query-state-shell-column">
											<text>正在加载可预约信息...</text>
										</view>
										<view wx:elif="{{scheduleError}}" class="panel-empty query-state-shell query-state-shell-column">
											<text>{{scheduleError}}</text>
											<view class="state-hint state-hint-action" bindtap="onScheduleRetry">重新加载医生和号源</view>
										</view>

										<view wx:elif="{{activeMode === 'doctor' && doctorCards.length}}" class="doctor-option-list">
											<view
												wx:for="{{doctorCards}}"
												wx:for-item="doctor"
												wx:key="doctorId"
												class="doctor-option"
												bindtap="onDoctorCardTap"
												data-doctor-id="{{doctor.doctorId}}"
											>
												<text>{{doctor.doctorName}}</text>
											</view>
										</view>

										<!-- 选择医生后才在已选三级门诊内查看日期和号源。 -->
										<block wx:elif="{{activeMode === 'date'}}">
									<view wx:if="{{selectedDoctorName}}" class="selected-doctor-filter">
										<text>已选择：{{selectedDoctorName}}</text>
										<view class="selected-doctor-clear" bindtap="onClearDoctorFilter">返回列表</view>
									</view>

									<scroll-view class="date-scroll" scroll-x="true" enhanced="true">
										<view class="date-list">
												<view
													wx:for="{{dateGroups}}"
													wx:for-item="dateGroup"
													wx:key="workDate"
													class="date-item {{dateGroup.workDate === selectedDate ? 'date-item-active' : ''}}"
													bindtap="onDateTap"
													data-date="{{dateGroup.workDate}}"
												>
													<text class="date-label">{{dateGroup.label}}</text>
													<text class="date-count">{{dateGroup.count}} 个号源</text>
											</view>
										</view>
									</scroll-view>

									<view class="schedule-list">
										<view
											wx:for="{{visibleSchedules}}"
											wx:for-item="schedule"
											wx:key="scheduleId"
											class="schedule-item"
											bindtap="onScheduleTap"
											data-schedule-id="{{schedule.scheduleId}}"
										>
											<view class="schedule-shift-badge">{{schedule.shiftName}}</view>
											<view class="schedule-item-copy">
												<text class="schedule-doctor">{{schedule.doctorName}}</text>
												<text class="schedule-department">{{schedule.departmentName}}</text>
												<text wx:if="{{schedule.startTime && schedule.endTime}}" class="schedule-time">{{schedule.startTime}} - {{schedule.endTime}}</text>
												<text wx:else class="schedule-time">具体时间以医院排班为准</text>
											</view>
											<view class="schedule-item-action">
												<text class="schedule-slots {{schedule.availableSlots > 0 ? 'schedule-slots-available' : 'schedule-slots-empty'}}">余 {{schedule.availableSlots}} 号</text>
												<view class="schedule-reserve {{schedule.availableSlots > 0 ? 'schedule-reserve-active' : 'schedule-reserve-disabled'}}">{{schedule.availableSlots > 0 ? '预约' : '约满'}}</view>
											</view>
										</view>
									</view>

									<button wx:if="{{hasMoreSchedules}}" class="load-more-button" bindtap="onLoadMore">
										加载更多号源
									</button>

									<view class="readonly-note">
										当前可浏览未来 7 天医院已公开的排班。预约下单、锁号、取消和支付功能正在完善中。
									</view>
										</block>

										<view wx:else class="panel-empty query-state-shell query-state-shell-column">
											<text>当前门诊暂无可预约信息</text>
											<text class="state-hint">请切换其他门诊或稍后刷新</text>
										</view>
									</block>
									</block>
								</view>

								<view wx:else class="panel-empty query-state-shell query-state-shell-column">
									<text>当前科室暂无细分门诊</text>
									<text class="state-hint">请切换其他科室或稍后刷新</text>
								</view>
							</block>
						</view>
					</block>
				</scroll-view>
			</view>
		</view>
	</view>
</scroll-view>
