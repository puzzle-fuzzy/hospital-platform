<view class="page">
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view class="page-header">
		<view class="page-title">预约挂号</view>
		<view class="page-description">展示未来 7 天已同步的科室与排班信息</view>
	</view>

	<view wx:if="{{loading}}" class="state-card">
		<text>正在加载预约目录...</text>
	</view>

	<view wx:elif="{{departments.length || schedules.length}}">
		<view wx:if="{{departments.length}}" class="section">
			<view class="section-title">可预约科室（{{departments.length}}）</view>
			<scroll-view class="department-scroll" scroll-x>
				<view class="department-list">
					<view wx:for="{{departments}}" wx:key="departmentId" class="department-chip">
						<text class="department-name">{{item.displayName}}</text>
						<text wx:if="{{item.location}}" class="department-location">{{item.location}}</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<view wx:if="{{schedules.length}}" class="section">
			<view class="section-title">未来排班（{{schedules.length}}）</view>
			<view wx:for="{{schedules}}" wx:key="scheduleId" class="schedule-card">
				<view class="schedule-header">
					<view class="schedule-date">{{item.workDate}}</view>
					<view class="schedule-slots">余 {{item.availableSlots}} 号</view>
				</view>
				<view class="schedule-main">
					<view class="schedule-department">{{item.departmentName}}</view>
					<view class="schedule-doctor">{{item.doctorName}}</view>
				</view>
				<view class="schedule-footer">
					<text>{{item.shiftName}}</text>
					<text wx:if="{{item.startTime && item.endTime}}">{{item.startTime}} - {{item.endTime}}</text>
					<text wx:else>时间待医院确认</text>
				</view>
			</view>
		</view>
	</view>

	<view wx:elif="{{!loading}}" class="state-card state-card-empty">
		<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
		<text>未来 7 天暂无可展示的预约排班</text>
		<text class="state-hint">请稍后刷新，或以医院实际放号为准</text>
	</view>

	<view class="readonly-note">
		当前为预约目录查询。预约下单、锁号、取消和支付将在真实业务契约与线上验收完成后开放。
	</view>
</view>
