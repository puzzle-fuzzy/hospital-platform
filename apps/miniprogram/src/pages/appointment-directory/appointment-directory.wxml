<view class="page">
	<!-- 错误提示置于页面首部，避免用户先看到不可用的业务内容。 -->
	<view wx:if="{{error}}" class="error-message">{{error}}</view>

	<view class="page-header">
		<view class="page-title">预约挂号</view>
		<view class="page-description">未来 7 天可预约科室与排班</view>
	</view>

	<!--
		首层目录的状态必须复用同一个外壳。错误必须先于级联和空态判断，
		避免 Provider 失败被显示成无科室；空科室和加载中也不能改变页面高度。
	-->
	<view wx:if="{{error || !departments.length}}" class="state-card query-state-shell query-state-shell-column">
		<block wx:if="{{loading}}">
			<text>正在加载预约科室...</text>
		</block>
		<block wx:elif="{{error}}">
			<text>本次预约目录未加载成功</text>
			<text class="state-hint">请根据上方提示处理后重试</text>
			<view class="state-hint state-hint-action" bindtap="onRetry">重新加载</view>
		</block>
		<block wx:else>
			<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
			<text>当前暂无可预约科室</text>
			<text class="state-hint">请稍后刷新，或联系医院确认排班安排</text>
		</block>
	</view>

	<view wx:elif="{{departments.length}}" class="cascade-shell">
		<!-- 左栏：旧版一级科室导航；只负责改变右栏上下文。 -->
		<scroll-view class="department-panel" scroll-y>
			<view
				wx:for="{{departments}}"
				wx:key="departmentId"
				class="department-item {{item.departmentId === selectedDepartmentId ? 'department-item-active' : ''}}"
				bindtap="onDepartmentTap"
				data-department-id="{{item.departmentId}}"
			>
				<view class="department-active-line"></view>
				<text class="department-name">{{item.displayName}}</text>
			</view>
		</scroll-view>

		<!-- 右栏：当前科室的日期级联和号源；不把所有科室排班同时绘制。 -->
		<view class="schedule-panel">
			<view class="schedule-panel-header">
				<text class="schedule-panel-title">{{selectedDepartmentName || '选择科室'}}</text>
				<text class="schedule-panel-count">{{schedules.length}} 个排班</text>
			</view>

			<scroll-view class="schedule-scroll" scroll-y>
				<!-- 排班状态复用外壳；切换科室时不能因空态插图把右栏撑高。 -->
				<view wx:if="{{loading || !dateGroups.length}}" class="panel-state-shell query-state-shell query-state-shell-column">
					<view wx:if="{{loading}}" class="panel-loading query-state-shell query-state-shell-column">
						<text>正在加载排班...</text>
					</view>
					<view wx:else class="panel-empty query-state-shell query-state-shell-column">
						<image src="/assets/legacy-home/empty-services.png" mode="widthFix" />
						<text>当前科室暂无排班</text>
						<text class="state-hint">请切换其他科室或稍后刷新</text>
					</view>
				</view>

				<block wx:elif="{{dateGroups.length}}">
					<scroll-view class="date-scroll" scroll-x>
						<view class="date-list">
							<view
								wx:for="{{dateGroups}}"
								wx:key="workDate"
								class="date-item {{item.workDate === selectedDate ? 'date-item-active' : ''}}"
								bindtap="onDateTap"
								data-date="{{item.workDate}}"
							>
								<text class="date-label">{{item.label}}</text>
								<text class="date-count">{{item.count}} 个号源</text>
							</view>
						</view>
					</scroll-view>

					<view class="schedule-list">
						<view
							wx:for="{{visibleSchedules}}"
							wx:key="scheduleId"
							class="schedule-item"
							bindtap="onScheduleTap"
							data-schedule-id="{{item.scheduleId}}"
						>
							<view class="schedule-item-main">
								<text class="schedule-doctor">{{item.doctorName}}</text>
								<text class="schedule-shift">{{item.shiftName}}</text>
							</view>
							<view class="schedule-item-meta">
								<text wx:if="{{item.startTime && item.endTime}}">{{item.startTime}} - {{item.endTime}}</text>
								<text wx:else>时间待确认</text>
								<text class="schedule-slots">余 {{item.availableSlots}} 号</text>
							</view>
						</view>
					</view>

					<button
						wx:if="{{hasMoreSchedules}}"
						class="load-more-button"
						bindtap="onLoadMore"
					>
						加载更多号源
					</button>
				</block>

			</scroll-view>
		</view>
	</view>

	<view class="readonly-note">
		当前为预约目录查询。预约下单、锁号、取消和支付将在真实业务契约与线上验收完成后开放。
	</view>
</view>
