.page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-top: 20rpx;
	background: #f5f5f5;
}

.report-state-card {
	box-sizing: border-box;
	min-height: 360rpx;
	margin: 20rpx;
	border-radius: 16rpx;
	background: #ffffff;
}

.loading-state {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 40rpx 28rpx;
	color: #666666;
	font-size: 28rpx;
}

.report-head {
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.report-count {
	margin-bottom: 20rpx;
	color: #333333;
	font-size: 28rpx;
}

.report-card {
	overflow: hidden;
	border-radius: 16rpx;
}

.report-title {
	box-sizing: border-box;
	padding: 30rpx;
	background: #4d90ff;
	color: #ffffff;
	font-size: 40rpx;
	font-weight: 600;
	line-height: 1.35;
}

.report-actions {
	display: flex;
	align-items: center;
	justify-content: space-between;
	background: #3a68cc;
	color: #ffffff;
}

.report-action {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 50%;
	gap: 20rpx;
	padding: 16rpx 0;
	font-size: 24rpx;
}

.report-download-icon {
	display: block;
	height: 30rpx;
}

.report-share-icon {
	display: block;
	height: 23rpx;
}

.report-tabs-wrap {
	box-sizing: border-box;
	margin-top: 40rpx;
	margin-bottom: 40rpx;
	padding: 20rpx 0;
	background: #ffffff;
}

.report-tabs {
	display: flex;
	align-items: center;
	width: 710rpx;
	margin-right: auto;
	margin-left: auto;
}

.report-tab {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 50%;
	padding: 16rpx 0;
	border-radius: 12rpx;
	flex-direction: column;
	gap: 20rpx;
	color: #333333;
	font-size: 28rpx;
}

.report-tab-icon {
	display: block;
	height: 77rpx;
}

.report-content,
.cloud-empty {
	box-sizing: border-box;
	border-radius: 16rpx;
	background: #ffffff;
}

.report-content {
	padding: 24rpx;
}

.report-items {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}

.report-item {
	padding-bottom: 16rpx;
	border-bottom: 1rpx solid #f5f5f5;
}

.report-item:last-child {
	padding-bottom: 0;
	border-bottom: 0;
}

.report-item-heading,
.report-item-result {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.report-item-heading {
	margin-bottom: 12rpx;
}

.report-item-name {
	color: #333333;
	font-size: 28rpx;
	font-weight: 600;
}

.report-item-flag {
	padding: 4rpx 12rpx;
	border-radius: 6rpx;
	font-size: 24rpx;
}

.report-item-flag-high,
.report-item-flag-critical {
	background: #ffe5e5;
	color: #ff4444;
}

.report-item-flag-low {
	background: #e5f3ff;
	color: #0066ff;
}

.report-item-flag-normal,
.report-item-flag-unknown {
	background: #f5f5f5;
	color: #666666;
}

.report-item-result {
	justify-content: flex-start;
	gap: 24rpx;
	color: #666666;
	font-size: 24rpx;
}

.report-item-range {
	display: block;
	margin-top: 8rpx;
	color: #999999;
	font-size: 24rpx;
}

.report-empty,
.cloud-empty {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	min-height: 360rpx;
	color: #999999;
	font-size: 28rpx;
}

.report-empty-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 120rpx;
	height: 120rpx;
	margin-bottom: 24rpx;
	border-radius: 50%;
	background: #f2f6ff;
	color: #3d6df6;
	font-size: 64rpx;
}

.cloud-empty-icon {
	margin-bottom: 24rpx;
	font-size: 120rpx;
	line-height: 1;
}

.error-state {
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	padding: 48rpx 28rpx;
	border: 1rpx solid #ffd8d8;
	background: #fff7f7;
}

.error-title {
	color: #333333;
	font-size: 30rpx;
	font-weight: 600;
}

.error-message {
	display: block;
	margin-top: 10rpx;
	color: #ff4444;
	font-size: 24rpx;
	text-align: center;
}

.bottom-action-wrap {
	position: fixed;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 30;
	box-sizing: border-box;
	padding: 0 20rpx;
	padding-bottom: env(safe-area-inset-bottom);
}

.bottom-action {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	width: 710rpx;
	height: 100rpx;
	margin-right: auto;
	margin-left: auto;
	padding: 0 30rpx;
	overflow: hidden;
	border-radius: 18rpx;
	background: rgb(0 0 0 / 80%);
}

.bottom-action-hint {
	padding: 24rpx 0;
	border-radius: 12rpx;
	color: rgb(255 255 255 / 60%);
	font-size: 28rpx;
}

.bottom-action-button {
	box-sizing: border-box;
	padding: 16rpx 20rpx;
	border-radius: 12rpx;
	background: #3d6df6;
	color: #ffffff;
	font-size: 28rpx;
	white-space: nowrap;
}

.bottom-spacer {
	height: calc(140rpx + env(safe-area-inset-bottom));
}
