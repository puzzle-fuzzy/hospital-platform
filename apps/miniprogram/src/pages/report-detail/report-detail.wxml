<scroll-view class="secondary-page-scroll" scroll-y="true" enhanced="true">
	<view class="page">
	<!-- 加载、错误和合法空结果共用同一高度，避免临床读模型收敛时页面突然撑高。 -->
	<view
		wx:if="{{loading || error}}"
		class="report-state-card query-state-shell query-state-shell-column {{error ? 'error-state' : 'loading-state'}}"
	>
		<block wx:if="{{loading}}">
			<text>加载中...</text>
		</block>
		<block wx:else>
			<text class="error-title">报告详情不可用</text>
			<text class="error-message">{{error}}</text>
			<button
				wx:if="{{sourcePatientId && sourceReportId}}"
				class="report-retry"
				size="mini"
				bindtap="onRetry"
			>重新加载</button>
		</block>
	</view>

	<block wx:elif="{{!error}}">
		<view class="report-head">
			<view wx:if="{{reportCount > 0}}" class="report-count">您共有{{reportCount}}份检查报告</view>
			<view class="report-card">
				<view class="report-title">{{title}}</view>
				<view class="report-actions">
					<view class="report-action" bindtap="onDownloadCloudImage">
						<image src="/assets/legacy-home/report-download.svg" mode="heightFix" class="report-download-icon" />
						<text>打开报告附件</text>
					</view>
					<view class="report-action" bindtap="onShareReport">
						<image src="/assets/legacy-home/report-share.svg" mode="heightFix" class="report-share-icon" />
						<text>分享报告</text>
					</view>
				</view>
			</view>
		</view>

		<view class="report-tabs-wrap">
			<view class="report-tabs">
				<view class="report-tab {{activeTab === 'report' ? 'report-tab-active' : ''}}" bindtap="onTabChange" data-tab="report">
					<image src="/assets/legacy-home/report-tab.svg" mode="heightFix" class="report-tab-icon" />
					<text>图文报告</text>
				</view>
				<view class="report-tab {{activeTab === 'image' ? 'report-tab-active' : ''}}" bindtap="onTabChange" data-tab="image">
					<image src="/assets/legacy-home/report-cloud.svg" mode="heightFix" class="report-tab-icon" />
					<text>报告附件</text>
				</view>
			</view>
		</view>

		<view wx:if="{{activeTab === 'report'}}" class="report-content">
			<view class="report-basic">
				<text wx:if="{{selectedPatientName}}">患者姓名：{{selectedPatientName}}</text>
				<text>{{kindLabel}}</text>
				<text>{{reportedAt}}</text>
			</view>
			<view wx:if="{{kind === 'laboratory' && hasItems}}" class="report-items">
				<view wx:for="{{items}}" wx:key="index" class="report-item">
					<view class="report-item-heading">
						<text class="report-item-name">{{item.name}}</text>
						<text wx:if="{{item.flagLabel}}" class="report-item-flag report-item-flag-{{item.flag}}">{{item.flagLabel}}</text>
					</view>
					<view class="report-item-result">
						<text wx:if="{{item.result}}">结果：{{item.result}}</text>
						<text wx:if="{{item.unit}}">{{item.unit}}</text>
					</view>
						<text wx:if="{{item.referenceRange}}" class="report-item-range">参考范围：{{item.referenceRange}}</text>
						<text wx:if="{{item.expertOpinion}}" class="report-item-opinion">专家意见：{{item.expertOpinion}}</text>
					</view>
			</view>
			<view wx:elif="{{kind !== 'laboratory' && hasGenericContent}}" class="report-generic">
				<view wx:for="{{fields}}" wx:key="label" class="report-field">
					<text class="report-field-label">{{item.label}}</text>
					<text class="report-field-value">{{item.value}}</text>
				</view>
				<view wx:for="{{sections}}" wx:key="title" class="report-section">
					<text class="report-section-title">{{item.title}}</text>
					<text class="report-section-content">{{item.content}}</text>
				</view>
			</view>
			<view wx:else class="report-empty">
				<text class="report-empty-icon">阅</text>
				<text>暂无可展示的检测项</text>
			</view>
		</view>

		<view wx:else class="report-content">
			<view wx:if="{{attachments.length}}" class="attachment-list">
				<view
					wx:for="{{attachments}}"
					wx:key="attachmentId"
					class="attachment-item"
					bindtap="onAttachmentTap"
					data-attachment-id="{{item.attachmentId}}"
				>
					<text class="attachment-label">{{item.label}}</text>
					<text class="attachment-action">{{openingAttachmentId === item.attachmentId ? '正在打开' : '查看'}}</text>
				</view>
			</view>
			<view wx:else class="cloud-empty">
				<text class="cloud-empty-icon">☁️</text>
				<text>众阳当前未返回可用附件</text>
			</view>
		</view>
	</block>

	<view wx:if="{{!loading && !error}}" class="bottom-action-wrap">
		<view class="bottom-action">
			<text class="bottom-action-hint">如需进一步就诊，可按科室预约挂号</text>
			<view class="bottom-action-button" bindtap="onGotoConsultation">复诊预约挂号</view>
		</view>
	</view>

	<view wx:if="{{!loading && !error}}" class="bottom-spacer"></view>
</view>
</scroll-view>
