<view class="page">
	<view class="card">
		<text class="eyebrow">LABORATORY REPORT</text>
		<text class="title">{{title}}</text>
		<view wx:if="{{reportedAt}}" class="line">
			<text class="label">报告时间</text>
			<text>{{reportedAt}}</text>
		</view>
		<text wx:if="{{error}}" class="error">{{error}}</text>
		<view wx:if="{{loading}}" class="empty">正在读取服务端报告详情…</view>
		<view wx:if="{{!loading && !hasItems && !error}}" class="empty">暂无可展示的检测项</view>
	</view>

	<view wx:if="{{hasItems}}" class="card result-card">
		<view class="section-header">
			<text class="section-title">检测结果</text>
			<text class="section-hint">服务端白名单</text>
		</view>
		<view wx:for="{{items}}" wx:key="index" class="result-row">
			<view class="result-main">
				<text class="result-name">{{item.name}}</text>
				<text wx:if="{{item.referenceRange}}" class="result-meta">参考范围：{{item.referenceRange}}</text>
			</view>
			<view class="result-value">
				<text class="result-number">{{item.result}}{{item.unit || ""}}</text>
				<text class="result-flag result-flag-{{item.flag}}">{{item.flag}}</text>
			</view>
		</view>
	</view>

	<view wx:if="{{hasAttachment}}" class="card attachment-card">
		<text class="section-title">附件</text>
		<text class="attachment-hint">服务端已标记存在附件，文件访问能力尚未开放。</text>
	</view>
</view>
