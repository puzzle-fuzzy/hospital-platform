<scroll-view class="migration-surface-scroll" scroll-y="true" enhanced="true">
	<view class="migration-surface-page">
		<view class="migration-surface-hero">
			<image class="migration-surface-icon" src="{{icon}}" mode="aspectFit" />
			<view class="migration-surface-hero-copy">
				<text class="migration-surface-title">{{title}}</text>
				<text class="migration-surface-label">{{surfaceLabel}}</text>
			</view>
		</view>
		<view class="migration-surface-card">
			<text class="migration-surface-card-title">{{scopeTitle}}</text>
			<text class="migration-surface-card-copy">{{scopeDescription}}</text>
		</view>

		<view class="migration-surface-patient-card">
			<view class="migration-surface-patient-copy">
				<text class="migration-surface-patient-label">当前就诊人</text>
				<block wx:if="{{patientContextLoading && !patientContextLoaded}}">
					<text class="migration-surface-patient-name">正在获取就诊人...</text>
					<text class="migration-surface-patient-meta">当前只读取已确认的患者目录</text>
				</block>
				<block wx:elif="{{patientContextError}}">
					<text wx:if="{{currentPatient}}" class="migration-surface-patient-name">{{currentPatientName}}</text>
					<text wx:if="{{currentPatient}}" class="migration-surface-patient-meta">{{currentPatientCardLabel}}</text>
					<text class="migration-surface-patient-error">{{patientContextError}}</text>
					<button class="migration-surface-patient-retry" bindtap="onRetry">重新读取</button>
				</block>
				<block wx:else>
					<text class="migration-surface-patient-name">{{currentPatientName}}</text>
					<text class="migration-surface-patient-meta">{{currentPatientCardLabel}}</text>
				</block>
			</view>
			<button class="migration-surface-patient-action" bindtap="onOpenPatientSelector">{{patientActionLabel}}</button>
		</view>
		<view class="migration-surface-card">
			<text class="migration-surface-card-title">服务状态</text>
			<text class="migration-surface-card-copy">{{description}}</text>
			<view class="migration-surface-list">
				<view wx:for="{{boundaryItems}}" wx:key="*this" class="migration-surface-list-row">
					<text class="migration-surface-list-dot">·</text><text class="migration-surface-list-text">{{item}}</text>
				</view>
			</view>
		</view>
		<view class="migration-surface-card">
			<text class="migration-surface-card-title">使用说明</text>
			<view class="migration-surface-list">
				<view wx:for="{{contractItems}}" wx:key="*this" class="migration-surface-list-row">
					<text class="migration-surface-list-dot">·</text><text class="migration-surface-list-text">{{item}}</text>
				</view>
			</view>
			<text class="migration-surface-coverage">{{coverageLabel}}</text>
		</view>
		<button class="migration-surface-primary-button" bindtap="onOpenMigrationStatus">了解服务进度</button>
		<button class="migration-surface-plain-button" bindtap="onBackHome">返回医疗服务</button>
	</view>
</scroll-view>
