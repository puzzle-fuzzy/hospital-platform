<scroll-view class="my-doctor-scroll" scroll-y="true" enhanced="true">
	<view class="my-doctor-page">
		<view class="my-doctor-header">
			<text class="my-doctor-title">我的医生</text>
			<text class="my-doctor-subtitle">关注的医生会持续显示在这里</text>
		</view>

		<view wx:if="{{loading}}" class="my-doctor-state">
			<view class="my-doctor-spinner"></view>
			<text>正在加载我的医生...</text>
		</view>

		<view wx:elif="{{error}}" class="my-doctor-state my-doctor-state-error">
			<image class="my-doctor-state-icon" src="/assets/legacy-user/doctor.svg" mode="aspectFit" />
			<text>{{error}}</text>
			<view class="my-doctor-retry" bindtap="onRetry">重新加载</view>
		</view>

		<view wx:elif="{{!items.length}}" class="my-doctor-state">
			<image class="my-doctor-state-icon" src="/assets/legacy-user/doctor.svg" mode="aspectFit" />
			<text class="my-doctor-empty-title">还没有关注医生</text>
			<text class="my-doctor-empty-copy">在预约目录中打开医生名片即可关注</text>
		</view>

		<view wx:else class="my-doctor-list">
			<view
				wx:for="{{items}}"
				wx:key="doctorId"
				class="my-doctor-card"
				bindtap="onDoctorTap"
				data-doctor-id="{{item.doctorId}}"
			>
				<image
					wx:if="{{item.doctorAvatarUrl}}"
					class="my-doctor-avatar my-doctor-avatar-photo"
					src="{{item.doctorAvatarUrl}}"
					mode="aspectFill"
					lazy-load="{{true}}"
					aria-label="医生照片"
				/>
				<image
					wx:else
					class="my-doctor-avatar"
					src="/assets/legacy-user/default-avatar.svg"
					mode="aspectFit"
					aria-label="默认医生头像"
				/>
				<view class="my-doctor-card-copy">
					<view class="my-doctor-name-line">
						<text class="my-doctor-name">{{item.doctorName}}</text>
						<text wx:if="{{item.titleName}}" class="my-doctor-title-name">{{item.titleName}}</text>
					</view>
					<text class="my-doctor-department">{{item.departmentName}}</text>
					<text wx:if="{{item.departmentLocation}}" class="my-doctor-location">{{item.departmentLocation}}</text>
					<text wx:if="{{item.expertise}}" class="my-doctor-expertise">{{item.expertise}}</text>
				</view>
				<image
					class="my-doctor-arrow"
					src="/assets/legacy-user/arrow-right.svg"
					mode="aspectFit"
					aria-label="查看医生详情"
				/>
			</view>
		</view>
	</view>
</scroll-view>
