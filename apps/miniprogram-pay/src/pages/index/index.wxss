.hero {
	padding: 18rpx 4rpx 30rpx;
}

.eyebrow {
	margin-bottom: 12rpx;
	color: #2677ff;
	font-size: 22rpx;
	font-weight: 700;
	letter-spacing: 4rpx;
}

.title {
	font-size: 46rpx;
	font-weight: 700;
	letter-spacing: 1rpx;
}

.subtitle {
	margin-top: 14rpx;
	color: #8b949e;
	font-size: 26rpx;
}

.picker-row,
.condition-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.picker-row {
	min-height: 66rpx;
}

.arrow {
	color: #9aa3ad;
	font-size: 42rpx;
}

.patient-meta {
	margin-top: 8rpx;
}

.condition-row {
	padding: 12rpx 0;
	color: #747d87;
	font-size: 28rpx;
	border-bottom: 1rpx solid #f0f1f3;
}

.condition-row:last-of-type {
	border-bottom: 0;
}

.schedule-detail,
.source-detail {
	margin-top: 22rpx;
	padding-top: 22rpx;
	border-top: 1rpx solid #edf0f4;
}

.doctor {
	margin-bottom: 8rpx;
	font-size: 30rpx;
	font-weight: 600;
}

.doctor text {
	margin-left: 12rpx;
	color: #2677ff;
	font-size: 24rpx;
	font-weight: 400;
}

.source-title {
	color: #747d87;
	font-size: 24rpx;
}

.source-time {
	margin: 8rpx 0;
	color: #2677ff;
	font-size: 34rpx;
	font-weight: 600;
}

.duplicate-card {
	box-sizing: border-box;
	margin-bottom: 24rpx;
	padding: 28rpx;
	background: #fff5f3;
	border: 1rpx solid #ffd9d2;
	border-radius: 24rpx;
}

.duplicate-title {
	color: #c43d3d;
	font-size: 31rpx;
	font-weight: 600;
}

.duplicate-text,
.duplicate-hint {
	margin-top: 12rpx;
	color: #8c5651;
	font-size: 26rpx;
	line-height: 1.6;
}

.duplicate-hint {
	color: #9b7772;
}

.status-card {
	display: flex;
	align-items: center;
	gap: 14rpx;
	box-sizing: border-box;
	margin-bottom: 24rpx;
	padding: 24rpx 28rpx;
	background: #eef5ff;
	border-radius: 20rpx;
}

.status-dot {
	width: 14rpx;
	height: 14rpx;
	background: #2677ff;
	border-radius: 50%;
}

.status-dot.success {
	background: #15945d;
}

.status-message {
	flex: 1;
	color: #31557f;
	font-size: 27rpx;
}

.error-card {
	background: #fff5f3;
}

.footnote {
	padding: 20rpx 18rpx;
	color: #9aa3ad;
	font-size: 23rpx;
	line-height: 1.6;
	text-align: center;
}
