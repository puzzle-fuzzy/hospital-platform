# 旧服务 API；只由同源 Bun 代理读取，不会注入浏览器 bundle。
LEGACY_HOSPITAL_API_BASE_URL=https://test-hp.meiyi.pro/api/v1

# 可选独立只读账号；不创建旧系统用户。仅部署 Argon2id hash，绝不配置明文密码。
# 两项未配置或不完整时，只读登录关闭；不会回退到旧系统认证。
ADMIN_VIEWER_USERNAME=
ADMIN_VIEWER_PASSWORD_HASH=

# 新服务日志读取接口；只由同源 Bun 代理读取，不会注入浏览器 bundle。
ADMIN_LOGS_API_BASE_URL=http://10.0.0.3:18081/api/v1
ADMIN_LOGS_API_TOKEN=replace-with-the-same-server-token-as-ADMIN_LOGS_TOKEN

# 新服务普通微信及医保+微信聚合退费接口；只由同源 Bun 代理读取，不会注入浏览器 bundle。
ADMIN_REFUNDS_API_BASE_URL=http://10.0.0.3:18081/api/v1
ADMIN_REFUNDS_API_TOKEN=replace-with-the-same-server-token-as-ADMIN_REFUND_TOKEN

# 管理端服务监听。生产环境建议仅监听回环地址并由 Nginx 提供 HTTPS。
INSURANCE_QUERY_HOST=127.0.0.1
INSURANCE_QUERY_PORT=18083

# 新服务在内网地址提供 HTTP；公网仍由 Nginx 终止 HTTPS。
INSURANCE_QUERY_ALLOW_HTTP_UPSTREAM=true

# 如果管理端部署在子路径，可在构建前设置，例如 /admin/。
INSURANCE_QUERY_PUBLIC_BASE=/
