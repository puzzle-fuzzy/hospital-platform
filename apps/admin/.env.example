# 旧服务 API；只由同源 Bun 代理读取，不会注入浏览器 bundle。
LEGACY_HOSPITAL_API_BASE_URL=https://test-hp.meiyi.pro/api/v1

# 管理端服务监听。生产环境建议仅监听回环地址并由 Nginx 提供 HTTPS。
INSURANCE_QUERY_HOST=127.0.0.1
INSURANCE_QUERY_PORT=18083

# 只有明确的内网测试上游才允许打开 HTTP。
INSURANCE_QUERY_ALLOW_HTTP_UPSTREAM=false

# 如果管理端部署在子路径，可在构建前设置，例如 /insurance-query/。
INSURANCE_QUERY_PUBLIC_BASE=/
