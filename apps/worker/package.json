{
	"name": "@hospital/worker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "bun build src/index.ts src/preflight.ts src/provider-directory-smoke.ts src/api-runtime-smoke.ts --outdir dist --target bun && bun build ../../tools/p0-log-aggregate.mjs --outfile dist/p0-log-aggregate.js --target bun",
		"dev": "bun --watch run src/index.ts",
		"preflight": "bun run src/preflight.ts",
		"runtime-smoke": "bun run src/api-runtime-smoke.ts",
		"provider-smoke": "bun run src/provider-directory-smoke.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hospital/adapters": "workspace:*",
		"@hospital/contracts": "workspace:*",
		"@hospital/config": "workspace:*",
		"@hospital/domain": "workspace:*",
		"@hospital/observability": "workspace:*",
		"@hospital/persistence": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
