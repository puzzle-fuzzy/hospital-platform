page {
	background: #ffffff;
}

.settlement-scroll {
	height: 100vh;
	background: #ffffff;
}

.settlement-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
	background: #ffffff;
}

.settlement-hero {
	box-sizing: border-box;
	width: 100%;
	height: 302rpx;
	padding: 58rpx 44rpx 0;
	border-radius: 0 0 58rpx 58rpx;
	background: #3f79e5;
	color: #ffffff;
}

.settlement-hero-label {
	display: block;
	color: rgba(255, 255, 255, 0.66);
	font-size: 27rpx;
	font-weight: 500;
}

.settlement-hero-main {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-top: 18rpx;
}

.settlement-hero-hospital {
	overflow: hidden;
	max-width: 540rpx;
	color: #ffffff;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 1.25;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.hospital-icon {
	display: flex;
	align-items: center;
	flex-direction: column;
	justify-content: center;
	width: 76rpx;
	height: 76rpx;
	border-radius: 8rpx;
	background: rgba(255, 255, 255, 0.13);
}

.hospital-roof {
	width: 18rpx;
	height: 6rpx;
	border-radius: 2rpx 2rpx 0 0;
	background: #ffffff;
}

.hospital-building {
	position: relative;
	display: flex;
	align-items: center;
	flex-direction: column;
	box-sizing: border-box;
	width: 38rpx;
	height: 44rpx;
	gap: 5rpx;
	padding-top: 7rpx;
	border-radius: 2rpx;
	background: #ffffff;
}

.hospital-window-row {
	display: flex;
	gap: 7rpx;
}

.hospital-window {
	width: 6rpx;
	height: 6rpx;
	border-radius: 1rpx;
	background: #79a5ed;
}

.hospital-door {
	position: absolute;
	bottom: 0;
	left: 50%;
	width: 9rpx;
	height: 12rpx;
	background: #79a5ed;
	transform: translateX(-50%);
}

.amount-card {
	position: relative;
	z-index: 2;
	box-sizing: border-box;
	width: 670rpx;
	margin: -80rpx auto 0;
	padding: 0 38rpx 18rpx;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 28rpx rgba(47, 67, 104, 0.12);
}

.amount-row,
.detail-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.amount-total-row {
	height: 138rpx;
	border-bottom: 1rpx solid #f0f1f4;
	color: #4d5158;
	font-size: 37rpx;
	font-weight: 600;
}

.amount-total {
	color: #3b3f45;
	font-size: 43rpx;
	font-weight: 600;
}

.detail-row {
	height: 66rpx;
	color: #b1b5bd;
	font-size: 27rpx;
}

.amount-cash-row {
	color: #3f7fdf;
	font-weight: 600;
}

.amount-divider {
	height: 1rpx;
	margin-top: 8rpx;
	background: #f0f1f4;
}

.self-pay-detail {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 96rpx;
	color: #7e838a;
	font-size: 27rpx;
}

.insurance-payment {
	display: flex;
	align-items: center;
	justify-content: center;
	height: 54rpx;
	gap: 14rpx;
	margin-top: 54rpx;
}

.insurance-logo {
	display: block;
	width: 78rpx;
	height: auto;
}

.insurance-label {
	color: #9fa4ac;
	font-size: 27rpx;
	font-weight: 500;
}

.settlement-bottom-bar {
	position: fixed;
	z-index: 10;
	right: 0;
	bottom: 0;
	left: 0;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	height: calc(126rpx + env(safe-area-inset-bottom));
	padding: 16rpx 34rpx env(safe-area-inset-bottom);
	border-top: 1rpx solid #f2f3f5;
	background: #ffffff;
}

.settlement-remaining {
	display: flex;
	align-items: baseline;
	flex: 1;
	min-width: 0;
	gap: 15rpx;
}

.settlement-remaining-label {
	color: #a3a7ad;
	font-size: 27rpx;
	white-space: nowrap;
}

.settlement-remaining-amount {
	color: #347fe3;
	font-size: 38rpx;
	font-weight: 600;
	white-space: nowrap;
}

.primary-button {
	display: flex;
	align-items: center;
	justify-content: center;
	box-sizing: border-box;
	width: 200rpx;
	height: 78rpx;
	margin: 0;
	padding: 0;
	border: 0;
	border-radius: 42rpx;
	background: #178af0;
	color: #ffffff;
	font-size: 31rpx;
	font-weight: 500;
	line-height: 1;
}

.primary-button::after,
.back-button::after {
	border: 0;
}

.detail-mask {
	position: fixed;
	z-index: 30;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	background: rgba(0, 0, 0, 0.42);
}

.detail-sheet {
	position: absolute;
	right: 0;
	bottom: 0;
	left: 0;
	box-sizing: border-box;
	min-height: calc(520rpx + env(safe-area-inset-bottom));
	padding: 0 22rpx calc(24rpx + env(safe-area-inset-bottom));
	border-radius: 28rpx 28rpx 0 0;
	background: #ffffff;
	animation: detail-sheet-up 180ms ease-out;
}

@keyframes detail-sheet-up {
	from {
		transform: translateY(100%);
	}

	to {
		transform: translateY(0);
	}
}

.detail-sheet-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	height: 132rpx;
	padding: 0 18rpx;
}

.detail-sheet-title {
	color: #25282d;
	font-size: 36rpx;
	font-weight: 600;
}

.detail-sheet-close {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 44rpx;
	height: 44rpx;
	border-radius: 50%;
	background: #e3e3e3;
	color: #999999;
	font-family: Arial, sans-serif;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 1;
}

.prescription-card {
	overflow: hidden;
	border: 1rpx solid #dedfe2;
	border-radius: 10rpx;
	background: #ffffff;
}

.prescription-heading {
	display: flex;
	align-items: center;
	height: 92rpx;
	gap: 20rpx;
	padding: 0 16rpx;
	border-bottom: 1rpx solid #e5e6e8;
	color: #303238;
	font-size: 30rpx;
	font-weight: 600;
}

.prescription-heading-mark {
	width: 7rpx;
	height: 34rpx;
	background: #3979ee;
}

.prescription-list {
	padding: 28rpx 38rpx 30rpx;
}

.prescription-item {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	min-height: 96rpx;
	gap: 28rpx;
}

.prescription-main {
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.prescription-name,
.prescription-dose {
	display: block;
}

.prescription-name,
.prescription-price {
	color: #5c6067;
	font-size: 28rpx;
}

.prescription-dose {
	margin-top: 6rpx;
	color: #8f949c;
	font-size: 25rpx;
}

.prescription-price {
	flex: 0 0 auto;
	white-space: nowrap;
}

.state-card {
	box-sizing: border-box;
	width: 670rpx;
	margin: 80rpx auto 0;
	padding: 42rpx 30rpx;
	border-radius: 20rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 28rpx rgba(47, 67, 104, 0.1);
	text-align: center;
}

.settlement-loading-mask {
	position: fixed;
	z-index: 50;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	display: flex;
	align-items: center;
	flex-direction: column;
	justify-content: center;
	background: rgba(0, 0, 0, 0.56);
}

.loading-spinner {
	box-sizing: border-box;
	width: 62rpx;
	height: 62rpx;
	border: 6rpx solid rgba(255, 255, 255, 0.34);
	border-top-color: #ffffff;
	border-radius: 50%;
	animation: settlement-loading 900ms linear infinite;
}

.loading-text {
	margin-top: 26rpx;
	color: #ffffff;
	font-size: 26rpx;
	line-height: 1.5;
}

@keyframes settlement-loading {
	to {
		transform: rotate(360deg);
	}
}

.error-state {
	border: 1rpx solid #ffd8d8;
	background: #fff7f7;
}

.state-title,
.state-message {
	display: block;
}

.state-title {
	color: #333333;
	font-size: 30rpx;
	font-weight: 700;
}

.state-message {
	margin-top: 14rpx;
	color: #e04f4f;
	font-size: 25rpx;
	line-height: 1.6;
}

.back-button {
	display: block;
	width: 100%;
	margin-top: 24rpx;
	padding: 0;
	border-radius: 44rpx;
	background: #edf1f5;
	color: #4f5964;
	font-size: 29rpx;
	line-height: 88rpx;
}
