page {
	background: #ffffff;
}

.payment-result-scroll {
	height: 100vh;
	background: #ffffff;
}

.payment-result-page {
	box-sizing: border-box;
	min-height: 100vh;
	padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
	background: #ffffff;
}

.result-hero {
	display: flex;
	align-items: center;
	flex-direction: column;
	box-sizing: border-box;
	height: 324rpx;
	padding: 42rpx 32rpx 0;
	border-radius: 0 0 58rpx 58rpx;
	background: #3f79e5;
}

.success-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 88rpx;
	height: 88rpx;
	border-radius: 50%;
	background: #ffffff;
	color: #3f79e5;
	font-size: 58rpx;
	font-weight: 700;
	line-height: 1;
}

.success-title,
.success-subtitle {
	display: block;
	text-align: center;
}

.success-title {
	margin-top: 18rpx;
	color: #ffffff;
	font-size: 38rpx;
	font-weight: 600;
}

.success-subtitle {
	margin-top: 10rpx;
	color: rgba(255, 255, 255, 0.72);
	font-size: 25rpx;
}

.summary-card,
.amount-card {
	box-sizing: border-box;
	width: 670rpx;
	margin-right: auto;
	margin-left: auto;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 28rpx rgba(47, 67, 104, 0.12);
}

.summary-card {
	position: relative;
	z-index: 2;
	margin-top: -54rpx;
	padding: 20rpx 34rpx 28rpx;
}

.hospital-summary {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 92rpx;
}

.hospital-summary-label,
.hospital-summary-name {
	display: block;
}

.hospital-summary-label {
	color: #a5aab2;
	font-size: 23rpx;
}

.hospital-summary-name {
	margin-top: 8rpx;
	color: #454a51;
	font-size: 30rpx;
	font-weight: 600;
}

.summary-divider {
	height: 1rpx;
	margin-bottom: 10rpx;
	background: #f0f1f4;
}

.summary-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 54rpx;
	color: #a4a9b0;
	font-size: 26rpx;
}

.summary-row text:last-child {
	color: #555a61;
	font-weight: 500;
}

.amount-card {
	margin-top: 22rpx;
	padding: 0 38rpx 22rpx;
}

.amount-card-title {
	display: flex;
	align-items: center;
	height: 82rpx;
	border-bottom: 1rpx solid #f0f1f4;
	color: #454a51;
	font-size: 29rpx;
	font-weight: 600;
}

.amount-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 58rpx;
	color: #a9adb4;
	font-size: 26rpx;
}

.amount-row text:last-child {
	color: #666b72;
}

.amount-total-row {
	min-height: 84rpx;
	color: #686d73;
	font-size: 28rpx;
	font-weight: 600;
}

.amount-total-row text:last-child {
	color: #3d4147;
	font-size: 36rpx;
	font-weight: 600;
}

.amount-cash-row,
.amount-cash-row text:last-child {
	color: #3f7fdf;
	font-weight: 600;
}

.amount-source-hint,
.amount-sync-hint {
	display: block;
	color: #a0a5ad;
	font-size: 22rpx;
	line-height: 1.5;
}

.amount-source-hint {
	margin-top: 12rpx;
	padding-top: 17rpx;
	border-top: 1rpx solid #f0f1f4;
}

.amount-sync-hint {
	width: 670rpx;
	margin: 22rpx auto 0;
	padding: 24rpx;
	border-radius: 18rpx;
	background: #ffffff;
	box-shadow: 0 8rpx 28rpx rgba(47, 67, 104, 0.1);
	text-align: center;
}

.result-actions {
	position: fixed;
	z-index: 10;
	right: 0;
	bottom: 0;
	left: 0;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	height: calc(126rpx + env(safe-area-inset-bottom));
	gap: 18rpx;
	padding: 16rpx 34rpx env(safe-area-inset-bottom);
	border-top: 1rpx solid #f2f3f5;
	background: #ffffff;
}

.primary-button,
.secondary-button {
	display: flex;
	align-items: center;
	justify-content: center;
	flex: 1;
	box-sizing: border-box;
	height: 78rpx;
	margin: 0;
	padding: 0;
	border-radius: 42rpx;
	font-size: 29rpx;
	font-weight: 500;
	line-height: 1;
}

.primary-button {
	border: 0;
	background: #178af0;
	color: #ffffff;
}

.secondary-button {
	border: 2rpx solid #3f79e5;
	background: #ffffff;
	color: #3f79e5;
}

.primary-button::after,
.secondary-button::after {
	border: 0;
}
