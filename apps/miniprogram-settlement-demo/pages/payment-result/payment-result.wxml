<scroll-view class="payment-result-scroll" scroll-y="true" enhanced="true">
	<view class="payment-result-page">
		<view class="result-hero">
			<view class="success-icon">✓</view>
			<text class="success-title">{{title}}</text>
			<text class="success-subtitle">{{subtitle}}</text>
		</view>

		<view class="summary-card">
			<view class="hospital-summary">
				<view class="hospital-summary-main">
					<text class="hospital-summary-label">付款给</text>
					<text class="hospital-summary-name">{{hospitalName}}</text>
				</view>
			</view>
			<view class="summary-divider"></view>
			<view class="summary-row"><text>业务类型</text><text>{{businessLabel}}</text></view>
			<view class="summary-row"><text>支付方式</text><text>{{channelLabel}}</text></view>
		</view>

		<view wx:if="{{amountBreakdownVisible}}" class="amount-card">
			<view class="amount-card-title">本次费用明细</view>
			<view class="amount-row amount-total-row"><text>费用总额</text><text>{{totalAmountLabel}}</text></view>
			<view class="amount-row"><text>医保基金支付</text><text>{{insuranceAmountLabel}}</text></view>
			<view class="amount-row"><text>个人账户支付</text><text>{{accountAmountLabel}}</text></view>
			<view class="amount-row"><text>其他抵扣金额</text><text>{{otherInsuranceAmountLabel}}</text></view>
			<view class="amount-row amount-cash-row"><text>现金支付</text><text>{{cashAmountLabel}}</text></view>
			<text class="amount-source-hint">金额来自本次医保结算结果</text>
		</view>
		<view wx:elif="{{amountBreakdownLoading || amountBreakdownHint}}" class="amount-sync-hint">
			{{amountBreakdownHint || '正在同步本次费用明细'}}
		</view>

		<view class="result-actions">
			<button class="secondary-button" bindtap="onBackHome">返回首页</button>
			<button wx:if="{{hasDetail}}" class="primary-button" bindtap="onViewDetail">查看{{businessLabel}}详情</button>
		</view>
	</view>
</scroll-view>
