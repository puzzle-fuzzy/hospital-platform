{
	"name": "@hospital/persistence",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist -p tsconfig.json",
		"integration": "bun run src/integration.ts",
		"legacy:convenience:audit": "bun run scripts/legacy-convenience-source-audit.ts",
		"health:export-legacy": "bun run scripts/export-legacy-health-knowledge.ts",
		"health:import-staging": "bun run scripts/health-knowledge-bundle-import.ts",
		"migrate": "bun run src/migrate.ts",
		"schema": "bun run src/schema.ts",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"dependencies": {
		"@hospital/contracts": "workspace:*",
		"@hospital/domain": "workspace:*",
		"@hospital/observability": "workspace:*",
		"ioredis": "6.0.0",
		"mysql2": "3.23.3"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
